/**
 * Explorer's port (zeff-plugins/plugins/explorer-ext): the file browser of this computer as a plugin. The screen is the view language alone (views, one database
 * "Explorer" whose view is the template scripts/port-explorer/explorer-view.html): the lambda `explorer.screen` (a folder's entries ready to draw, the crumbs, the
 * places, what the folder actions are about) and `explorer.file` (a file for the viewer) read the disk through the kernel's fs.* flow actions — the built-in's own
 * path guard, never Zeff's own data, bounded (src/plugins/explorer/flow-actions.ts) —; what changes something (saving a text, a new folder, importing into
 * Documents, watching a folder, opening a file with this computer's program) is a flow of the package, which does it through the kernel's fs.* / explorer.* actions
 * (they need the flow's permission "api", which the switch grants). The pure shapes (viewKind, crumbs, parseCsv …) are the built-in's src/plugins/explorer/shared.ts, bundled.
 *
 *   npx tsx scripts/port-explorer.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "explorer-ext");
const SRC = path.join(ROOT, "scripts", "port-explorer");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

// The texts of the screen's data in the languages the packs have: every t("…") of the two lambdas.
const KEYS: string[] = [];
for (const file of ["explorer.screen.mjs", "explorer.file.mjs"])
  for (const m of fs.readFileSync(path.join(SRC, file), "utf8").matchAll(/\bt\(\s*"((?:[^"\\]|\\.)*)"/g)) {
    const k = JSON.parse('"' + m[1] + '"');
    if (!KEYS.includes(k)) KEYS.push(k);
  }
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const file = path.join(repo, "plugins", `lang-${lang}`, "bundle.json");
  const pack = fs.existsSync(file) ? (JSON.parse(fs.readFileSync(file, "utf8")) as Record<string, string>) : {};
  strings[lang] = Object.fromEntries(KEYS.filter((k) => pack[k]).map((k) => [k, pack[k]]));
}
const lib = await build({
  stdin: {
    contents: `import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";
const STRINGS = ${JSON.stringify(strings)};
setPluginStrings((lang) => STRINGS[lang] ?? {});
export const tFor = (lang) => translator(isLang(lang) ? lang : "en");
export { baseName, crumbs, entryIcon, fileUrl, parseCsv, viewKind } from "@/plugins/explorer/shared";
export { sizeText } from "@/plugins/documents/shared";`,
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "explorer-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const libText = `// Generated by Zeff's scripts/port-explorer.mts from the built-in's pure shapes (src/plugins/explorer/shared.ts) — change them there, generate again.\n${lib.outputFiles[0].text}`;

const LAMBDAS: Record<string, { label: string; what: string; zeff: string[]; timeoutMs: number }> = {
  "explorer.screen": { label: "Explorer: what the screen shows", what: "A folder's entries ready to draw (icon, type, size, date, whether it is in Documents), the address bar's crumbs, the places and what the folder actions are about.", zeff: ["fs.list", "fs.places"], timeoutMs: 30000 },
  "explorer.file": { label: "Explorer: a file for the viewer", what: "A file opened: how it is shown, its text (a CSV's rows), the addresses for pictures, PDFs, audio and video and the download.", zeff: ["fs.read-text"], timeoutMs: 30000 },
};
for (const [name, l] of Object.entries(LAMBDAS)) {
  write(`lambdas/${name}/lib.mjs`, libText);
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, `${name}.mjs`), "utf8"));
  write(`lambdas/${name}/lambda.json`, JSON.stringify({ name, label: l.label, what: l.what, kind: "function", zeff: l.zeff, timeoutMs: l.timeoutMs, memoryMb: 128 }, null, 2) + "\n");
}

/** A flow of the package: one kernel action done by a button, its answer { message } handed back. */
const flow = (id: string, name: string, title: string, description: string, action: string, input: Record<string, string>) => ({
  id,
  parent: "i1",
  kind: "page",
  title,
  icon: "🗂️",
  content: { type: "doc", content: [{ type: "paragraph" }] },
  flow: {
    name,
    title,
    description,
    inputs: [],
    nodes: [
      { id: "do", kind: "action", action, input },
      { id: "done", kind: "return", value: { message: "{{ steps.do.message }}", path: "{{ steps.do.path }}" } },
    ],
    requested: { api: true },
    triggers: [{ kind: "manual" }],
  },
});

const template = fs.readFileSync(path.join(SRC, "explorer-view.html"), "utf8");
write(
  "explorer.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "explorer-ext",
      version: "1.0.0",
      name: "Explorer",
      description: "The files of this computer in the Workspace: drives, folders, files; import into Documents, watch folders, open and edit files.",
      icon: "🗂️",
      items: [
        { id: "i1", kind: "page", title: "Explorer", icon: "🗂️", content: { type: "doc", content: [{ type: "paragraph" }] } },
        {
          id: "i2",
          parent: "i1",
          kind: "database",
          title: "Files",
          icon: "🗂️",
          schema: {
            titleName: "Explorer",
            properties: [],
            views: [{ id: "vexp1", name: "Explorer", type: "app", filter: { op: "and", rules: [] }, sorts: [], hidden: [], app: "template", template }],
          },
          rows: [{ id: "r1", title: "Explorer", cells: {}, content: { type: "doc", content: [{ type: "paragraph" }] } }],
        },
        flow("i3", "explorer.save", "Save a text file", "A text file saved (input path, text, mtime: the file's time when it was opened — refused when it changed since). Output { message, mtime, size }.", "fs.save-text", { path: "{{ input.path }}", text: "{{ input.text }}", mtime: "{{ input.mtime }}" }),
        flow("i4", "explorer.make", "A new folder or text file", "A new folder or empty text file in a folder (input parent, name, kind: folder | file). Output { path }.", "fs.make", { parent: "{{ input.parent }}", name: "{{ input.name }}", kind: "{{ input.kind }}" }),
        flow("i5", "explorer.import", "Import files into Documents", "Files (input paths: a list or its JSON text) imported into Documents; a changed one updates its document. Output { message }.", "explorer.import-files", { paths: "{{ input.paths }}" }),
        flow("i6", "explorer.import-folder", "Import a folder into Documents", "Every file of a folder Documents reads (subfolders too, at most 500) imported once (input path). Output { message }.", "explorer.import-folder", { path: "{{ input.path }}" }),
        flow("i7", "explorer.watch", "Watch a folder", "A folder watched: what changes in it comes into Documents (input path, mode: auto | confirm). Output { message }.", "explorer.watch", { path: "{{ input.path }}", mode: "{{ input.mode }}" }),
        flow("i8", "explorer.unwatch", "Stop watching a folder", "A watched folder no longer watched (input id); its documents stay. Output { message }.", "explorer.unwatch", { id: "{{ input.id }}" }),
        flow("i9", "explorer.watch-mode", "When the AI may read a watched folder", "A watched folder's mode (input id, mode: auto | confirm). Output { message }.", "explorer.watch-mode", { id: "{{ input.id }}", mode: "{{ input.mode }}" }),
        flow("i10", "explorer.open-here", "Open a file on this computer", "A file opened with this computer's program for it, or shown in Windows Explorer (input path, reveal). Output { message }.", "fs.open-here", { path: "{{ input.path }}", reveal: "{{ input.reveal }}" }),
      ],
    },
    null,
    2,
  ) + "\n",
);

write("views/explorer.html", template);
const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "explorer-ext",
      name: "Explorer",
      version: old.version ?? "0.1.0",
      description: "The files of this computer in the Workspace, like Windows Explorer: drives, folders and files with dates and sizes; import into Documents, watch folders, open text, Markdown, CSV, pictures, PDFs, audio and video — and edit text files.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["explorer.package.json"],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# Explorer (explorer-ext)

The file browser of this computer as a plugin. Generated by Zeff's \`scripts/port-explorer.mts\`.

- The screen is the view language: the database *Explorer* (under the page *Explorer*) has one view, \`views/explorer.html\`; the lambdas \`explorer.screen\` and \`explorer.file\` give it its data.
- The disk is read through Zeff's own bounded actions (\`fs.list\`, \`fs.places\`, \`fs.read-text\`, \`fs.stat\`): the built-in Explorer's path guard, never Zeff's own data folder. What changes something is a flow of the package (\`explorer.save\`, \`explorer.make\`, \`explorer.import\`, \`explorer.import-folder\`, \`explorer.watch\`, \`explorer.unwatch\`, \`explorer.watch-mode\`, \`explorer.open-here\`) — each needs the permission "api", which *Switch to the plugin* grants.
- Needs the Explorer's kernel service (the built-in Explorer on, or this plugin through its switch).
`,
);
console.log(`${dir}: Explorer`);
