/**
 * Google Keep's port (zeff-plugins/plugins/keep-ext) — all of Keep's own in the plugin, nothing of it in the kernel:
 *  - the scraper: the driver lambda `keep.driver` (kind driver — capability D), made from the built-in's own files (src/plugins/keep/
 *    driver.mjs, model.mjs, write.mjs): it attaches to the account's automation Chrome through Zeff's generic helper (context.chrome)
 *    instead of starting as a program. Kept like any lambda: as it ships here, and — when Keep changes its page and it breaks — mended in
 *    the Studio (by you or the AI), the fix kept in the database;
 *  - keeping the notes: the plugin's store `notes` (the built-in's table keep_notes, adopted) written by the flow from the lambda
 *    `keep.save-plan` (the built-in's saveKeepNotes, rule for rule);
 *  - the "Google Keep" database: the kernel's db.mirror filled by the lambda `keep.mirror-plan` (the built-in's syncGoogleKeepDatabase);
 *  - the sync: the flow `keep.sync`, a step of the Sync menu in the built-in's place.
 *
 *   npx tsx scripts/port-keep.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import { keepCatalogFields } from "./lib/catalog-fields.mts";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "keep-ext");
const src = (f: string) => fs.readFileSync(path.join(ROOT, "src", "plugins", "keep", f), "utf8");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

// ── The scraper: the built-in's driver, its MCP server around it left out, its Chrome the one the driver lambda is given. ──
const driver = src("driver.mjs");
const head = driver.indexOf('import { connectToChrome, ChromeConnectError, withTabLock } from "../../../scripts/chrome-cdp.mjs";');
const tail = driver.indexOf("\nconst TOOLS = [");
if (head < 0 || tail < 0) throw new Error("driver.mjs: its import of the Chrome helper or its TOOLS aren't where they were — look at the transformation here.");
const keepMjs =
  `// Generated by Zeff's scripts/port-keep.mts from the built-in Google Keep's scraper (src/plugins/keep/driver.mjs). Mend it here — in the
// Studio — when Keep changes its page: the fix is kept in Zeff's database and wins over this one until you reset it.\n` +
  driver
    .slice(0, tail)
    .replace(/^#![^\n]*\n/, "")
    .replace(
      head >= 0 ? 'import { connectToChrome, ChromeConnectError, withTabLock } from "../../../scripts/chrome-cdp.mjs";' : "",
      `/** The account's automation Chrome, as the driver lambda is given it (context.chrome: Zeff's generic helper). */
let chrome = null;
export const useChrome = (c) => {
  chrome = c;
};
const connectToChrome = (_cdp, opts) => chrome.connect(opts);
const ChromeConnectError = class extends Error {};`,
    ) +
  "\nexport { keepNotes, keepWrite, keepStatus };\n";
write("lambdas/keep.driver/keep.mjs", keepMjs);
write("lambdas/keep.driver/model.mjs", src("model.mjs"));
write("lambdas/keep.driver/write.mjs", src("write.mjs"));
write(
  "lambdas/keep.driver/index.mjs",
  `import { keepNotes, keepStatus, keepWrite, useChrome } from "./keep.mjs";

/**
 * Google Keep's scraper (a driver: it runs with the account's automation Chrome). event.tool:
 *   notes  { account, launch } -> { notes, full, pages } — read-only: Keep opened in a fresh tab, what its app loads kept, the tab closed
 *   status                     -> { chrome, open, signedIn }
 *   write  { op, … }           -> a note written in Keep's own editor (create / update / trash) — the only one that changes Keep
 */
export async function handler(event0, context) {
  useChrome(context.chrome);
  // (the shared call shape of the drivers — { tool: "keep_notes", args } — or the plain one: { tool: "notes", account, launch })
  const shared = /^keep_/.test(String(event0?.tool ?? ""));
  const event = shared ? { ...(event0.args ?? {}), tool: String(event0.tool).replace(/^keep_/, "") } : event0;
  const tool = String(event?.tool ?? "notes");
  const run = tool === "status" ? () => keepStatus() : tool === "write" ? () => keepWrite(event) : tool === "notes" ? () => keepNotes({ account: event?.account ?? 0, launch: event?.launch === true || event?.launch === "true" }) : null;
  if (!run) throw new Error(\`Unknown tool "\${tool}" (notes, status, write).\`);
  const out = tool === "status" ? await run() : await context.chrome.withTabLock("Keep", \`keep_\${tool}\`, run);
  return typeof out === "string" ? JSON.parse(out) : out;
}
`,
);
write(
  "lambdas/keep.driver/lambda.json",
  JSON.stringify({ name: "keep.driver", label: "Google Keep: the scraper", what: "Reads your Google Keep notes in the account's automation Chrome (Keep opened in a fresh tab, what its web app loads kept, the tab closed — nothing changes in Keep); tool status checks the sign-in, tool write changes a note in Keep's own editor.", kind: "driver", timeoutMs: 300000, memoryMb: 512 }, null, 2) + "\n",
);

// ── The texts the sync says (the built-in's, translated by the language packs) and the shared library. ──
const KEYS = ["{n} new", "{n} changed", "{n} removed", "{n} in all", "The automation Chrome isn't running. Not synced."];
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const file = path.join(repo, "plugins", `lang-${lang}`, "bundle.json");
  const pack = fs.existsSync(file) ? (JSON.parse(fs.readFileSync(file, "utf8")) as Record<string, string>) : {};
  strings[lang] = Object.fromEntries(KEYS.filter((k) => pack[k]).map((k) => [k, pack[k]]));
}
const lib = await build({
  stdin: {
    contents: `import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";
const STRINGS = ${JSON.stringify(strings)};
setPluginStrings((lang) => STRINGS[lang] ?? {});
export const tFor = (lang) => translator(isLang(lang) ? lang : "en");
export { KEEP_COLORS } from "@/plugins/keep/colors";
export { COLORS } from "@/plugins/workspace/model/schema";`,
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "keep-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
write("lambdas/_lib.mjs", `// Generated by Zeff's scripts/port-keep.mts — the texts the built-in Google Keep says, and its colours.\n${lib.outputFiles[0].text}`);

const fn = (name: string, what: string, zeff: string[], code: string, extra: Record<string, unknown> = {}) => {
  write(`lambdas/${name}/lambda.json`, JSON.stringify({ name, label: `Google Keep: ${what.split(":")[0]}`, what, kind: "function", zeff, timeoutMs: 60000, memoryMb: 256, ...extra }, null, 2) + "\n");
  write(`lambdas/${name}/index.mjs`, code);
};
const ALL = `/** Every row of a store (pages of 500). */
async function all(zeff, store) {
  const out = [];
  for (let offset = 0; ; offset += 500) {
    const { rows, total } = await zeff.call("store.query", { store, limit: 500, offset });
    out.push(...rows);
    if (!rows.length || out.length >= total) return out;
  }
}
`;

fn(
  "keep.account",
  "which account: the Google account whose Keep is read (the plugin's setting), and what the sync says when the automation Chrome isn't running.",
  [],
  `import { tFor } from "./lib.mjs";

export async function handler(_event, context) {
  const t = tFor(context.language);
  return { account: String(context.secrets.ACCOUNT ?? "").trim() || "0", notRunning: t("The automation Chrome isn't running. Not synced.") };
}
`,
  { secrets: ["ACCOUNT"] },
);

fn(
  "keep.save-plan",
  "keeping the notes: what the sync read, as rows of the store notes — new and changed ones, and (Keep gave all) those gone from Keep — and what it says.",
  ["store.query"],
  `import { tFor } from "./lib.mjs";

${ALL}
/** The built-in's saveKeepNotes, rule for rule: new and changed counted, every note written, the gone ones (a full read) removed. */
export async function handler(event, context) {
  const t = tFor(context.language);
  const notes = Array.isArray(event?.notes) ? event.notes : [];
  const full = event?.full === true;
  const known = new Map((await all(context.zeff, "keep-ext.notes")).map((r) => [r.id, r]));
  const now = new Date().toISOString();
  let added = 0;
  let changed = 0;
  const rows = notes.map((n) => {
    const labels = JSON.stringify(n.labels ?? []);
    const k = known.get(n.id);
    if (!k) added++;
    else if (k.updated_at !== n.updatedAt || k.title !== n.title || k.text !== n.text || k.labels !== labels || !!k.pinned !== n.pinned || !!k.archived !== n.archived) changed++;
    return { id: n.id, kind: n.kind, title: n.title, text: n.text, labels, color: n.color ?? null, pinned: n.pinned ? 1 : 0, archived: n.archived ? 1 : 0, created_at: n.createdAt ?? null, updated_at: n.updatedAt ?? null, url: n.url, synced_at: now };
  });
  const seen = new Set(notes.map((n) => n.id));
  const remove = full ? [...known.keys()].filter((id) => !seen.has(id)) : [];
  const total = new Set([...known.keys(), ...seen]).size - remove.length;
  const message = [t("{n} new", { n: added }), t("{n} changed", { n: changed }), ...(remove.length ? [t("{n} removed", { n: remove.length })] : []), t("{n} in all", { n: total })].join(" · ");
  return { rows, remove, added, changed, removed: remove.length, total, message };
}
`,
);

fn(
  "keep.mirror-plan",
  "the Google Keep database: the notes kept (not the archived, not those synced with one of your boards) as its rows — colour, pinned, labels, the note, when it was edited in Keep — and how the database is made.",
  ["store.query"],
  `import { COLORS, KEEP_COLORS } from "./lib.mjs";

${ALL}
const WS_COLOR = { teal: "green", cerulean: "blue" };
const wsColor = (c) => WS_COLOR[c] ?? (COLORS.includes(c) ? c : "gray");
const firstLine = (text) => text.split(/\\r?\\n/)[0].replace(/^- \\[[ xX]\\] /, "").slice(0, 120);
const labelsOf = (s) => {
  try {
    return JSON.parse(s);
  } catch {
    return [];
  }
};

/** The built-in's syncGoogleKeepDatabase as records for the kernel's db.mirror. */
export async function handler(_event, context) {
  // (a note synced with one of your boards is shown there — as your note —, not here a second time)
  let linked = new Set();
  try {
    linked = new Set((await all(context.zeff, "keep-ext.linked")).map((r) => r.google_id).filter(Boolean));
  } catch {
    // (no boards synced with Google Keep)
  }
  const notes = (await all(context.zeff, "keep-ext.notes"))
    .filter((n) => !linked.has(n.id) && !n.archived)
    .sort((a, b) => String(b.updated_at ?? b.created_at ?? "").localeCompare(String(a.updated_at ?? a.created_at ?? "")));
  const setup = {
    title: "Google Keep",
    titleName: "Title",
    properties: [
      { id: "color", name: "Color", type: "select", options: Object.keys(KEEP_COLORS).map((c) => ({ name: c, color: wsColor(c) })) },
      { id: "pinned", name: "Pinned", type: "checkbox" },
      { id: "labels", name: "Labels", type: "multi_select", options: [] },
      { id: "noteref", name: "Note", type: "text" },
      { id: "keepedited", name: "Edited in Keep", type: "text" },
    ],
    views: [
      { name: "Notes", type: "gallery", sorts: [{ prop: "pinned", dir: "desc" }], hidden: ["noteref", "pinned", "keepedited"] },
      { name: "Table", type: "table" },
    ],
    fullWidth: true,
    locked: true,
    source: "google-keep",
    briefing: true,
    knowledge: true,
  };
  const records = notes.map((n) => {
    const labels = labelsOf(n.labels);
    return { key: "keep:" + n.id, title: n.title || firstLine(n.text), cells: { color: n.color, pinned: !!n.pinned, labels, keepedited: n.updated_at ?? "" }, markdown: n.text, createdAt: n.created_at, updatedAt: n.updated_at };
  });
  return { setup, records };
}
`,
);

// ── The sync: a flow, a step of the Sync menu in the built-in's place. ──
const flow = {
  name: "keep.sync",
  title: "Read Google Keep",
  description: "Your Google Keep notes — read by the scraper keep.driver in the automation Chrome, kept, and the Google Keep database brought up to date. By itself only while the automation Chrome runs.",
  inputs: [],
  nodes: [
    { id: "acc", kind: "action", action: "lambda.invoke", input: { name: "keep.account", event: {} } },
    { id: "up", kind: "action", action: "chrome.up", input: {} },
    { id: "wait", kind: "if", when: "env.trigger.kind == 'schedule' and not steps.up.up", then: [{ id: "later", kind: "return", value: { ok: false, message: "{{ steps.acc.notRunning }}" } }], else: [] },
    {
      id: "reading",
      kind: "try",
      nodes: [{ id: "read", kind: "action", action: "driver.call", input: { name: "keep.driver", event: { tool: "notes", account: "{{ steps.acc.account }}", launch: "{{ env.trigger.kind != 'schedule' }}" } } }],
      catch: [
        { id: "signin", kind: "action", action: "login.notice", input: { service: "keep", message: "{{ error.message }}" } },
        { id: "failed", kind: "return", value: { ok: false, message: "{{ error.message | truncate(300) }}" } },
      ],
    },
    { id: "plan", kind: "action", action: "lambda.invoke", input: { name: "keep.save-plan", event: { notes: "{{ steps.read.notes }}", full: "{{ steps.read.full }}" } } },
    { id: "kept", kind: "action", action: "store.put", input: { store: "keep-ext.notes", rows: "{{ steps.plan.rows }}" } },
    { id: "gone", kind: "foreach", items: "steps.plan.remove", as: "id", max: 1000, nodes: [{ id: "drop", kind: "action", action: "store.delete", input: { store: "keep-ext.notes", where: { id: "{{ id }}" } } }] },
    { id: "fine", kind: "action", action: "login.notice", input: { service: "keep", ok: true } },
    { id: "rows", kind: "action", action: "lambda.invoke", input: { name: "keep.mirror-plan", event: {} } },
    { id: "db", kind: "action", action: "db.mirror", input: { name: "keep-ext.google", setup: "{{ steps.rows.setup }}", key: "noteref", records: "{{ steps.rows.records }}" } },
    { id: "after", kind: "action", action: "workspace.after-sync", input: {} },
    { id: "done", kind: "return", value: { ok: true, message: "{{ steps.plan.message }}" } },
  ],
  requested: { driver: ["keep.driver"], store: ["keep-ext.notes", "keep-ext.google"] },
  triggers: [{ kind: "schedule", everyMinutes: 60, from: "08:00", to: "19:00" }],
  sync: { label: "Google Keep", what: "Your Google Keep notes (Keep opened in a fresh tab of the automation Chrome, what it loads kept — nothing in Keep changes)", replaces: "keep" },
};

const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
const version = old.version ?? "1.0.0";
write(
  "keep.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "keep-ext",
      version,
      name: "Google Keep",
      description: "Google Keep read into Zeff — a sync of the Sync menu.",
      icon: "🟡",
      localize: true,
      items: [
        { id: "i1", kind: "page", title: "Google Keep", icon: "🟡", content: { type: "doc", content: [{ type: "paragraph", content: [{ type: "text", text: "Your Google Keep notes, read in the automation Chrome. The sync is the flow below — a step of the Sync menu; how often it runs: the Sync settings. The scraper is the driver lambda keep.driver (Studio → Lambdas): when Keep changes its page and the sync breaks, it is mended there." }] }] } },
        { id: "i2", parent: "i1", kind: "page", title: "Read Google Keep", icon: "⚡", content: { type: "doc", content: [{ type: "paragraph" }] }, flow },
      ],
    },
    null,
    2,
  ) + "\n",
);

const col = (name: string, type = "text") => ({ name, type });
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      ...keepCatalogFields(old),
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "keep-ext",
      name: "Google Keep",
      version,
      description: "Reads your Google Keep notes into a Workspace database, in the account's automation Chrome (Keep opened in a new tab, what it loads taken over, the tab closed; nothing changes in Keep). Its scraper is a lambda you (or the AI) can mend when Keep changes.",
      author: "Zeff",
      apiVersion: 1,
      // (its scraper runs outside the sandbox, with the account's Chrome: a driver)
      permissions: ["exec"],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["keep.package.json"],
        stores: [
          { name: "notes", adopts: "keep_notes", key: "id", columns: [col("id"), col("kind"), col("title"), col("text"), col("labels"), col("color"), col("pinned", "integer"), col("archived", "integer"), col("created_at"), col("updated_at"), col("url"), col("synced_at")] },
          // (the notes of your boards synced with Google Keep: read only — they are shown there, not in the Keep database)
          { name: "linked", adopts: "keep_own_notes", key: "id", columns: [col("id", "integer"), col("google_id")] },
        ],
        settings: [{ key: "ACCOUNT", label: "Google account", kind: "text", default: "0", help: "Which Google account's Keep: its number in the automation Chrome (0 the first signed in, 1 the second …) or its address." }],
      },
    },
    null,
    2,
  ) + "\n",
);

write(
  "README.md",
  `# Google Keep (keep-ext)

The port of Zeff's built-in Google Keep — all of it here, nothing of Keep's in Zeff's kernel. Generated by Zeff's \`scripts/port-keep.mts\`.

- **The scraper** is the driver lambda \`keep.driver\` (a lambda of kind *driver*: it runs with the account's automation Chrome, outside
  the sandbox — this plugin asks for \`exec\`). It is the built-in's own scraper: Keep opened in a fresh tab, what Keep's web app loads
  kept, the tab closed — nothing changes in Keep. **When Google changes Keep and the sync breaks**, mend it in the Studio (Lambdas →
  keep.driver) — you or the AI; the fix is kept in Zeff's database and wins over this one until you reset it.
- **Keeping the notes**: the store \`notes\` (the built-in's table \`keep_notes\`, adopted) — \`keep.save-plan\` works out what is new,
  changed and gone, as the built-in did.
- **The Google Keep database** in the Workspace: \`keep.mirror-plan\` gives its rows, the kernel's \`db.mirror\` writes what changed (the
  built-in's database goes on).
- **The sync** is the flow \`keep.sync\` — a step of the Sync menu in the built-in's place; by itself only while the automation Chrome runs.
  It may run the driver and use the store (its permissions \`driver\` and \`store\`, allowed when you switch).
- **The Google account** read: the plugin's setting *Google account* (taken over from the built-in when you switch).

**Switching:** Plugins → Google Keep Sync (built-in) → *Switch to the plugin*.
`,
);
console.log(`${dir}: Google Keep ${version} — driver ${keepMjs.length} characters`);
