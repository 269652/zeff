/**
 * The Jira briefing's port (zeff-plugins/plugins/jira-lage-ext), docs/plugins/runtime-conversion.md:
 *  - the Board-Lage run, the step "Board briefing" of the Sync menu (by hand: "Analyse — with me / all tickets"): the flow `jira-lage.board-lage`
 *    (a sync flow replacing the built-in's step) — the lambda `jira-lage.relevant` works out which tickets matter now (the built-in's own rule, core.ts, bundled) from
 *    the plugin's adopted stores (`jira_tickets`, `jira_boards`) and the kernel's reads (`runs.analyzed-tickets`, `todos.followed`), the kernel's `jira.read-issues`
 *    reads them fresh from Jira (comments and history — through the Jira plugin's reader or Zeff's own connection), the comments are kept through the store
 *    `comments` (the built-in's table jira_comments, adopted), the kernel's `workspace.ensure-reviews` / `review-databases` / `refresh-ai-blocks` / `run-pipelines` do what the
 *    step did around the AI review, and the lambda `jira-lage.report` says how it went in the built-in's words (core.ts boardLageMessage, bundled);
 *  - the screen "Board briefing": your boards, what the next run would read, the two buttons — the lambda `jira-lage.overview`.
 *  Stays Zeff's (decided, see the docs): the boards' databases and Meine Lage (made while the Jira sync keeps the tickets — the pipeline's source "jira"),
 *  the ticket picker (the Workspace's board view and the assistant's tools: they draw the answer inside the view) and "Assign to me" (the Workspace's route, done through the Jira plugin).
 *
 *   npx tsx scripts/port-jira-lage.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const SRC = path.join(ROOT, "scripts", "port-jira-lage");
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "jira-lage-ext");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
const json = (v: unknown) => JSON.stringify(v, null, 2) + "\n";
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

// The words the step says (the built-in's, translated by the language packs — the same sentences).
const KEYS = ["{n} tickets (all)", "{n} tickets (with you)", "{n} reassessed", "{n} unchanged", "{n} failed", "Failed."];
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const file = path.join(repo, "plugins", `lang-${lang}`, "bundle.json");
  const pack = fs.existsSync(file) ? (JSON.parse(fs.readFileSync(file, "utf8")) as Record<string, string>) : {};
  strings[lang] = Object.fromEntries(KEYS.filter((k) => pack[k]).map((k) => [k, pack[k]]));
}

// The built-in's pure core, bundled: which tickets are relevant, what the step says.
const lib = await build({
  stdin: {
    contents: `export { relevantKeysOf, boardLageMessage, RECENT_DAYS, MAX_TICKETS } from "@/plugins/jira-lage/core";
import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";
const STRINGS = ${JSON.stringify(strings)};
setPluginStrings((lang) => STRINGS[lang] ?? {});
export const tFor = (lang) => translator(isLang(lang) ? lang : "en");`,
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "jira-lage-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const libText = `// Generated by Zeff's scripts/port-jira-lage.mts from the built-in's pure core (src/plugins/jira-lage/core.ts) — change the core and generate it again.\n${lib.outputFiles[0].text}`;

const LAMBDAS: Record<string, { label: string; what: string; zeff: string[]; timeoutMs: number }> = {
  "jira-lage.relevant": {
    label: "Board briefing: the tickets that matter now",
    what: "The open tickets of your enabled Jira boards that moved lately (or are in progress), less those the last board run assessed — yours and followed ones, or all (event.all): the keys the board briefing reads fresh from Jira.",
    zeff: ["sql.query", "runs.analyzed-tickets", "todos.followed"],
    timeoutMs: 60000,
  },
  "jira-lage.report": {
    label: "Board briefing: how it went",
    what: "What the board briefing step says in the Sync menu — the tickets, how many reassessed, unchanged, failed — in your language, or why it failed.",
    zeff: [],
    timeoutMs: 10000,
  },
  "jira-lage.overview": {
    label: "Board briefing: the page",
    what: "Your enabled Jira boards with their open tickets, and how many tickets the next board briefing would read (with you, and all of them).",
    zeff: ["sql.query", "runs.analyzed-tickets", "todos.followed"],
    timeoutMs: 60000,
  },
};
for (const [name, l] of Object.entries(LAMBDAS)) {
  write(`lambdas/${name}/lib.mjs`, libText);
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, `${name}.mjs`), "utf8"));
  write(`lambdas/${name}/lambda.json`, json({ name, label: l.label, what: l.what, kind: "function", zeff: l.zeff, timeoutMs: l.timeoutMs, memoryMb: 128 }));
}

// The stores: the built-in's own tables (the Jira reader keeps them), adopted — nothing copied.
const col = (name: string, type: "text" | "integer" | "real" | "json") => ({ name, type });
const STORES = [
  { name: "tickets", adopts: "jira_tickets", key: "key", columns: [col("key", "text"), col("summary", "text"), col("status", "text"), col("status_category", "text"), col("assignee", "text"), col("updated_at", "text"), col("resolved_at", "text"), col("board_id", "integer"), col("mine", "integer")] },
  { name: "boards", adopts: "jira_boards", key: "id", columns: [col("id", "integer"), col("name", "text"), col("type", "text"), col("project_key", "text"), col("enabled", "integer"), col("synced_at", "text")] },
  { name: "comments", adopts: "jira_comments", key: "id", columns: [col("id", "text"), col("ticket", "text"), col("author", "text"), col("at", "text"), col("body", "text")] },
];

const screen = fs.readFileSync(path.join(SRC, "screen.html"), "utf8");
const page = (id: string, title: string, icon: string, extra: Record<string, unknown> = {}) => ({ id, ...(id === "i1" ? {} : { parent: "i1" }), kind: "page", title, icon, content: { type: "doc", content: [{ type: "paragraph" }] }, ...extra });
write(
  "jira-lage.package.json",
  json({
    format: 1,
    id: "jira-lage-ext",
    version: "1.0.0",
    name: "Jira briefing",
    description: "The board briefing of your Jira boards: which tickets matter now, read fresh from Jira, assessed by the Workspace's AI review.",
    icon: "🧭",
    localize: true,
    items: [
      page("i1", "Jira briefing", "🧭", {
        content: { type: "doc", content: [{ type: "paragraph", content: [{ type: "text", text: "The board briefing: the tickets of your Jira boards that moved lately, read fresh from Jira and assessed by the Workspace's AI review — the cards fill in as parts are done. The run is the flow below (by hand: “Analyse” on a Jira board or on the page Board briefing); which tickets matter is the lambda jira-lage.relevant (Studio → Lambdas)." }] }] },
      }),
      page("i2", "Board briefing run", "🧭", {
        flow: {
          name: "jira-lage.board-lage",
          title: "Board briefing",
          description: "The relevant tickets of your Jira boards (with you, or all) read fresh from Jira, their comments kept, then the boards' AI reviews, the AI blocks and the pipelines with AI steps — the Sync menu's step “Board briefing”, by hand.",
          inputs: [
            { name: "all", type: "boolean", help: "All relevant tickets, also those without you" },
            { name: "force", type: "boolean", help: "Assess all cards again, not only those that changed" },
          ],
          nodes: [
            { id: "rel", kind: "action", action: "lambda.invoke", input: { name: "jira-lage.relevant", event: { all: "{{ input.all }}" } } },
            {
              id: "fresh",
              kind: "try",
              nodes: [
                { id: "read", kind: "action", action: "jira.read-issues", input: { keys: "{{ steps.rel.keys }}" } },
                { id: "kept", kind: "if", when: "{{ steps.read.comments }}", then: [{ id: "put", kind: "action", action: "store.put", input: { store: "jira-lage-ext.comments", rows: "{{ steps.read.comments }}" } }], else: [] },
              ],
              catch: [{ id: "note", kind: "set", vars: { note: "{{ error.message | truncate(300) }}" } }],
            },
            { id: "setup", kind: "action", action: "workspace.ensure-reviews", input: {} },
            { id: "review", kind: "action", action: "workspace.review-databases", input: { force: "{{ input.force }}" } },
            { id: "blocks", kind: "try", nodes: [{ id: "refresh", kind: "action", action: "workspace.refresh-ai-blocks", input: {} }], catch: [] },
            { id: "pipes", kind: "try", nodes: [{ id: "run", kind: "action", action: "workspace.run-pipelines", input: { ai: true } }], catch: [] },
            {
              id: "report",
              kind: "action",
              action: "lambda.invoke",
              input: { name: "jira-lage.report", event: { all: "{{ input.all }}", reviewed: "{{ steps.review.reviewed }}", unchanged: "{{ steps.review.unchanged }}", failed: "{{ steps.review.failed }}", error: "{{ steps.review.error }}", note: "{{ vars.note }}" } },
            },
            { id: "done", kind: "return", value: { ok: "{{ steps.report.ok }}", message: "{{ steps.report.message }}" } },
          ],
          requested: { write: "all", ai: true, store: ["jira-lage-ext.comments"] },
          triggers: [{ kind: "manual" }],
          sync: { label: "Board briefing", what: "The briefing on every relevant card of your boards — the Jira boards' tickets (not only yours) and your own boards' cards — shown on the cards (only what changed)", replaces: "boardlage" },
        },
      }),
      {
        id: "i3",
        parent: "i1",
        kind: "database",
        title: "Board briefing",
        icon: "🧭",
        schema: { titleName: "Board briefing", properties: [], views: [{ id: "vjl1", name: "Board briefing", type: "app", filter: { op: "and", rules: [] }, sorts: [], hidden: [], app: "template", template: screen }] },
        rows: [{ id: "r1", title: "Board briefing", cells: {}, content: { type: "doc", content: [{ type: "paragraph" }] } }],
      },
    ],
  }),
);

const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  json({
    $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
    id: "jira-lage-ext",
    name: "Jira briefing",
    version: old.version ?? "0.1.0",
    description: "The board briefing of your Jira boards: which tickets matter now, read fresh from Jira (through the Jira plugin or Zeff's connection) and assessed by the Workspace's AI review. By hand, on a Jira board or on its page.",
    author: "Zeff",
    apiVersion: 1,
    permissions: [],
    contributes: { lambdas: "lambdas", stores: STORES, workspacePackages: ["jira-lage.package.json"] },
  }),
);
write(
  "README.md",
  `# Jira briefing (jira-lage-ext)

The Board-Lage — "Analyse" on a Jira board — as a plugin. Generated by Zeff's \`scripts/port-jira-lage.mts\`.

- The flow \`jira-lage.board-lage\` is the Sync menu's step *Board briefing* (by hand): which tickets matter now (lambda \`jira-lage.relevant\`: the built-in's own rule), read fresh from Jira (the kernel's \`jira.read-issues\`), their comments kept (the store \`comments\` is the built-in's table), the boards' AI reviews, the AI blocks and the pipelines.
- The page *Board briefing* shows your boards and what the next run would read; its buttons start the flow.
- Stays Zeff's: the boards' Workspace databases and *Meine Lage* (made while Jira is synced), the ticket picker and "Assign to me" — they read the same tables with the plugin on.
`,
);
console.log(`${dir}: Jira briefing`);
