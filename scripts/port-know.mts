/**
 * Know's port (zeff-plugins/plugins/know-ext): "What you should know" — the AI's few points before a meeting or beside a mail, a chat, a ticket, a person.
 * The brief itself (the people, their open promises, the timeline, related things, held to the sensitivity labels) is the kernel's read `brief.get`; the plugin
 * is the summary: the lambda `know.summary` (the built-in's summarizeBrief — its instructions, answer shape and line numbering bundled from
 * src/plugins/know/summary-lines.ts), the flow `know.summarize` (asks it and keeps the answer by the brief's hash — ai.memo-set) and the flow `know.prepare`
 * (the briefing's step: the meetings of the next hours summarized beforehand). Its AI task is the plugin's own row in Settings → AI.
 *
 *   npx tsx scripts/port-know.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "know-ext");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

const lib = await build({
  stdin: {
    contents: `export { KNOW_SUMMARY_INSTRUCTIONS, SCHEMA, day, summaryLines } from "@/plugins/know/summary-lines";\nexport { briefEmpty } from "@/plugins/know/shared";`,
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "know-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
write("lambdas/know.summary/lib.mjs", `// Generated by Zeff's scripts/port-know.mts from the built-in's pure core (src/plugins/know/summary-lines.ts) — change it there, generate again.\n${lib.outputFiles[0].text}`);
write("lambdas/know.summary/index.mjs", fs.readFileSync(path.join(ROOT, "scripts", "port-know", "know.summary.mjs"), "utf8"));
write(
  "lambdas/know.summary/lambda.json",
  JSON.stringify(
    {
      name: "know.summary",
      label: "Know: the summary of a brief",
      what: "The AI's short summary on top of a brief: a few points, each resting on numbered lines of the brief and linked to them; made again only when the brief changed.",
      kind: "function",
      zeff: ["ai.memo-get", "prompts.fill", "ai.json"],
      timeoutMs: 240000,
      memoryMb: 128,
    },
    null,
    2,
  ) + "\n",
);
write("lambdas/know.upcoming/index.mjs", fs.readFileSync(path.join(ROOT, "scripts", "port-know", "know.upcoming.mjs"), "utf8"));
write(
  "lambdas/know.upcoming/lambda.json",
  JSON.stringify(
    { name: "know.upcoming", label: "Know: the meetings to prepare", what: "The meetings of the next three hours to make a summary for beforehand — none while the summaries are off.", kind: "function", zeff: ["pref.get", "meetings.upcoming"], timeoutMs: 20000, memoryMb: 128 },
    null,
    2,
  ) + "\n",
);

write(
  "know.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "know-ext",
      version: "1.0.0",
      name: "What you should know",
      description: "The AI's few points before a meeting or beside a mail, a chat, a ticket, a person — from what Zeff put together about it.",
      icon: "💡",
      items: [
        { id: "i1", kind: "page", title: "What you should know", icon: "💡", content: { type: "doc", content: [{ type: "paragraph" }] } },
        {
          id: "i2",
          parent: "i1",
          kind: "page",
          title: "Summarize a brief",
          icon: "💡",
          content: { type: "doc", content: [{ type: "paragraph" }] },
          flow: {
            name: "know.summarize",
            title: "Summarize what you should know",
            description: "The AI's summary of the brief of a meeting (event, occurrence), a Workspace row (row) or refs — kept for it, made again only when it changed (force: anyway). Output { summary }.",
            inputs: [],
            nodes: [
              { id: "brief", kind: "action", action: "brief.get", input: { event: "{{ input.event }}", occurrence: "{{ input.occurrence }}", row: "{{ input.row }}", refs: "{{ input.refs }}" } },
              { id: "summary", kind: "action", action: "lambda.invoke", input: { name: "know.summary", event: { key: "{{ steps.brief.key }}", brief: "{{ steps.brief.brief }}", force: "{{ input.force }}" } } },
              {
                id: "keep",
                kind: "if",
                when: "{{ steps.summary.made }}",
                then: [{ id: "memo", kind: "action", action: "ai.memo-set", input: { scope: "know-summary", ref: "{{ steps.brief.key }}", hash: "{{ steps.summary.summary.hash }}", value: "{{ steps.summary.summary.points }}", at: "{{ steps.summary.summary.at }}" } }],
                else: [],
              },
              { id: "done", kind: "return", value: { summary: "{{ steps.summary.summary }}" } },
            ],
            requested: { write: "all", ai: true },
            triggers: [{ kind: "manual" }],
          },
        },
        {
          id: "i3",
          parent: "i1",
          kind: "page",
          title: "Before your meetings",
          icon: "💡",
          content: { type: "doc", content: [{ type: "paragraph" }] },
          flow: {
            name: "know.prepare",
            title: "Summaries before your meetings",
            description: "The meetings of the next three hours get their summary beforehand (where none is kept for them as they are now). Run with the briefing (the People matching step).",
            inputs: [],
            nodes: [
              { id: "up", kind: "action", action: "lambda.invoke", input: { name: "know.upcoming", event: {} } },
              { id: "each", kind: "foreach", items: "{{ steps.up.meetings }}", as: "m", nodes: [{ id: "one", kind: "call", flow: "know.summarize", input: { event: "{{ m.id }}", occurrence: "{{ m.occurrence }}" }, onError: "continue" }], max: 6 },
            ],
            requested: { write: "all", ai: true },
            triggers: [{ kind: "manual" }],
          },
        },
      ],
    },
    null,
    2,
  ) + "\n",
);

const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "know-ext",
      name: "What you should know",
      version: old.version ?? "0.1.0",
      description: "What you should know right now: the few points before a meeting or beside a mail, a chat, a ticket, a person — from what Zeff put together about the people and things (open promises, last contacts, related tickets), each point linked to its source. Its summary is a lambda you (or the AI) can change.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["know.package.json"],
        aiTasks: [{ id: "summary", label: "What you should know", what: "Sums up in a few points what you should know before a meeting or about a mail, a chat, a ticket, a person — each point linked to its source." }],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# What you should know (know-ext)

The summary on top of a brief, as a plugin. Generated by Zeff's \`scripts/port-know.mts\`.

- The brief (people, open promises, last contacts, related things, held to your sensitivity labels) is Zeff's own: the read \`brief.get\`, shown by the panel as before.
- The lambda \`know.summary\` writes the few points; the flow \`know.summarize\` keeps them by the brief's hash; the flow \`know.prepare\` makes them before your meetings with the briefing.
- Its AI task is the row "What you should know" of this plugin in Settings → AI; the prompt page (System → Prompts → What you should know) works as before.
`,
);
console.log(`${dir}: What you should know`);
