/**
 * Cases' port, kept in step with the built-in (docs/plugins/runtime-conversion.md — stage 1 of its port): the plugin
 * zeff-plugins/plugins/cases-ext. Its data is the built-in's own tables, adopted as its stores (nothing copied — lib/ext/stores.ts
 * ADOPTABLE); the overview is worked out by its lambda cases.overview out of those stores and the kernel's reads (the money ledger, your
 * contacts' names and accounts, the rows the cases are in) with the built-in's own pure core (src/plugins/cases/core.ts, view-data.ts —
 * bundled into lambdas/_lib.mjs with the German and Spanish texts it says); its screen is the built-in's template made of the view
 * language. Still the built-in's: finding case numbers, the AI's summaries, matching payments, the bank — stage 2.
 *
 *   npx tsx scripts/port-cases.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "cases-ext");
const SOURCES = ["src/plugins/cases/core.ts", "src/plugins/cases/view-data.ts", "src/plugins/cases/shared.ts"];

// The texts the core says, translated by the language packs.
const keys = new Set<string>();
keys.add("Booking");
keys.add("Open");
keys.add("Closed");
for (const f of SOURCES) for (const m of fs.readFileSync(path.join(ROOT, f), "utf8").matchAll(/\bt\(\s*"((?:[^"\\]|\\.)*)"/g)) keys.add(JSON.parse(`"${m[1]}"`));
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const pack = JSON.parse(fs.readFileSync(path.join(repo, "plugins", `lang-${lang}`, "bundle.json"), "utf8")) as Record<string, string>;
  strings[lang] = Object.fromEntries([...keys].filter((k) => pack[k]).map((k) => [k, pack[k]]));
}

const entry = `
export { caseFromRow, findCases, overviewOf, paymentOf, standingOf } from "@/plugins/cases/core";
export { aiPartyRows, checkedSummary, dueForSummary, settledSummary, SUMMARY_INSTRUCTIONS, SUMMARY_SCHEMA, summaryPrompt } from "@/plugins/cases/core-summary";
export { lateWarnings, matchPlan } from "@/plugins/cases/core-bank";
export { caseTitle } from "@/plugins/cases/shared";
export { caseAppData, casesAppData } from "@/plugins/cases/view-data";
import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";
const STRINGS = ${JSON.stringify(strings)};
setPluginStrings((lang) => STRINGS[lang] ?? {});
/** A translator for the user's language (context.language): the texts the built-in says, in the same words. */
export const tFor = (lang) => translator(isLang(lang) ? lang : "en");
`;
const r = await build({ stdin: { contents: entry, resolveDir: ROOT, loader: "ts", sourcefile: "cases-port.ts" }, bundle: true, format: "esm", platform: "neutral", target: "es2022", write: false, alias: { "@": path.join(ROOT, "src") }, legalComments: "none" });
fs.mkdirSync(path.join(dir, "lambdas", "cases.overview"), { recursive: true });
fs.writeFileSync(path.join(dir, "lambdas", "_lib.mjs"), `// Generated by Zeff's scripts/port-cases.mts from the built-in Cases' pure core — don't change it here, change the core and generate it\n// again: the built-in and this port work the same out of the same rows.\n${r.outputFiles[0].text}`);

// Finding the cases (stage 2): the plan worked out by the built-in's own core, written by the flow cases.detect through the stores.
const lambda = (name: string, what: string, zeff: string[], code: string) => {
  fs.mkdirSync(path.join(dir, "lambdas", name), { recursive: true });
  fs.writeFileSync(path.join(dir, "lambdas", name, "lambda.json"), JSON.stringify({ name, label: `Cases: ${what.split(":")[0]}`, what, kind: "function", zeff, timeoutMs: 120000, memoryMb: 512 }, null, 2) + "\n");
  fs.writeFileSync(path.join(dir, "lambdas", name, "index.mjs"), code);
};
lambda(
  "cases.detect",
  "finding the cases: the case numbers in your mails, letters and todos — what the flow cases.detect writes (new cases, their new sources, a case's person).",
  ["store.query", "mail.messages", "documents.texts", "todos.texts", "people.emails"],
  `import { findCases } from "./lib.mjs";

/** Every row of a store (pages of 500). */
async function all(zeff, store) {
  const out = [];
  for (let offset = 0; ; offset += 500) {
    const { rows, total } = await zeff.call("store.query", { store, limit: 500, offset });
    out.push(...rows);
    if (!rows.length || out.length >= total) return out;
  }
}

/** The plan (the built-in's own core: findCases) out of what the kernel reads and the cases there are — nothing written here. */
export async function handler(_event, context) {
  const zeff = context.zeff;
  const optional = (p, empty) => p.catch(() => empty);
  const [{ messages }, { docs }, { todos }, people, cases, sources] = await Promise.all([
    zeff.call("mail.messages", { contains: "/" }),
    optional(zeff.call("documents.texts", {}), { docs: [] }),
    zeff.call("todos.texts", {}),
    optional(zeff.call("people.emails", {}).then((r) => r.people), null),
    all(zeff, "cases-ext.cases"),
    all(zeff, "cases-ext.sources"),
  ]);
  return findCases({
    mails: messages,
    docs,
    todos,
    people,
    cases: cases.map((c) => ({ id: c.id, key: c.key, label: c.label, status: c.status, personId: c.person_id, lastAt: c.last_at, updatedAt: c.updated_at })),
    sources: sources.map((s) => ({ caseId: s.case_id, ref: s.ref })),
    now: new Date().toISOString(),
  });
}
`,
);
lambda(
  "cases.link",
  "linking the sources: the new sources of the plan with the ids their cases have now (a new case: the id it got).",
  [],
  `/** The plan's new sources as rows of the sources store: each with its case's id (from the cases as written — store.put's rows). */
export async function handler(event) {
  const ids = new Map((event.cases ?? []).map((c) => [c.key, c.id]));
  return { rows: (event.sources ?? []).filter((s) => ids.has(s.key)).map((s) => ({ case_id: ids.get(s.key), ref: s.ref, kind: s.kind, at: s.at, title: s.title })) };
}
`,
);

// The AI's summaries (stage 2): which cases, what the AI reads (the plan), its answer checked and moved on by the payments since, the parties.
lambda(
  "cases.summarize-plan",
  "the summaries to make: the cases due (never summed up, new sources since — or those asked for), each with what the AI reads.",
  ["store.query", "prompts.text", "sources.texts"],
  `import { caseFromRow, dueForSummary, SUMMARY_INSTRUCTIONS, summaryPrompt } from "./lib.mjs";

async function all(zeff, store) {
  const out = [];
  for (let offset = 0; ; offset += 500) {
    const { rows, total } = await zeff.call("store.query", { store, limit: 500, offset });
    out.push(...rows);
    if (!rows.length || out.length >= total) return out;
  }
}

/** The plan: the due cases (the newest activity first — the built-in's order), each with its prompt (the built-in's own core). */
export async function handler(event, context) {
  const zeff = context.zeff;
  const cases = (await all(zeff, "cases-ext.cases")).map(caseFromRow).sort((a, b) => b.lastAt.localeCompare(a.lastAt));
  const sources = await all(zeff, "cases-ext.sources");
  const counts = {};
  for (const x of sources) counts[x.case_id] = (counts[x.case_id] ?? 0) + 1;
  const ids = Array.isArray(event.ids) && event.ids.length ? event.ids.map(Number) : undefined;
  const due = dueForSummary(cases, counts, { ids, force: event.force === true, limit: Number(event.limit) || 8 });
  if (!due.length) return { items: [] };
  const { text: instructions } = await zeff.call("prompts.text", { key: "cases-compile", fallback: SUMMARY_INSTRUCTIONS });
  const items = [];
  for (const c of due) {
    // (its sources oldest first — the built-in's order)
    const mine = sources.filter((x) => x.case_id === c.id).sort((a, b) => b.at.localeCompare(a.at)).reverse();
    const { sources: said } = await zeff.call("sources.texts", { refs: mine.map((x) => x.ref) });
    const texts = mine.map((x) => ({ ref: x.ref, at: x.at, title: x.title, ...(said[x.ref] ?? {}) }));
    items.push({ id: c.id, key: c.key, sources: mine.length, personId: c.personId, prompt: summaryPrompt(c, texts, instructions) });
  }
  return { items };
}
`,
);
lambda(
  "cases.summarize-apply",
  "a summary kept: the AI's answer checked, moved on by the payments since, and the contacts its names mean (asked of the People plugin).",
  ["store.query", "money.allocations"],
  `import { caseFromRow, checkedSummary, settledSummary, standingOf } from "./lib.mjs";

/** The checked summary (the built-in's own core) as the case's row, moved on by its payments since; what people.contacts is asked. */
export async function handler(event, context) {
  const zeff = context.zeff;
  const item = event.item;
  const summary = checkedSummary(event.answer ?? {}, item.key, item.sources, new Date().toISOString());
  // (your corrections stay over it, as the built-in reads a case — then its payments move it on: todo-paid.ts settleCase)
  const { rows } = await zeff.call("store.query", { store: "cases-ext.cases", where: { id: item.id }, limit: 1 });
  const merged = caseFromRow({ ...rows[0], compiled: JSON.stringify(summary) });
  const { allocations } = await zeff.call("money.allocations", { refs: ["case:" + item.id] });
  const paid = allocations["case:" + item.id] ?? [];
  const moved = merged.compiled ? settledSummary(merged.compiled, paid, merged.compiled.open != null ? standingOf(merged, paid).open : null) : null;
  const compiled = moved ?? summary;
  const { rows: parties } = await zeff.call("store.query", { store: "cases-ext.parties", where: { case_id: item.id } });
  return {
    row: { id: item.id, compiled: JSON.stringify(compiled), updated_at: new Date().toISOString() },
    contacts: [
      { name: summary.creditor ?? "", make: true, kind: summary.creditorKind, creditor: true },
      { name: summary.collector ?? "", make: true, kind: summary.collectorKind, orPerson: item.personId ?? null },
      { name: summary.payee ?? "" },
    ],
    parties,
  };
}
`,
);
lambda(
  "cases.summarize-parties",
  "a case's parties as its summary names them: the contacts found or made, as rows of the parties store — what you chose stays.",
  [],
  `import { aiPartyRows } from "./lib.mjs";

export async function handler(event) {
  const [creditor, collector, payee] = event.ids ?? [];
  return { rows: aiPartyRows(event.caseId, { creditor: creditor ?? null, collector: collector ?? null, payee: payee ?? null }, event.parties ?? []) };
}
`,
);

// Matching the bank's bookings (stage 2): the plan by the built-in's own core, applied by the flow cases.match.
lambda(
  "cases.match-plan",
  "matching the bookings: each payment out not matched yet — to a todo's transfer and its case, a payment already ticked off, one read twice — and what the flow does about it.",
  ["store.query", "money.allocations", "todos.transfers"],
  `import { caseFromRow, matchPlan, tFor } from "./lib.mjs";

async function all(zeff, store, where) {
  const out = [];
  for (let offset = 0; ; offset += 500) {
    const { rows, total } = await zeff.call("store.query", { store, where, limit: 500, offset });
    out.push(...rows);
    if (!rows.length || out.length >= total) return out;
  }
}

/** The plan (the built-in's own core) as the steps of the flow: the bookings kept as matched, payments confirmed and booked, todos done, evidence. */
export async function handler(_event, context) {
  const zeff = context.zeff;
  const t = tFor(context.language);
  const open = (await all(zeff, "cases-ext.bank")).filter((b) => b.amount < 0 && b.case_id == null && b.todo_id == null && b.matched_at == null).sort((a, b) => a.date.localeCompare(b.date) || String(a.id).localeCompare(String(b.id)));
  const empty = { bankRows: [], confirms: [], pays: [], dones: [], evidence: [], matched: 0 };
  if (!open.length) return empty;
  const cases = (await all(zeff, "cases-ext.cases")).map(caseFromRow);
  const running = cases.filter((c) => c.status === "open");
  const { allocations } = running.length ? await zeff.call("money.allocations", { refs: running.map((c) => "case:" + c.id) }) : { allocations: {} };
  const { todos } = await zeff.call("todos.transfers", {});
  const local = (d) => d.toLocaleDateString("sv-SE");
  const plan = matchPlan({
    bookings: open,
    todos,
    keys: Object.fromEntries(cases.map((c) => [c.key, c.id])),
    cases: running.map((c) => ({ id: c.id, key: c.key, compiled: c.compiled })),
    paid: Object.fromEntries(running.map((c) => [c.id, (allocations["case:" + c.id] ?? []).map((a) => ({ paymentId: a.paymentId, date: a.date, amount: a.amount, source: a.source, tx: a.tx }))])),
    since60: local(new Date(Date.now() - 60 * 864e5)),
    booking: t("Booking"),
  });
  const now = new Date().toISOString();
  const out = { ...empty, matched: plan.matched };
  for (const st of plan.steps) {
    if (st.kind === "twin") {
      out.confirms.push({ paymentId: st.paymentId, tx: st.tx, label: st.label });
      out.bankRows.push({ id: st.tx, case_id: st.caseId, matched_at: now });
    } else if (st.kind === "read") out.bankRows.push({ id: st.tx, case_id: st.caseId, matched_at: now });
    else if (st.kind === "evidence") out.evidence.push({ tx: st.tx, evidence: st.evidence });
    else {
      out.bankRows.push({ id: st.tx, case_id: st.caseId, todo_id: st.todoId, matched_at: now });
      if (st.caseId && st.payment) out.pays.push({ ...st.payment, source: "bank", tx: st.tx, allocate: [{ ref: "case:" + st.caseId, amount: Math.abs(st.payment.amount) }] });
      if (st.todoId && st.todoNote) out.dones.push({ id: st.todoId, note: st.todoNote });
    }
  }
  return out;
}
`,
);
lambda(
  "cases.match-evidence",
  "a booking that settled something as evidence: kept as matched.",
  [],
  `export async function handler(event) {
  return { rows: (event.settled ?? []).length ? [{ id: event.tx, matched_at: new Date().toISOString() }] : [] };
}
`,
);

// Warnings before a plan lapses (stage 2): the late instalments, a todo each — the flow cases.warn.
lambda(
  "cases.warn-plan",
  "the instalments ten days late with nothing paid since: a todo each (once per case and due), with the transfer when the account is known.",
  ["store.query", "money.allocations"],
  `import { caseFromRow, caseTitle, lateWarnings } from "./lib.mjs";

async function all(zeff, store) {
  const out = [];
  for (let offset = 0; ; offset += 500) {
    const { rows, total } = await zeff.call("store.query", { store, limit: 500, offset });
    out.push(...rows);
    if (!rows.length || out.length >= total) return out;
  }
}

export async function handler(_event, context) {
  const zeff = context.zeff;
  const today = new Date().toLocaleDateString("sv-SE");
  const cases = (await all(zeff, "cases-ext.cases")).map(caseFromRow).filter((c) => c.status === "open" && !c.compiled?.done);
  const { allocations } = cases.length ? await zeff.call("money.allocations", { refs: cases.map((c) => "case:" + c.id) }) : { allocations: {} };
  const warned = (await all(zeff, "cases-ext.warnings")).map((w) => ({ caseId: w.case_id, due: w.due }));
  const plan = lateWarnings({ cases: cases.map((c) => ({ id: c.id, label: c.label, status: c.status, title: caseTitle(c), compiled: c.compiled })), paid: Object.fromEntries(cases.map((c) => [c.id, allocations["case:" + c.id] ?? []])), warned, today });
  return { warnings: plan.map((w) => ({ ...w, today, ops: w.op ? [w.op] : [] })) };
}
`,
);

// A case's own page (stage 2): its data, and what you change on it — the flows cases.set and cases.set-party.
lambda(
  "cases.case",
  "a case's page: who it is with, where it stands and the money, its todos, mails and letters, the payment, what was paid, its parties, your note.",
  ["workspace.row-source", "store.query", "zeff.installed", "people.list", "todos.by-ids", "money.allocations", "people.accounts"],
  `import { caseAppData, caseFromRow, caseTitle, paymentOf, standingOf, tFor } from "./lib.mjs";

/** The page's data (the built-in's own caseAppData) for the row it stands on — and what its fields start with. */
export async function handler(event, context) {
  const z = context.zeff;
  const t = tFor(context.language);
  const { ref } = await z.call("workspace.row-source", { row: event.row });
  const id = Number(/^case:(\\d+)$/.exec(ref ?? "")?.[1] ?? 0);
  if (!id) throw new Error(t("This row is not a case."));
  const { rows } = await z.call("store.query", { store: "cases-ext.cases", where: { id }, limit: 1 });
  if (!rows[0]) throw new Error(t("Unknown case."));
  const c = caseFromRow(rows[0]);
  const sources = (await z.call("store.query", { store: "cases-ext.sources", where: { case_id: id }, order: "-at", limit: 500 })).rows;
  const partyRows = (await z.call("store.query", { store: "cases-ext.parties", where: { case_id: id } })).rows;
  const { installed } = await z.call("zeff.installed", { ids: ["people", "llm"] });
  const ids = [...new Set([c.personId, ...partyRows.map((p) => p.person_id)].filter(Boolean))];
  const pl = installed.people ? await z.call("people.list", { hrefs: ids }) : { people: [], hrefs: {} };
  const names = Object.fromEntries(pl.people.map((p) => [p.id, p.name]));
  const parties = {};
  for (const p of partyRows) if (names[p.person_id]) parties[p.role] = { personId: p.person_id, name: names[p.person_id], href: pl.hrefs[p.person_id] ?? "", source: p.source === "manual" ? "manual" : "ai" };
  const person = c.personId && names[c.personId] ? { id: c.personId, name: names[c.personId], href: pl.hrefs[c.personId] ?? "" } : null;
  const todoIds = sources.filter((x) => x.ref.startsWith("todo:")).map((x) => Number(x.ref.slice(5)));
  const { todos } = todoIds.length ? await z.call("todos.by-ids", { ids: todoIds }) : { todos: [] };
  const { allocations } = await z.call("money.allocations", { refs: ["case:" + id] });
  const paid = allocations["case:" + id] ?? [];
  const needAccount = !c.compiled?.iban && c.personId && installed.people;
  const { accounts } = needAccount ? await z.call("people.accounts", { ids: [c.personId] }) : { accounts: {} };
  const payment = paymentOf(c, needAccount ? (accounts[c.personId] ?? null) : null);
  const refs = sources.filter((x) => !x.ref.startsWith("todo:")).map((x) => x.ref);
  const bundle = {
    id, key: c.key, label: c.label, title: caseTitle(c), status: c.status, note: c.note, compiled: c.compiled, person, people: pl.people, parties,
    manual: !!c.compiled?.manual, sources: refs,
    todos: todos.map((x) => ({ id: x.id, ref: "T-" + x.id, text: x.text, done: x.status === "done", due: x.due })),
    counts: { mail: sources.filter((x) => x.kind === "mail").length, doc: sources.filter((x) => x.kind === "doc").length, todo: todos.length },
    canCompile: !!installed.llm, payment, compiling: false,
    paid: paid.map((x) => ({ date: x.date, amount: x.amount, todo: x.key.startsWith("todo:") ? "T-" + x.key.slice(5) : null })),
    openNow: standingOf(c, paid).open,
  };
  const data = caseAppData(bundle, { t, busy: false, locale: context.language });
  delete data.bundle;
  return {
    ...data,
    caseId: id,
    rowId: Number(event.row),
    refs,
    statusValue: c.status,
    noteText: c.note,
    payAmount: payment?.amount != null ? payment.amount.toFixed(2).replace(".", ",") : "",
    partyIds: Object.fromEntries(["creditor", "collector", "payee"].map((r) => [r, parties[r] ? String(parties[r].personId) : ""])),
    peopleOptions: [["", "—"], ...pl.people.map((p) => [String(p.id), p.name])],
    bundlePayment: payment,
  };
}
`,
);
lambda(
  "cases.set-row",
  "a case changed by you: its status (open, closed, not a case) or your note.",
  [],
  `export async function handler(event) {
  const id = Number(event.case);
  if (!id) throw new Error("Which case?");
  const row = { id, updated_at: new Date().toISOString() };
  if (event.status !== undefined && event.status !== null && event.status !== "") {
    if (!["open", "closed", "ignored"].includes(event.status)) throw new Error("Unknown status.");
    row.status = event.status;
  }
  if (typeof event.note === "string") row.note = event.note.slice(0, 20000);
  return { rows: [row] };
}
`,
);
lambda(
  "cases.set-party-plan",
  "a party chosen by you (none: taken off) — or the contact just made for it; the case's person follows its creditor when it had none.",
  ["store.query"],
  `export async function handler(event, context) {
  const z = context.zeff;
  const caseId = Number(event.case);
  const role = String(event.role ?? "");
  if (!caseId || !["creditor", "collector", "payee"].includes(role)) throw new Error("Unknown role.");
  const id = Number(event.made) || Number(event.personId) || null;
  const { rows } = await z.call("store.query", { store: "cases-ext.parties", where: { case_id: caseId, role } });
  const out = { put: [], del: [], cases: [] };
  if (id) out.put.push({ case_id: caseId, role, person_id: id, source: "manual" });
  else if (rows.length) out.del.push({ case_id: caseId, role });
  if (role === "creditor" && id) {
    const c = (await z.call("store.query", { store: "cases-ext.cases", where: { id: caseId }, limit: 1 })).rows[0];
    if (c && !c.person_id) out.cases.push({ id: caseId, person_id: id, updated_at: new Date().toISOString() });
  }
  return out;
}
`,
);

// The cases database's rows (the built-in's source "cases", stood in for): one record per case with its money and next step.
lambda(
  "cases.records",
  "the cases database's rows: one per case — its number, party, person, the money (total, open after the payments, instalment), the next step, the account, how many sources, the last activity.",
  ["store.query", "people.names", "money.allocations"],
  `import { caseFromRow, caseTitle, standingOf, tFor } from "./lib.mjs";

async function all(zeff, store) {
  const out = [];
  for (let offset = 0; ; offset += 500) {
    const { rows, total } = await zeff.call("store.query", { store, limit: 500, offset });
    out.push(...rows);
    if (!rows.length || out.length >= total) return out;
  }
}

/** The records as the built-in's source gave them (workspace-source.ts caseRecords) — fields of fixed id and type. */
export async function handler(_event, context) {
  const zeff = context.zeff;
  const t = tFor(context.language);
  const cases = (await all(zeff, "cases-ext.cases")).map(caseFromRow).filter((c) => c.status !== "ignored").sort((a, b) => b.lastAt.localeCompare(a.lastAt));
  const counts = {};
  for (const x of await all(zeff, "cases-ext.sources")) counts[x.case_id] = (counts[x.case_id] ?? 0) + 1;
  const people = [...new Set(cases.map((c) => c.personId).filter(Boolean))];
  const { names } = people.length ? await zeff.call("people.names", { ids: people }).catch(() => ({ names: {} })) : { names: {} };
  const withOpen = cases.filter((c) => c.compiled?.open != null);
  const { allocations } = withOpen.length ? await zeff.call("money.allocations", { refs: withOpen.map((c) => "case:" + c.id) }) : { allocations: {} };
  return cases.map((c) => {
    const s = c.compiled;
    const open = s?.open == null ? null : standingOf(c, allocations["case:" + c.id] ?? []).open;
    return {
      ref: "case:" + c.id,
      title: caseTitle(c),
      key: c.label,
      status: c.status === "closed" || s?.done ? { name: t("Closed"), group: "done" } : { name: t("Open"), group: "todo" },
      fields: {},
      text: c.note,
