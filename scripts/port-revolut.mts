/**
 * Revolut's port (zeff-plugins/plugins/revolut-ext), kept in step with the built-in: its pure core (src/plugins/revolut/core.ts — a
 * statement read into bookings, the account it is of) bundled by esbuild into the plugin's lambdas' shared library, and the lambda
 * `revolut.statement` that fills the kernel's service `bank.statement` with it. Keeping the bookings, the statements among the documents
 * and their note are the kernel's (src/lib/bank/statements.ts); paying by RevTag stays the kernel's todo action while the port is on
 * (state.ts PROVIDED_BY). So the built-in and the port read a statement the same, booking for booking.
 *
 *   npx tsx scripts/port-revolut.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import { keepCatalogFields } from "./lib/catalog-fields.mts";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "revolut-ext");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};

const r = await build({
  stdin: { contents: `export { parseStatement, accountOf } from "@/plugins/revolut/core";`, resolveDir: ROOT, loader: "ts", sourcefile: "revolut-port.ts" },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
write("lambdas/_lib.mjs", `// Generated by Zeff's scripts/port-revolut.mts from the built-in Revolut's pure core — don't change it here, change the core and generate\n// it again: the built-in and this port read a statement the same.\n${r.outputFiles[0].text}`);

write(
  "lambdas/revolut.statement/lambda.json",
  JSON.stringify({ name: "revolut.statement", label: "Revolut: read a statement", what: "A statement (CSV — Revolut's export, in German or English, or another bank's with a date, an amount and a text) read into its bookings and the account it is of; a pending booking left for later.", kind: "function", zeff: [], timeoutMs: 30000, memoryMb: 256 }, null, 2) + "\n",
);
write(
  "lambdas/revolut.statement/index.mjs",
  `import { accountOf, parseStatement } from "./lib.mjs";

/**
 * The kernel's service bank.statement: a statement's bookings and its account (the built-in's own core, lib.mjs). Throws when it is
 * none (no date or amount column) — the kernel says so.
 * @param {{ csv: string, name?: string }} event
 */
export async function handler(event) {
  const csv = String(event?.csv ?? "");
  const name = String(event?.name ?? "");
  return { account: accountOf(name, csv), bookings: parseStatement(csv) };
}
`,
);

const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      ...keepCatalogFields(old),
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "revolut-ext",
      name: "Revolut",
      version: old.version ?? "1.0.0",
      description: "Reads your Revolut statements (the CSV export, in German or English — other banks' CSV too) into Zeff's bank: a file you import on the cases' overview, or one that comes in as a document. Paying someone by their RevTag stays a todo action.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: { lambdas: "lambdas", services: [{ name: "bank.statement", lambda: "revolut.statement" }] },
    },
    null,
    2,
  ) + "\n",
);

write(
  "README.md",
  `# Revolut (revolut-ext)

The port of Zeff's built-in Revolut. Generated by Zeff's \`scripts/port-revolut.mts\` — change the built-in's core and generate it again.

- **Reading a statement**: the lambda \`revolut.statement\` fills the kernel's service \`bank.statement\` — the CSV export of Revolut
  (German or English) or another bank's CSV with a date, an amount and a text: its bookings (a pending one left for later) and the
  account. The reading is the built-in's own pure core (\`src/plugins/revolut/core.ts\`, bundled into \`lambdas/_lib.mjs\`): the same
  bookings, booking for booking.
- **What the kernel does with it** (\`src/lib/bank/statements.ts\`): the bookings kept in the bank, each once (\`bank.import\`, the
  cases' import button); a statement among your documents read by itself, once, and kept as a note of what it is.
- **Paying by RevTag** stays the kernel's todo action while this plugin is on (the built-in counts as there through it).
- **The switch** (*Switch to the plugin* on Revolut's card): this plugin on, the built-in off.
`,
);
console.log(`${dir}: lib ${r.outputFiles[0].text.length} bytes`);
