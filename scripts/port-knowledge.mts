/**
 * Knowledge's port (zeff-plugins/plugins/knowledge-ext): Confluence's pages as a knowledge graph — the chat with the knowledge server, its state, having it read and
 * keeping something in it, and the matching of its pages to your open todos.
 *
 * The split: the kernel keeps the connection to the knowledge server (a service of the account beside Zeff: `service.read`, `service.send` — the address and token
 * are this plugin's settings, else the account's), the export the server reads (/api/knowledge/export, `knowledgeDocs`: Zeff's Jira, Teams, mail … as pages),
 * the panel on a todo, the repos' systems and the todo's own storage (`todos.attached`, `todos.attach`). The plugin is the screen (the page "Chat" in the view
 * language: its state from the lambda `knowledge.screen`, the conversation from `knowledge.chat`, kept by the flow `knowledge.ask` in Zeff's AI memo), the routing of a
 * question (numbers and dates in your own data first: `data.answer`, else the knowledge's answer), the flows `knowledge.sync` / `knowledge.add`, and the step after
 * the briefing: the lambda `knowledge.match` (the built-in's Wissens-Zuordnung, its instructions and picking bundled from src/plugins/knowledge/relations-core.ts)
 * and the flow `knowledge.relate`, which keeps what it picked. Its AI task is the plugin's own row in Settings → AI.
 *
 *   npx tsx scripts/port-knowledge.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "knowledge-ext");
const SRC = path.join(ROOT, "scripts", "port-knowledge");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

const lib = await build({
  stdin: {
    contents: `export { INSTRUCTIONS, LANGUAGE_NAMES, SCHEMA, blockOf, isDue, pickedOf } from "@/plugins/knowledge/relations-core";\nexport { kindOfPage, kindOn } from "@/lib/todo-display";\nexport { entitiesFor } from "@/plugins/knowledge/shared";`,
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "knowledge-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});

type L = { label: string; what: string; zeff: string[]; timeoutMs: number; file: string; lib?: boolean };
const LAMBDAS: Record<string, L> = {
  "knowledge.screen": { label: "Knowledge: the server's state", what: "What the knowledge server holds and is doing: pages, spaces, entities, relations, what isn't compiled yet, the last run.", zeff: ["service.read"], timeoutMs: 15000, file: "knowledge.screen.mjs" },
  "knowledge.chat": { label: "Knowledge: the conversation", what: "The conversation with the knowledge as kept so far.", zeff: ["ai.memo-get"], timeoutMs: 15000, file: "knowledge.chat.mjs" },
  "knowledge.ask": { label: "Knowledge: ask", what: "A question answered from your own data when it is about numbers and dates, else from the pages of the knowledge server, citing them; the conversation with it added.", zeff: ["ai.memo-get", "data.answer", "service.read"], timeoutMs: 600000, file: "knowledge.ask.mjs" },
  "knowledge.match": { label: "Knowledge: match to todos", what: "For each new or changed open todo the knowledge's candidate pages and terms — the AI keeps only those that really fit, each page with a line on why.", zeff: ["todos.attached", "service.read", "prompts.fill", "ai.json"], timeoutMs: 1800000, file: "knowledge.match.mjs", lib: true },
};
for (const [name, l] of Object.entries(LAMBDAS)) {
  if (l.lib) write(`lambdas/${name}/lib.mjs`, `// Generated by Zeff's scripts/port-knowledge.mts from the built-in's pure core (src/plugins/knowledge/relations-core.ts) — change it there, generate again.\n${lib.outputFiles[0].text}`);
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, l.file), "utf8"));
  write(`lambdas/${name}/lambda.json`, JSON.stringify({ name, label: l.label, what: l.what, kind: "function", zeff: l.zeff, timeoutMs: l.timeoutMs, memoryMb: 128 }, null, 2) + "\n");
}

const flow = (name: string, title: string, description: string, nodes: unknown[], requested: Record<string, unknown>, inputs: unknown[] = []) => ({ name, title, description, inputs, nodes, requested, triggers: [{ kind: "manual" }] });
const empty = { type: "doc", content: [{ type: "paragraph" }] };
const input = (name: string, type = "text") => ({ name, type, required: false });

write(
  "knowledge.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "knowledge-ext",
      version: "1.0.0",
      name: "Knowledge",
      description: "Ask the knowledge — Confluence's pages compiled into a knowledge graph — in a chat; have it read, keep something in it, and have its pages matched to your todos.",
      icon: "📚",
      items: [
        { id: "i1", kind: "page", title: "Knowledge", icon: "📚", content: empty },
        {
          id: "i2",
          parent: "i1",
          kind: "database",
          title: "Chat",
          icon: "💬",
          schema: {
            titleName: "Chat",
            properties: [],
            views: [{ id: "vknowledge1", name: "Chat", type: "app", filter: { op: "and", rules: [] }, sorts: [], hidden: [], app: "template", template: fs.readFileSync(path.join(SRC, "view.html"), "utf8") }],
          },
          rows: [{ id: "r1", title: "Chat", cells: {}, content: empty }],
        },
        {
          id: "i3",
          parent: "i1",
          kind: "page",
          title: "Ask the knowledge",
          icon: "💬",
          content: empty,
          flow: flow(
            "knowledge.ask",
            "Ask the knowledge",
            "A question (input question) answered from your own data when it is about numbers and dates, else from the knowledge's pages, citing them — kept in the conversation. Output { turns, error }.",
            [
              { id: "a", kind: "action", action: "lambda.invoke", input: { name: "knowledge.ask", event: { question: "{{ input.question }}" } } },
              { id: "keep", kind: "if", when: "{{ steps.a.at }}", then: [{ id: "memo", kind: "action", action: "ai.memo-set", input: { scope: "knowledge-chat", ref: "main", hash: "{{ steps.a.at }}", value: "{{ steps.a.turns }}", at: "{{ steps.a.at }}" } }], else: [] },
              { id: "done", kind: "return", value: { turns: "{{ steps.a.turns }}", error: "{{ steps.a.error }}" } },
            ],
            { write: "all", ai: true },
            [input("question")],
          ),
        },
        {
          id: "i4",
          parent: "i1",
          kind: "page",
          title: "New conversation",
          icon: "🆕",
          content: empty,
          flow: flow("knowledge.chat-new", "New conversation", "The conversation with the knowledge started anew.", [{ id: "memo", kind: "action", action: "ai.memo-set", input: { scope: "knowledge-chat", ref: "main", hash: "new", value: [] } }], { write: "all" }),
        },
        {
          id: "i5",
          parent: "i1",
          kind: "page",
          title: "Read Confluence now",
          icon: "🔄",
          content: empty,
          flow: flow(
            "knowledge.sync",
            "Read Confluence now",
            "Has the knowledge server read Confluence and compile what is new (it takes a while).",
            [
              { id: "s", kind: "action", action: "service.send", input: { connection: "knowledge-ext", service: "knowledge", method: "POST", path: "/api/sync?compile=1" } },
              { id: "done", kind: "return", value: { started: "{{ steps.s.started }}" } },
            ],
            { api: true },
          ),
        },
        {
          id: "i6",
          parent: "i1",
          kind: "page",
          title: "Add knowledge",
          icon: "➕",
          content: empty,
          flow: flow(
            "knowledge.add",
            "Add knowledge",
            "Something to keep in the knowledge (input text): a fact, a note, how something works — or a link (the page behind it is read). Compiled right after.",
            [
              { id: "s", kind: "action", action: "service.send", input: { connection: "knowledge-ext", service: "knowledge", method: "POST", path: "/api/own", body: { text: "{{ input.text }}" }, timeoutMs: 30000 } },
              { id: "done", kind: "return", value: { title: "{{ steps.s.entry.title }}" } },
            ],
            { api: true },
            [input("text")],
          ),
        },
        {
          id: "i7",
          parent: "i1",
          kind: "page",
          title: "Match knowledge to todos",
          icon: "🧩",
          content: empty,
          flow: flow(
            "knowledge.relate",
            "Match knowledge to todos",
            "For each new or changed open todo the knowledge's pages and terms that really fit it — kept on the todo, where its Knowledge toggle shows them. Run with the briefing (the Knowledge matching step).",
            [
              { id: "m", kind: "action", action: "lambda.invoke", input: { name: "knowledge.match", event: {} } },
              { id: "keep", kind: "if", when: "{{ steps.m.items }}", then: [{ id: "attach", kind: "action", action: "todos.attach", input: { slot: "matches", items: "{{ steps.m.items }}" } }], else: [] },
              { id: "done", kind: "return", value: { todos: "{{ steps.m.todos }}", assigned: "{{ steps.m.assigned }}", failed: "{{ steps.m.failed }}", batches: "{{ steps.m.batches }}" } },
            ],
            { todos: true, ai: true },
          ),
        },
      ],
    },
    null,
    2,
  ) + "\n",
);

const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "knowledge-ext",
      name: "Knowledge",
      version: old.version ?? "0.1.0",
      description: "Ask the knowledge — Confluence's pages compiled into a knowledge graph by Zeff's knowledge server — in a chat with sources, have it read, keep something in it, and have its pages matched to your open todos.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["knowledge.package.json"],
        settings: [
          { key: "serviceUrl", label: "Knowledge server address", kind: "text", help: "Leave empty for this account's own knowledge server (the launcher starts it). Only an address on this machine or your network." },
          { key: "serviceToken", label: "Knowledge server token", kind: "secret", help: "Only when the server asks for one; empty keeps the token Zeff already has for this account." },
        ],
        aiTasks: [{ id: "relations", label: "Knowledge matching", what: "Picks from the knowledge base's hits what really fits each todo." }],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# Knowledge (knowledge-ext)

Confluence's pages as a knowledge graph, as a plugin. Generated by Zeff's \`scripts/port-knowledge.mts\`.

- **Chat** (a page under System, found through the menu's Chat): the knowledge server's state, the conversation (kept in Zeff's AI memo), reading Confluence now, adding something. A question about numbers and dates in your own data is answered from it first (the structured questions); else the knowledge server answers from its pages, citing them.
- **Matching** (the step after the briefing): the lambda \`knowledge.match\` picks, for each new or changed open todo, the pages and terms that really fit; the flow \`knowledge.relate\` keeps them on the todo (its Knowledge toggle).
- **Settings**: the knowledge server's address and token — empty means this account's own server.
- Stays Zeff's (the kernel): the connection itself (\`service.read\`, \`service.send\`), the export the server reads (Jira, Teams, mail … as pages — \`/api/knowledge/export\`; a plugin's own pages join it through \`contributes.knowledgeDocs\`), the panel on a todo, the systems of your repos.
- Its AI task is the row "Knowledge matching" of this plugin in Settings → AI; the prompt page (System → Prompts) works as before.
`,
);
console.log(`${dir}: Knowledge`);
