/**
 * Calendar's port (zeff-plugins/plugins/calendar-ext): the calendar app as a plugin. What stays the kernel: the calendar model (the calendars and appointments tables, the
 * series and their rules, Outlook's and Google's readers and Google's write access, the Done calendar, the proposals' queue, the plugin API calendar.*, the Workspace's
 * calendar database, the sleep series, the todo action `calendar-entry`, the meetings for booking and the meetings the know plugin prepares) — read and written through
 * the generic flow actions `appointments.*` (src/plugins/calendar/flow-actions.ts) and `todos.*`. What the plugin is: the **page** (the app view `views/calendar.html`:
 * the built-in's template with the kit's `<schedule>` for the grid — lambda `calendar.screen`), what you do on it (flows `calendar.save`, `.propose`, `.delete`, `.respond`,
 * `.decide`, `.accept-todo-proposal`, `.move` (with the lambda `calendar.move`), `.calendar`), and the two **AI steps** of the briefing: appointments to todos (lambda
 * `calendar.todos`, flow `calendar.todos`) and the matching of todos to appointments (lambda `calendar.relations`, flow `calendar.relate`), each with its own AI task.
 * No store: the model is read through `appointments.window`, which expands a series into its occurrences.
 *
 *   npx tsx scripts/port-calendar.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import { keepCatalogFields } from "./lib/catalog-fields.mts";
import path from "node:path";
import { build } from "esbuild";
import { calendarViewTemplate } from "./port-calendar/calendar-view.mjs";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "calendar-ext");
const SRC = path.join(ROOT, "scripts", "port-calendar");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

// The AI steps' texts (the built-in's own, src/lib/calendar/prompts.ts) bundled.
const lib = await build({
  stdin: { contents: `export * from "@/lib/calendar/prompts";`, resolveDir: ROOT, loader: "ts", sourcefile: "calendar-port.ts" },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const libText = `// Generated by Zeff's scripts/port-calendar.mts from the built-in's AI texts (src/lib/calendar/prompts.ts) — change them there, generate again.\n${lib.outputFiles[0].text}`;
const shared = fs.readFileSync(path.join(SRC, "_cal.mjs"), "utf8");

const LAMBDAS: Record<string, { label: string; what: string; zeff: string[]; timeoutMs: number; lib?: boolean }> = {
  "calendar.screen": { label: "Calendar: what the page shows", what: "The toolbar's figures, the calendars by source and the appointments of the view and the day asked (a series as its occurrences, the proposed ones, those todos propose) with their details — what the Calendar page reads.", zeff: ["appointments.window"], timeoutMs: 60000 },
  "calendar.move": { label: "Calendar: an appointment dragged", what: "What to write when an appointment is dragged or resized: the appointment with its new times (an occurrence of a series alone), or the new time of an action of a todo.", zeff: ["appointments.event"], timeoutMs: 20000 },
  "calendar.todos": { label: "Calendar: appointments to todos", what: "Which of the appointments of the next days (calendars set to Todos) give you something to do — the AI judges each once; handed back as todos to make, to take away and the verdicts to keep.", zeff: ["pref.get", "appointments.window", "prompts.fill", "ai.json"], timeoutMs: 300000, lib: true },
  "calendar.relations": { label: "Calendar: matching todos to appointments", what: "For each open todo the appointments (of the last two weeks and the next month) it is about — likeliest few by shared words, then the AI picks by content.", zeff: ["appointments.window", "todos.open", "todos.tickets", "prompts.fill", "ai.json"], timeoutMs: 600000, lib: true },
};
for (const [name, l] of Object.entries(LAMBDAS)) {
  write(`lambdas/${name}/_cal.mjs`, shared);
  if (l.lib) write(`lambdas/${name}/lib.mjs`, libText);
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, `${name}.mjs`), "utf8"));
  write(`lambdas/${name}/lambda.json`, JSON.stringify({ name, label: l.label, what: l.what, kind: "function", zeff: l.zeff, timeoutMs: l.timeoutMs, memoryMb: 256 }, null, 2) + "\n");
}

// --- the package: the flows
const text = (name: string) => ({ name, type: "text" });
const page = (id: string, title: string, flow?: Record<string, unknown>) => ({ id, ...(id === "i1" ? {} : { parent: "i1" }), kind: "page", title, icon: "📅", content: { type: "doc", content: [{ type: "paragraph" }] }, ...(flow ? { flow } : {}) });
const API = { api: true };
const call = (id: string, action: string, input: Record<string, unknown>) => ({ id, kind: "action", action, input });
const answer = (from: string) => ({ id: "done", kind: "return", value: { ok: `{{ steps.${from}.ok }}`, message: `{{ steps.${from}.message }}` } });
const manual = [{ kind: "manual" }];
const SAVE_INPUT = { id: "{{ input.id }}", calendarId: "{{ input.calendarId }}", title: "{{ input.title }}", start: "{{ input.start }}", end: "{{ input.end }}", allDay: "{{ input.allDay }}", location: "{{ input.location }}", description: "{{ input.description }}", occurrence: "{{ input.occurrence }}", scope: "{{ input.scope }}" };
write(
  "calendar.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "calendar-ext",
      version: "1.0.0",
      name: "Calendar",
      description: "Your calendars on one page: what you do on it and the briefing's two AI steps.",
      icon: "📅",
      items: [
        page("i1", "Calendar"),
        page("i2", "Save an appointment", {
          name: "calendar.save",
          title: "Make or change an appointment",
          description: "An appointment in one of Zeff's own calendars — new (no id) or changed; a series' occurrence alone, with the following ones or all; in a Google calendar you may write to, there.",
          inputs: ["id", "calendarId", "title", "start", "end", "allDay", "location", "description", "occurrence", "scope"].map(text),
          nodes: [call("save", "appointments.save", SAVE_INPUT), answer("save")],
          requested: API,
          triggers: manual,
        }),
        page("i3", "Propose an appointment", {
          name: "calendar.propose",
          title: "Propose an appointment",
          description: "A new appointment as a proposal (dashed in the calendar) — you accept or dismiss it later.",
          inputs: ["calendarId", "title", "start", "end", "allDay", "location", "description"].map(text),
          nodes: [
            call("propose", "appointments.propose", { calendarId: "{{ input.calendarId }}", title: "{{ input.title }}", allDay: "{{ input.allDay }}", location: "{{ input.location }}", description: "{{ input.description }}", times: [{ start: "{{ input.start }}", end: "{{ input.end }}" }] }),
            answer("propose"),
          ],
          requested: API,
          triggers: manual,
        }),
        page("i4", "Delete an appointment", {
          name: "calendar.delete",
          title: "Delete an appointment",
          description: "An appointment of Zeff's own calendars deleted — a series' occurrence alone, with the following ones, or the whole series.",
          inputs: ["id", "occurrence", "scope"].map(text),
          nodes: [call("del", "appointments.delete", { id: "{{ input.id }}", occurrence: "{{ input.occurrence }}", scope: "{{ input.scope }}" }), answer("del")],
          requested: API,
          triggers: manual,
        }),
        page("i5", "Answer an invitation", {
          name: "calendar.respond",
          title: "Answer an invitation",
          description: "Accepted, maybe or declined — an invitation in a Google calendar you may write to, answered through Google's API.",
          inputs: ["id", "response"].map(text),
          nodes: [call("answer", "appointments.respond", { id: "{{ input.id }}", response: "{{ input.response }}" }), answer("answer")],
          requested: API,
          triggers: manual,
        }),
        page("i6", "Accept or dismiss a proposal", {
          name: "calendar.decide",
          title: "Accept or dismiss a proposed appointment",
          description: "A calendar's proposed appointment accepted (an appointment like any other) or dismissed (taken out, not proposed again).",
          inputs: ["id", "verdict"].map(text),
          nodes: [call("decide", "appointments.decide", { id: "{{ input.id }}", verdict: "{{ input.verdict }}" }), answer("decide")],
          requested: API,
          triggers: manual,
        }),
        page("i7", "Accept what a todo proposes", {
          name: "calendar.accept-todo-proposal",
          title: "Accept the appointment a todo proposes",
          description: "The appointment among a todo's actions entered in the calendar and taken off the todo, noted on it.",
          inputs: ["todo", "index", "title"].map(text),
          nodes: [call("accept", "appointments.accept-todo-proposal", { todo: "{{ input.todo }}", index: "{{ input.index }}", title: "{{ input.title }}" }), answer("accept")],
          requested: API,
          triggers: manual,
        }),
        page("i8", "Move an appointment", {
          name: "calendar.move",
          title: "An appointment dragged or resized",
          description: "The new times of an appointment (an occurrence of a series alone) or of the appointment a todo proposes.",
          inputs: ["item", "start", "end"].map(text),
          nodes: [
            { id: "plan", kind: "action", action: "lambda.invoke", input: { name: "calendar.move", event: { item: "{{ input.item }}", start: "{{ input.start }}", end: "{{ input.end }}" } } },
            {
              id: "write",
              kind: "if",
              when: "{{ steps.plan.kind == 'save' }}",
              then: [call("save", "appointments.save", { id: "{{ steps.plan.input.id }}", calendarId: "{{ steps.plan.input.calendarId }}", title: "{{ steps.plan.input.title }}", start: "{{ steps.plan.input.start }}", end: "{{ steps.plan.input.end }}", allDay: "{{ steps.plan.input.allDay }}", location: "{{ steps.plan.input.location }}", description: "{{ steps.plan.input.description }}", occurrence: "{{ steps.plan.input.occurrence }}", scope: "{{ steps.plan.input.scope }}" })],
              else: [
                {
                  id: "todo",
                  kind: "if",
                  when: "{{ steps.plan.kind == 'todo' }}",
                  then: [call("move", "appointments.move-todo-proposal", { todo: "{{ steps.plan.todo }}", index: "{{ steps.plan.index }}", start: "{{ steps.plan.start }}", end: "{{ steps.plan.end }}" })],
                  else: [],
                },
              ],
            },
            { id: "done", kind: "return", value: { ok: "{{ steps.plan.kind != 'none' }}", error: "{{ steps.plan.error }}" } },
          ],
          requested: API,
          triggers: manual,
        }),
        page("i9", "Change the calendars", {
          name: "calendar.calendar",
          title: "Change the calendars",
          description: "A calendar shown or hidden, recoloured, renamed, counted as busy, offered for booking, set to make todos — or made, or deleted; how many days ahead the todos look.",
          inputs: ["op", "id", "name", "color", "visible", "busy", "book", "todos", "days"].map(text),
          nodes: [call("change", "appointments.calendar", { op: "{{ input.op }}", id: "{{ input.id }}", name: "{{ input.name }}", color: "{{ input.color }}", visible: "{{ input.visible }}", busy: "{{ input.busy }}", book: "{{ input.book }}", todos: "{{ input.todos }}", days: "{{ input.days }}" }), answer("change")],
          requested: API,
          triggers: manual,
        }),
        page("i10", "Appointments to todos", {
          name: "calendar.todos",
          title: "Todos from appointments",
          description: "The appointments of the next days (calendars set to Todos) that give you something to do become todos on their day — the AI says which, once per appointment. Run with the briefing and every 15 minutes.",
          inputs: [],
          nodes: [
            { id: "run", kind: "action", action: "lambda.invoke", input: { name: "calendar.todos", event: {} } },
            call("add", "todos.add-by-ref", { items: "{{ steps.run.adds }}" }),
            call("gone", "todos.dismiss-by-ref", { items: "{{ steps.run.dismiss }}", source: "Kalender" }),
            call("due", "todos.ensure-due", { items: "{{ steps.run.ensureDue }}" }),
            { id: "kept", kind: "if", when: "{{ steps.run.verdicts }}", then: [{ id: "keep", kind: "action", action: "pref.set", input: { plugin: "calendar-ext", key: "calendar:todo-verdicts", value: "{{ steps.run.verdicts }}" } }], else: [] },
            { id: "done", kind: "return", value: { added: "{{ steps.add.added }}", asked: "{{ steps.run.asked }}" } },
          ],
          requested: { api: true, ai: true },
          triggers: manual,
        }),
        page("i11", "Match todos to appointments", {
          name: "calendar.relate",
          title: "Which appointments each todo is about",
          description: "For each open todo the appointments it is about — shown at the todo, in its context. Run with the briefing.",
          inputs: [],
          nodes: [
            { id: "run", kind: "action", action: "lambda.invoke", input: { name: "calendar.relations", event: {} } },
            call("set", "todos.set-related", { kind: "calendar", picks: "{{ steps.run.picks }}" }),
            { id: "done", kind: "return", value: { todos: "{{ steps.run.todos }}", changed: "{{ steps.set.changed }}", batches: "{{ steps.run.batches }}", failed: "{{ steps.run.failed }}" } },
          ],
          requested: { api: true, ai: true },
          triggers: manual,
        }),
      ],
    },
    null,
    2,
  ) + "\n",
);

// --- the page
write("views/calendar.html", calendarViewTemplate());

const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      ...keepCatalogFields(old),
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "calendar-ext",
      name: "Calendar",
      version: old.version ?? "0.1.0",
      description: "One calendar for everything: your own calendars and those of your sources in one page (day, week, month, agenda), appointments made and moved, proposals accepted, todos made from appointments and matched to them. The model stays Zeff's; the page and the AI steps are yours to change.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["calendar.package.json"],
        appViews: [{ id: "calendar", dataType: "calendar", label: "Calendar", icon: "📅", template: "views/calendar.html" }],
        aiTasks: [
          { id: "todos", label: "Calendar: appointments to todos", what: "Decides which of the next days' appointments give you something to do — only those become todos (a blocker like “Pause” doesn't)." },
          { id: "relations", label: "Calendar: matching", what: "Matches the open todos to the appointments they are about (by content)." },
        ],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# Calendar (calendar-ext)

Zeff's calendar as a plugin. Generated by Zeff's \`scripts/port-calendar.mts\`.

- **The page** (\`views/calendar.html\`, an app view for the Calendar database): the built-in's toolbar and sidebar, the grid is the kit's \`<schedule>\` (day, week, month, agenda). Click opens the details (accept/dismiss a proposal, answer an invitation, delete — a series' occurrence, the following ones or all), dragging moves or resizes, dragging on free time opens a new appointment.
- **Lambdas** (read only): \`calendar.screen\`, \`calendar.move\`, \`calendar.todos\` (appointments to todos), \`calendar.relations\` (todos matched to appointments).
- **Flows** write: \`calendar.save\`, \`.propose\`, \`.delete\`, \`.respond\`, \`.decide\`, \`.accept-todo-proposal\`, \`.move\`, \`.calendar\`, \`.todos\`, \`.relate\` — through the kernel's \`appointments.*\` and \`todos.*\` actions (permission \`api\`).
- **Stays the kernel's**: the model (calendars, appointments, series), Outlook and Google Calendar's readers, Google's write access, the proposals queue, the Workspace's calendar database, the plugin API \`calendar.*\`, the todo action \`calendar-entry\`, the meetings for booking and the settings page.
- **Left out so far**: the dotted small month, changing the words of an existing appointment (drag it, or delete and make it again), repeating series and guests in the new-appointment form, keyboard shortcuts, the merged "Done" stripes, dashed proposals (they say "Proposed:").
`,
);
console.log(`${dir}: Calendar`);
