/**
 * The Code tab's screens as a plugin (zeff-plugins/plugins/work-ext): the sessions list, a session's page (the conversation as it is written, what a live session asks of
 * you, your next message, interrupt, stop), a ticket's page and the new-session page, all in the view language (one database "Code" whose view is the template
 * scripts/port-work/work-view.html). The lambda `work.screen` shapes what the screen shows from the kernel's reads work.session-list and work.session-open
 * (src/plugins/work/flow-actions.ts); what changes something (start, send, answer, interrupt, stop, archive, delete) is a flow of the package calling the kernel's
 * work.session-* actions (they need the flow's permission "api", which the switch grants). The engine — workers, runs, the work host, the logs — stays the kernel's.
 * The list's sort and grouping are the built-in's own src/components/work/session-groups.ts, bundled.
 *
 *   npx tsx scripts/port-work.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "work-ext");
const SRC = path.join(ROOT, "scripts", "port-work");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

// The texts of the screen's data in the languages the packs have: every t("…") of the lambda.
const KEYS: string[] = [];
for (const m of ["work.screen.mjs", "work.panes.mjs", "work.settings.mjs"].map((f) => fs.readFileSync(path.join(SRC, f), "utf8")).join(" ").matchAll(/\bt\(\s*"((?:[^"\\]|\\.)*)"/g)) {
  const k = JSON.parse('"' + m[1] + '"');
  if (!KEYS.includes(k)) KEYS.push(k);
}
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const file = path.join(repo, "plugins", `lang-${lang}`, "bundle.json");
  const pack = fs.existsSync(file) ? (JSON.parse(fs.readFileSync(file, "utf8")) as Record<string, string>) : {};
  strings[lang] = Object.fromEntries(KEYS.filter((k) => pack[k]).map((k) => [k, pack[k]]));
}
const lib = await build({
  stdin: {
    contents: `import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";
const STRINGS = ${JSON.stringify(strings)};
setPluginStrings((lang) => STRINGS[lang] ?? {});
export const tFor = (lang) => translator(isLang(lang) ? lang : "en");
export { groupSessions, priorityOf, stamp } from "@/components/work/session-groups";
export { fileStatusText, modeText } from "@/components/work/mode-text";`,
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "work-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const libText = `// Generated by Zeff's scripts/port-work.mts from the built-in's pure shapes (src/components/work/session-groups.ts) — change them there, generate again.\n${lib.outputFiles[0].text}`;

const LAMBDAS: Record<string, { label: string; what: string; zeff: string[]; timeoutMs: number }> = {
  "work.screen": {
    label: "Code: what the screen shows",
    what: "The sessions list (grouped and sorted), and by what is picked a session's conversation with its asks, a ticket's page or the new-session page — shaped from the engine's reads.",
    zeff: ["work.session-list", "work.session-open", "work.composer", "work.dangling", "work.branches", "work.attachments", "work.session-files", "work.folders"],
    timeoutMs: 30000,
  },
  "work.settings": {
    label: "Code: the settings",
    what: "The workers' and live sessions' settings and the repos, as the settings screen shows them.",
    zeff: ["work.settings", "work.admin"],
    timeoutMs: 30000,
  },
  "work.panes": {
    label: "Code: a session's changes and dev servers",
    what: "The files a session changed since it began, with their diffs, and its dev servers from .claude/launch.json.",
    zeff: ["work.session-changes"],
    timeoutMs: 60000,
  },
};
for (const [name, l] of Object.entries(LAMBDAS)) {
  write(`lambdas/${name}/lib.mjs`, libText);
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, `${name}.mjs`), "utf8"));
  write(`lambdas/${name}/lambda.json`, JSON.stringify({ name, label: l.label, what: l.what, kind: "function", zeff: l.zeff, timeoutMs: l.timeoutMs, memoryMb: 128 }, null, 2) + "\n");
}

/** A flow of the package: one kernel action done by a button; its answer handed back as the flow's output. */
const flow = (id: string, name: string, title: string, description: string, action: string, input: Record<string, string>) => ({
  id,
  parent: "i1",
  kind: "page",
  title,
  icon: "🛠️",
  content: { type: "doc", content: [{ type: "paragraph" }] },
  flow: {
    name,
    title,
    description,
    inputs: [],
    nodes: [
      { id: "do", kind: "action", action, input },
      { id: "done", kind: "return", value: { runId: "{{ steps.do.runId }}", runs: "{{ steps.do.runs }}", message: "{{ steps.do.message }}", url: "{{ steps.do.url }}", out: "{{ steps.do.out }}", code: "{{ steps.do.code }}", ref: "{{ steps.do.ref }}" } },
    ],
    requested: { api: true },
    triggers: [{ kind: "manual" }],
  },
});

const template = fs.readFileSync(path.join(SRC, "work-view.html"), "utf8");
const settingsTemplate = fs.readFileSync(path.join(SRC, "work-settings-view.html"), "utf8");
write(
  "work.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "work-ext",
      version: "1.3.0",
      name: "Code",
      description: "The Code tab in the Workspace: sessions with workers, their conversations, permission questions, tickets.",
      icon: "🛠️",
      items: [
        { id: "i1", kind: "page", title: "Code", icon: "🛠️", content: { type: "doc", content: [{ type: "paragraph" }] } },
        {
          id: "i2",
          parent: "i1",
          kind: "database",
          title: "Sessions",
          icon: "🛠️",
          schema: {
            titleName: "Code",
            properties: [],
            views: [{ id: "vwork1", name: "Code", type: "app", filter: { op: "and", rules: [] }, sorts: [], hidden: [], app: "template", template }],
          },
          rows: [{ id: "r1", title: "Code", cells: {}, content: { type: "doc", content: [{ type: "paragraph" }] } }],
        },
        flow("i3", "work.start", "Start a session", "A new session (a new todo and a worker on it): input instruction, ticket, repoId, provider, repoPath, branch, workspace, mode, model, effort, elevated. Output { runId }.", "work.session-start", { instruction: "{{ input.instruction }}", ticket: "{{ input.ticket }}", repoId: "{{ input.repoId }}", provider: "{{ input.provider }}", repoPath: "{{ input.repoPath }}", branch: "{{ input.branch }}", workspace: "{{ input.workspace }}", mode: "{{ input.mode }}", model: "{{ input.model }}", effort: "{{ input.effort }}", elevated: "{{ input.elevated }}", attach: "{{ input.attach }}" }),
        flow("i4", "work.send", "Send a message into a session", "Your next message in a session's conversation (input run, text). Output { runId }.", "work.session-send", { run: "{{ input.run }}", text: "{{ input.text }}", attach: "{{ input.attach }}" }),
        flow("i5", "work.live", "Do something in a live session", "Send, answer an ask, interrupt, switch the mode (input run, do, text, requestId, behavior, always, message, interrupt, then, answers, mode, option).", "work.session-live", {
          run: "{{ input.run }}",
          do: "{{ input.do }}",
          text: "{{ input.text }}",
          requestId: "{{ input.requestId }}",
          behavior: "{{ input.behavior }}",
          always: "{{ input.always }}",
          message: "{{ input.message }}",
          interrupt: "{{ input.interrupt }}",
          then: "{{ input.then }}",
          answers: "{{ input.answers }}",
          mode: "{{ input.mode }}",
          option: "{{ input.option }}",
          model: "{{ input.model }}",
          effort: "{{ input.effort }}",
          cmd: "{{ input.cmd }}",
          attach: "{{ input.attach }}",
        }),
        {
          id: "i10",
          parent: "i1",
          kind: "database",
          title: "Code settings",
          icon: "⚙️",
          schema: {
            titleName: "Code settings",
            properties: [],
            views: [{ id: "vwork2", name: "Code settings", type: "app", filter: { op: "and", rules: [] }, sorts: [], hidden: [], app: "template", template: settingsTemplate }],
          },
          rows: [{ id: "r2", title: "Code settings", cells: {}, content: { type: "doc", content: [{ type: "paragraph" }] } }],
        },
        flow("i11", "work.setting", "Change a Code setting", "One setting changed (input scope: work | claude, field, value). Output { message }.", "work.settings-save", { scope: "{{ input.scope }}", field: "{{ input.field }}", value: "{{ input.value }}" }),
        flow("i12", "work.repo-save", "Add or change a repo", "A repo for workers (input id, name, path, gitlabProject, boards, tickets, instructions, delivery).", "work.repo-save", { id: "{{ input.id }}", name: "{{ input.name }}", path: "{{ input.path }}", gitlabProject: "{{ input.gitlabProject }}", boards: "{{ input.boards }}", tickets: "{{ input.tickets }}", instructions: "{{ input.instructions }}", delivery: "{{ input.delivery }}" }),
        flow("i13", "work.repo-delivery", "How a repo's work is delivered", "A repo's delivery only: mr | direct (input id, delivery).", "work.repo-save", { id: "{{ input.id }}", part: "delivery", delivery: "{{ input.delivery }}" }),
        flow("i14", "work.repo-delete", "Remove a repo", "A repo off the list; its folder is not touched (input id).", "work.repo-delete", { id: "{{ input.id }}" }),
        flow("i15", "work.branch", "Switch a session's branch", "The branch a session works on (input run, branch). Output { message }.", "work.session-branch", { run: "{{ input.run }}", branch: "{{ input.branch }}" }),
        flow("i16", "work.dangling-end", "Kill all dangling sessions", "Every dangling session stopped, the workers free. Output { message }.", "work.dangling-end", {}),
        flow("i17", "work.admin", "Set up or remove automatic admin sessions", "input do: install | remove | uac. Output { message }.", "work.admin-do", { do: "{{ input.do }}" }),
        flow("i18", "work.attach", "Attach a file or picture", "A file the upload brought, kept for the next message (input scope: new | run:<id>, token, name). Output { ref, name, size }.", "work.attach", { scope: "{{ input.scope }}", token: "{{ input.token }}", name: "{{ input.name }}" }),
        flow("i19", "work.attach-remove", "Take an attachment off", "One waiting attachment, or all of a scope (input scope, ref).", "work.attach-remove", { scope: "{{ input.scope }}", ref: "{{ input.ref }}" }),
        flow("i20", "work.repo-systems", "Read the repos' systems", "The systems of all repos read from the knowledge again. Output { message }.", "work.repo-systems", {}),
        flow("i9", "work.git", "Commit, push, merge request, dev servers", "In a session's folder: input run, do (commit | push | mr | proc-start | proc-stop), message, title, name. Output { message, url }.", "work.session-git", { run: "{{ input.run }}", do: "{{ input.do }}", message: "{{ input.message }}", title: "{{ input.title }}", name: "{{ input.name }}" }),
        flow("i6", "work.stop", "Stop a session's run", "A run stopped or taken out of the queue (input run).", "work.session-stop", { run: "{{ input.run }}" }),
        flow("i7", "work.archive", "Archive a session", "A session out of the list, or back (input todo, archived: true | false).", "work.session-archive", { todo: "{{ input.todo }}", archived: "{{ input.archived }}" }),
        flow("i8", "work.delete", "Delete a session", "A session deleted for good — its runs and logs; its todo stays (input todo).", "work.session-delete", { todo: "{{ input.todo }}" }),
      ],
    },
    null,
    2,
  ) + "\n",
);

write("views/work.html", template);
write("views/work-settings.html", settingsTemplate);
const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "work-ext",
      name: "Code",
      version: old.version ?? "0.1.0",
      description: "The Code tab in the Workspace: your sessions with workers and agents, each conversation live, the questions they ask you, tickets and new sessions. The engine stays Zeff's.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["work.package.json"],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# Code (work-ext)

The screens of the Code tab as a plugin. Generated by Zeff's \`scripts/port-work.mts\`.

- The screen is the view language: the database *Sessions* (under the page *Code*) has one view, \`views/work.html\`; the lambda \`work.screen\` gives it its data.
- The engine (workers, runs, the work host, the logs, the live sessions) is Zeff's: the lambda reads through \`work.session-list\` and \`work.session-open\`; what changes something is a flow of the package (\`work.start\`, \`work.send\`, \`work.live\`, \`work.stop\`, \`work.archive\`, \`work.delete\`) calling \`work.session-*\` — each needs the permission "api", which *Switch to the plugin* grants.
- Not in this slice (the built-in Code tab has it): the composer's options (repo, model, mode, effort, attachments, slash commands), the Changes and Preview panes, the branch switcher, the settings page, the Repos page.
`,
);
console.log(`${dir}: Code`);
