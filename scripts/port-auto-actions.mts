/**
 * Auto actions' port (zeff-plugins/plugins/auto-actions-ext): the AI step after the briefing that gives every open todo without a button ready-made
 * actions. Its review is the lambda `auto-actions.review` (the built-in's reviewTodosForActions over the kernel's todo reads — todos.open, todos.sources,
 * todos.tickets, todos.ops-rules, todos.clean-ops, calendar.busy, facts.list, mail.conversation, mail.senders, people.named-in, actions.offer-context,
 * prompts.fill — with its own prompt, answer shape and appointment placing bundled); the flow `autoactions.review` (a sync step standing in for the
 * built-in's "autoactions") puts what it proposed on the todos (todos.set-actions) and keeps what was offered (pref.set). Its AI task is the plugin's own row in Settings → AI.
 *
 *   npx tsx scripts/port-auto-actions.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "auto-actions-ext");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

const lib = await build({
  stdin: {
    contents: `export { INSTRUCTIONS, SCHEMA, autoActionsPrompt, busyLinesOf } from "@/plugins/auto-actions/prompt";\nexport { appointmentsAllowed, placeAppointment, PRIVATE_WINDOW } from "@/plugins/auto-actions/placing";`,
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "auto-actions-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
write("lambdas/auto-actions.review/lib.mjs", `// Generated by Zeff's scripts/port-auto-actions.mts from the built-in's pure cores (src/plugins/auto-actions/prompt.ts, placing.ts) — change the core, generate again.\n${lib.outputFiles[0].text}`);
write("lambdas/auto-actions.review/index.mjs", fs.readFileSync(path.join(ROOT, "scripts", "port-auto-actions", "auto-actions.review.mjs"), "utf8"));
write(
  "lambdas/auto-actions.review/lambda.json",
  JSON.stringify(
    {
      name: "auto-actions.review",
      label: "Auto actions: the review",
      what: "Goes through the open todos without actions and has the AI propose ready-made ones (a message, a comment, a mail, a meeting, a hand-over) — handed back for the flow to put on the todos.",
      kind: "function",
      zeff: ["jira.my-name", "todos.ops-rules", "prompts.fill", "pref.get", "todos.open", "todos.sources", "todos.tickets", "people.named-in", "mail.conversation", "facts.list", "actions.offer-context", "calendar.busy", "mail.senders", "todos.clean-ops", "ai.json"],
      timeoutMs: 1800000,
      memoryMb: 256,
    },
    null,
    2,
  ) + "\n",
);

write(
  "auto-actions.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "auto-actions-ext",
      version: "1.0.0",
      name: "Auto actions",
      description: "The AI step after the briefing: every open todo without a button gets ready-made actions from what the installed plugins can do.",
      icon: "⚡",
      items: [
        { id: "i1", kind: "page", title: "Auto actions", icon: "⚡", content: { type: "doc", content: [{ type: "paragraph" }] } },
        {
          id: "i2",
          parent: "i1",
          kind: "page",
          title: "Review the todos for actions",
          icon: "⚡",
          content: { type: "doc", content: [{ type: "paragraph" }] },
          flow: {
            name: "autoactions.review",
            title: "Review the todos for actions",
            description: "The AI goes through the open todos without actions and proposes ready-made ones, one click each. Run with every briefing (its last step); input ids: only those todos, all: every one again.",
            inputs: [],
            nodes: [
              { id: "review", kind: "action", action: "lambda.invoke", input: { name: "auto-actions.review", event: { all: "{{ input.all }}", ids: "{{ input.ids }}" } } },
              {
                id: "put",
                kind: "foreach",
                items: "{{ steps.review.changes }}",
                as: "c",
                nodes: [{ id: "set", kind: "action", action: "todos.set-actions", input: { id: "{{ c.id }}", ops: "{{ c.ops }}", why: "{{ c.why }}", mode: "{{ c.mode }}", replace: "{{ c.replace }}", reviewedAt: "{{ c.reviewedAt }}" } }],
                max: 500,
              },
              { id: "kept", kind: "if", when: "{{ steps.review.setOffered }}", then: [{ id: "offered", kind: "action", action: "pref.set", input: { plugin: "auto-actions-ext", key: "autoactions:offered", value: "{{ steps.review.offered }}" } }], else: [] },
              { id: "done", kind: "return", value: { ok: "{{ steps.review.ok }}", message: "{{ steps.review.message }}", reviewed: "{{ steps.review.reviewed }}", withActions: "{{ steps.review.withActions }}" } },
            ],
            requested: { write: "all", ai: true },
            sync: { label: "Auto actions", what: "Ready actions for the todos without a button — by the AI, from what the installed plugins can do (after each briefing)", replaces: "autoactions" },
            triggers: [{ kind: "manual" }],
          },
        },
      ],
    },
    null,
    2,
  ) + "\n",
);

const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "auto-actions-ext",
      name: "Auto actions",
      version: old.version ?? "0.1.0",
      description: "The AI step after the briefing: every open todo without a button gets ready-made actions from what the installed plugins can do (a message, a comment, a mail draft, a meeting, a hand-over). Its review is a lambda you or the AI can change.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["auto-actions.package.json"],
        aiTasks: [{ id: "review", label: "Auto actions", what: "Turns todos into ready-made actions (message, comment, mail, meeting, hand-over)." }],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# Auto actions (auto-actions-ext)

The AI step after the briefing, as a plugin. Generated by Zeff's \`scripts/port-auto-actions.mts\`.

- The review is the lambda \`auto-actions.review\` (the built-in's own logic over the kernel's todo reads); the flow \`autoactions.review\` runs it as the briefing's last step and puts the proposed actions on the todos.
- Its AI task is the row "Auto actions" of this plugin in Settings → AI. Your prompt page (System → Prompts → Auto-actions) works as before.
- The "Propose actions" button on a todo still uses the built-in's code until that is removed.
`,
);
console.log(`${dir}: Auto actions`);
