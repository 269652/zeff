/**
 * Questions' port (zeff-plugins/plugins/questions-ext): structured questions — a question about numbers and dates answered from Zeff's own data. The
 * plugin is the planning and the phrasing: the lambda `questions.ask` (the built-in's askStructured over the kernel's `data.views` and `data.query`, with
 * its two prompts bundled from src/plugins/questions/prompts.ts); the query layer itself — the views over Zeff's data with their sensitivity labels — is the kernel's.
 * Its AI task is the plugin's own row in Settings → AI.
 *
 *   npx tsx scripts/port-questions.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import { keepCatalogFields } from "./lib/catalog-fields.mts";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "questions-ext");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

const lib = await build({
  stdin: { contents: `export { ANSWER_INSTRUCTIONS, PLAN_INSTRUCTIONS } from "@/plugins/questions/prompts";`, resolveDir: ROOT, loader: "ts", sourcefile: "questions-port.ts" },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
write("lambdas/questions.ask/lib.mjs", `// Generated by Zeff's scripts/port-questions.mts from the built-in's prompts (src/plugins/questions/prompts.ts) — change them there, generate again.\n${lib.outputFiles[0].text}`);
write("lambdas/questions.ask/index.mjs", fs.readFileSync(path.join(ROOT, "scripts", "port-questions", "questions.ask.mjs"), "utf8"));
write(
  "lambdas/questions.ask/lambda.json",
  JSON.stringify(
    {
      name: "questions.ask",
      label: "Questions: ask your own data",
      what: "A question about numbers and dates, answered from Zeff's own data: the AI plans queries over the named views, Zeff runs them, the AI phrases the answer citing the rows. Or: not about the data (text).",
      kind: "function",
      zeff: ["data.views", "data.query", "prompts.fill", "ai.json"],
      timeoutMs: 600000,
      memoryMb: 256,
    },
    null,
    2,
  ) + "\n",
);
const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      ...keepCatalogFields(old),
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "questions-ext",
      name: "Questions",
      version: old.version ?? "0.1.0",
      description: "Questions about numbers and dates answered from Zeff's own data: the AI plans queries over the named views, Zeff runs them, the AI phrases the answer from the numbers and cites the rows. The planning and phrasing are lambdas you or the AI can change.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        aiTasks: [{ id: "structured", label: "Structured questions", what: "Decides whether a question is about your data, plans the query over it and phrases the answer from the numbers." }],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# Questions (questions-ext)

Structured questions as a plugin. Generated by Zeff's \`scripts/port-questions.mts\`.

- The lambda \`questions.ask\` plans the queries, has Zeff run them (the kernel's \`data.query\`, over the views of \`data.views\`) and phrases the answer. The knowledge chat and the MCP tool \`ask_structured\` ask it while this plugin stands in for the built-in.
- The views over your data and their sensitivity labels stay Zeff's (the plugins that bring a view — the timeline — add it as before).
- Its AI task is the row "Structured questions" of this plugin in Settings → AI; your prompt pages (System → Prompts → Structured questions) work as before.
`,
);
console.log(`${dir}: Questions`);
