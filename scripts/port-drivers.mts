/**
 * The chat connectors' ports with their scrapers — WhatsApp, Signal (zeff-plugins/plugins/<id>-ext): nothing of theirs left in the kernel.
 *  - the scraper: the driver lambda `<id>.driver` (kind driver — capability D) made of the built-in's own files (driver.mjs, adapter.mjs,
 *    contract.json), unchanged but for where Zeff's generic automation kit comes from (`zeff:chrome`, `zeff:automation/…`) and its stdio
 *    server (its tools are called by the driver runner). Kept like any lambda: when WhatsApp Web or Signal Desktop changes and it breaks,
 *    it is mended in the Studio — by you or the AI — and the fix is kept in Zeff's database;
 *  - the sync: the flow `<id>.sync` (a step of the Sync menu in the built-in's place) — the scraper run, the messages kept with the
 *    kernel's generic `messages.save`;
 *  - replies, a chat's history, Signal's sign-in go through the same driver while the plugin is on (plugins/drivers.ts runDriver).
 *
 *   npx tsx scripts/port-drivers.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { swapPlugin } from "./lib/swap-reads.mts";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");

/** A built-in's scraper file, its imports of Zeff's kit by their fixed names, its "run as a program" check gone. */
function ported(text: string, file: string): string {
  let s = text
    .replace(/^#![^\n]*\n/, "")
    .replace(/(["'])\.\.\/\.\.\/\.\.\/scripts\/chrome-cdp\.mjs\1/g, '"zeff:chrome"')
    .replace(/(["'])\.\.\/\.\.\/\.\.\/scripts\/automation\/([a-z0-9-]+)\.mjs\1/g, '"zeff:automation/$2"');
  if (/\.\.\/\.\.\/\.\.\/scripts\//.test(s)) throw new Error(`${file}: it imports more of Zeff's scripts than the kit names — look at it.`);
  const guard = /if \(process\.argv\[1\] && path\.resolve\(process\.argv\[1\]\)\.toLowerCase\(\) === fileURLToPath\(import\.meta\.url\)\.toLowerCase\(\)\) \{/;
  const own = /^function send\(msg\) \{/m;
  if (file === "driver.mjs" && own.test(s)) {
    // (a driver with a stdio loop of its own — GitLab's: its tools collected instead, each under the tab lock)
    const at = s.search(own);
    const names = [...s.slice(at).matchAll(/if \(name === "([a-z_]+)"\) return ok\(id, textResult\(await (?:withTabLock\("([A-Za-z ]+)", name, \(\) => ([A-Za-z]+)\(args\), debug\)|([A-Za-z]+)\(\))\)\);/g)];
    if (!names.length) throw new Error(`${file}: its tool dispatch isn't where it was — look at it.`);
    s = `${s.slice(0, at)}import { serveMcp } from "zeff:automation/mcp-stdio";
// (a driver lambda: its tools are collected and called by Zeff)
serveMcp({
  name: "${path.basename(file)}",
  tools: TOOLS,
  log,
  handlers: {
${names.map((m) => (m[2] ? `    ${m[1]}: (args) => withTabLock("${m[2]}", "${m[1]}", () => ${m[3]}(args), debug),` : `    ${m[1]}: () => ${m[4]}(),`)).join("\n")}
  },
});
`;
  } else if (file === "driver.mjs") {
    if (!guard.test(s)) throw new Error(`${file}: its "run as a program" check isn't where it was — look at it.`);
    s = s.replace(guard, "// (a driver lambda: its tools are collected — serveMcp of zeff:automation/mcp-stdio — and called by Zeff)\n{");
  }
  return `// Generated by Zeff's scripts/port-drivers.mts from the built-in's ${file}. Mend it in the Studio when the app changes: the fix is kept
// in Zeff's database and wins over this one until you reset it.\n${s}`;
}

const CHATS = [
  {
    id: "teams",
    name: "Teams",
    icon: "🟣",
    folder: "",
    files: ["driver.mjs"],
    what: "Your Teams mentions and 1:1 messages — read from Teams in the automation Chrome (its own cache, read-only).",
    description: "Reads your Teams mentions and 1:1 messages into Zeff from Teams in the account's automation Chrome — its own cache, read-only. Replies are sent through the same scraper. Its scraper is a lambda you (or the AI) can mend when Teams changes. (Reading Teams through Microsoft's API with your sign-in is still Zeff's — switch only when it is the automation Chrome.)",
    read: `const PM_DAYS = 90;
const CHAT_DAYS = 3;

/** Where you were mentioned and what colleagues wrote you (1:1), and every chat's last days — Teams opened in a tab when it isn't. */
async function read(event, context) {
  const r = await context.mcp.call("teams_messages", { pmDays: PM_DAYS, chatDays: CHAT_DAYS, openIfMissing: true, launch: event.launch === true || event.launch === "true" });
  if (!r || !Array.isArray(r.messages)) throw new Error(String(typeof r === "string" ? r : "Teams returned nothing readable.").slice(0, 300));
  return r;
}`,
    gate: [
      { id: "up", kind: "action", action: "chrome.up", input: {} },
      { id: "wait", kind: "if", when: "env.trigger.kind == 'schedule' and not steps.up.up", then: [{ id: "later", kind: "return", value: { ok: true, message: "The automation Chrome isn't running — later." } }], else: [] },
    ],
    launch: "{{ env.trigger.kind != 'schedule' }}",
  },
  {
    id: "gitlab",
    name: "GitLab",
    icon: "🦊",
    folder: "",
    files: ["driver.mjs"],
    what: "Your merge requests, their comments and your branches — read through GitLab's pages in the automation Chrome.",
    description: "Reads your GitLab merge requests, their comments and your branches into Zeff — through GitLab in the account's automation Chrome. Replies, merges, opened merge requests and resolved threads go through the same scraper. Its scraper is a lambda you (or the AI) can mend when GitLab changes. (Connected through GitLab's API with a token or sign-in? That reading is still Zeff's — switch only when it is the automation Chrome.)",
    read: `const DAYS = 90;

/** Merge requests, comments and branches: all after a first sync, else what changed since (a day's overlap). */
async function read(event, context) {
  const r = await context.mcp.call("gitlab_items", { baseUrl: String(event.baseUrl ?? "").replace(/\\/+$/, ""), sinceIso: event.sinceIso || undefined, days: DAYS, openIfMissing: true, launch: event.launch === true || event.launch === "true" });
  if (!r || !Array.isArray(r.items)) throw new Error(String(typeof r === "string" ? r : "GitLab returned nothing readable.").slice(0, 300));
  return r;
}`,
    gate: [
      { id: "up", kind: "action", action: "chrome.up", input: {} },
      { id: "wait", kind: "if", when: "env.trigger.kind == 'schedule' and not steps.up.up", then: [{ id: "later", kind: "return", value: { ok: true, message: "The automation Chrome isn't running — later." } }], else: [] },
    ],
    launch: "{{ env.trigger.kind != 'schedule' }}",
  },
  {
    id: "whatsapp",
    name: "WhatsApp",
    icon: "🟢",
    folder: "WhatsApp",
    what: "Your chats' latest messages (WhatsApp Web's chat list — no chat opened, nothing marked read).",
    description: "Reads your WhatsApp chats' messages into Zeff from WhatsApp Web in the account's automation Chrome — no chat opened, nothing marked read. Replies and a chat's history go through the same scraper. Its scraper is a lambda you (or the AI) can mend when WhatsApp Web changes.",
    read: `const DAYS = 3;
const FULL_DAYS = 60;

/** The messages of the active chats (the first time: two months) — WhatsApp Web's insides changed: its chat list instead, said. */
async function read(event, context) {
  const days = event.known === true || event.known === "true" ? DAYS : FULL_DAYS;
  const launch = event.launch === true || event.launch === "true";
  let r = null;
  try {
    r = await context.mcp.call("whatsapp_messages", { days, maxLoads: days > DAYS ? 8 : 3, openIfMissing: true, launch });
  } catch (e) {
    console.warn(\`WhatsApp: \${e?.message ?? e} — reading the chat list instead.\`);
  }
  if (r && Array.isArray(r.messages)) return r;
  if (r?.error === "no-internals") console.warn(\`WhatsApp: \${r.hint ?? "WhatsApp Web changed"}\${r.missing?.length ? \` (missing: \${r.missing.join(", ")})\` : ""} — reading the chat list instead.\`);
  const c = await context.mcp.call("whatsapp_chats", { days, maxChats: days > DAYS ? 300 : 100, openIfMissing: true, launch });
  if (!c || !Array.isArray(c.messages)) throw new Error(String(typeof c === "string" ? c : "WhatsApp returned nothing readable.").slice(0, 300));
  return c;
}`,
    // By itself only while the automation Chrome runs (the built-in's rule).
    gate: [
      { id: "up", kind: "action", action: "chrome.up", input: {} },
      { id: "wait", kind: "if", when: "env.trigger.kind == 'schedule' and not steps.up.up", then: [{ id: "later", kind: "return", value: { ok: false, message: "The automation Chrome isn't running. Not synced." } }], else: [] },
    ],
    launch: "{{ env.trigger.kind != 'schedule' }}",
  },
  {
    id: "signal",
    name: "Signal",
    icon: "🔵",
    folder: "Signal",
    what: "Your Signal chats' latest messages (from Signal Desktop — no chat opened, nothing marked read).",
    description: "Reads your Signal chats' messages into Zeff from Signal Desktop on this computer — no chat opened, nothing marked read. Replies, a chat's history and the sign-in go through the same scraper. Its scraper is a lambda you (or the AI) can mend when Signal Desktop changes.",
    read: `const DAYS = 3;
const FULL_DAYS = 60;

/** The messages of the active chats (the first time: two months); Signal Desktop started (in the tray, with its port) when it isn't running. */
async function read(event, context) {
  const days = event.known === true || event.known === "true" ? DAYS : FULL_DAYS;
  const r = await context.mcp.call("signal_messages", { days, maxLoads: days > DAYS ? 8 : 3, launch: true });
  if (!r || !Array.isArray(r.messages)) throw new Error(String(typeof r === "string" ? r : "Signal returned nothing readable.").slice(0, 300));
  return r;
}`,
    // By itself only while Signal Desktop runs (the built-in's rule) — nothing is started for it.
    gate: [
      { id: "wait", kind: "if", when: "env.trigger.kind == 'schedule'", then: [
        { id: "status", kind: "action", action: "driver.call", input: { name: "signal.driver", event: { tool: "signal_status", args: { launch: false } } } },
        { id: "down", kind: "if", when: "not steps.status.open and not steps.status.chrome", then: [{ id: "later", kind: "return", value: { ok: true, message: "Signal Desktop isn't running — later" } }], else: [] },
      ], else: [] },
    ],
    launch: true,
  },
] as const;

for (const c of CHATS) {
  const id = `${c.id}-ext`;
  const dir = path.join(repo, "plugins", id);
  const lam = path.join(dir, "lambdas", `${c.id}.driver`);
  fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });
  fs.mkdirSync(lam, { recursive: true });
  const builtin = path.join(ROOT, "src", "plugins", c.id);
  for (const f of ("files" in c ? c.files : ["driver.mjs", "adapter.mjs"])) fs.writeFileSync(path.join(lam, f), ported(fs.readFileSync(path.join(builtin, f), "utf8"), f));
  if (fs.existsSync(path.join(builtin, "contract.json"))) fs.copyFileSync(path.join(builtin, "contract.json"), path.join(lam, "contract.json"));
  fs.writeFileSync(
    path.join(lam, "index.mjs"),
    `import "./driver.mjs";

${c.read}

/**
 * ${c.name}'s scraper (a driver: it runs with the account's automation Chrome / the app on this computer). event.tool: read (what the sync
 * keeps: { known, launch }) — or one of the scraper's own tools with event.args (context.mcp.tools: status, selftest, messages, chats,
 * history, send …).
 */
export async function handler(event, context) {
  const tool = String(event?.tool ?? "read");
  if (tool === "read") return read(event ?? {}, context);
  return context.mcp.call(tool, event?.args ?? {});
}
`,
  );
  fs.writeFileSync(path.join(lam, "lambda.json"), JSON.stringify({ name: `${c.id}.driver`, label: `${c.name}: the scraper`, what: c.what, kind: "driver", timeoutMs: 600000, memoryMb: 512 }, null, 2) + "\n");

  const had = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
  const version = had.version ?? "1.0.0";
  // (GitLab: how it is set up first — read through its API, a token or sign-in, is still Zeff's —, what it brought kept by the kernel's gitlab.keep)
  const gitlabNodes = [
    { id: "cfg", kind: "action", action: "gitlab.settings", input: {} },
    { id: "api", kind: "if", when: "steps.cfg.via == 'api'", then: [{ id: "noapi", kind: "return", value: { ok: false, message: "GitLab is connected through its API — the plugin reads through the automation Chrome only; connect GitLab through the Chrome on the Connections page, or switch back." } }], else: [] },
    ...c.gate,
    {
      id: "reading",
      kind: "try",
      nodes: [{ id: "read", kind: "action", action: "driver.call", input: { name: "gitlab.driver", event: { tool: "read", baseUrl: "{{ steps.cfg.baseUrl }}", sinceIso: "{{ steps.cfg.sinceIso }}", launch: c.launch } } }],
      catch: [
        { id: "failed", kind: "action", action: "gitlab.keep", input: { items: [], ok: false, message: "{{ error.message }}" } },
        { id: "stop", kind: "return", value: { ok: false, message: "{{ error.message | truncate(300) }}" } },
      ],
    },
    { id: "keep", kind: "action", action: "gitlab.keep", input: { items: "{{ steps.read.items }}" } },
    { id: "done", kind: "return", value: "{{ steps.keep }}" },
  ];
  // (Teams: how it is read first — through Microsoft's API is still Zeff's —, what it brought kept by the kernel's teams.keep)
  const teamsNodes = [
    { id: "cfg", kind: "action", action: "teams.settings", input: {} },
    { id: "api", kind: "if", when: "steps.cfg.via == 'api'", then: [{ id: "noapi", kind: "return", value: { ok: false, message: "Teams is read through Microsoft's API — the plugin reads through the automation Chrome only; switch the Connections page to the Chrome, or switch back." } }], else: [] },
    ...c.gate,
    {
      id: "reading",
      kind: "try",
      nodes: [{ id: "read", kind: "action", action: "driver.call", input: { name: "teams.driver", event: { tool: "read", launch: c.launch } } }],
      catch: [
        { id: "failed", kind: "action", action: "teams.keep", input: { ok: false, message: "{{ error.message }}" } },
        { id: "stop", kind: "return", value: { ok: false, message: "{{ error.message | truncate(300) }}" } },
      ],
    },
    { id: "keep", kind: "action", action: "teams.keep", input: { messages: "{{ steps.read.messages }}" } },
    { id: "done", kind: "return", value: "{{ steps.keep }}" },
  ];
  const flow = {
    name: `${c.id}.sync`,
    title: `Read ${c.name}`,
    description: c.what,
    inputs: [],
    nodes: c.id === "gitlab" ? gitlabNodes : c.id === "teams" ? teamsNodes : [
      ...c.gate,
      { id: "cnt", kind: "action", action: "messages.count", input: { folder: c.folder } },
      {
        id: "reading",
        kind: "try",
        nodes: [{ id: "read", kind: "action", action: "driver.call", input: { name: `${c.id}.driver`, event: { tool: "read", known: "{{ steps.cnt.count > 0 }}", launch: c.launch } } }],
        catch: [
          { id: "signin", kind: "action", action: "login.notice", input: { service: c.id, message: "{{ error.message }}" } },
          { id: "failed", kind: "return", value: { ok: false, message: `${c.name}: {{ error.message | truncate(300) }}` } },
        ],
      },
      { id: "save", kind: "action", action: "messages.save", input: { source: c.id, messages: "{{ steps.read.messages }}" } },
      { id: "fine", kind: "action", action: "login.notice", input: { service: c.id, ok: true } },
      { id: "done", kind: "return", value: { ok: true, message: "{{ steps.save.what }}" } },
    ],
    requested: { sync: [c.id], driver: [`${c.id}.driver`] },
    triggers: [{ kind: "schedule", everyMinutes: 15, from: "08:00", to: "19:00" }],
    sync: { label: c.name, what: c.what, replaces: c.id },
  };
  fs.writeFileSync(
    path.join(dir, `${c.id}.package.json`),
    JSON.stringify(
      {
        format: 1,
        id,
        version,
        name: c.name,
        description: `${c.name} read into Zeff — a sync of the Sync menu.`,
        icon: c.icon,
        localize: true,
        items: [
          { id: "i1", kind: "page", title: c.name, icon: c.icon, content: { type: "doc", content: [{ type: "paragraph", content: [{ type: "text", text: `${c.what} The sync is the flow below — a step of the Sync menu; how often it runs: the Sync settings. The scraper is the driver lambda ${c.id}.driver (Studio → Lambdas): when the app changes and the sync breaks, it is mended there.` }] }] } },
          { id: "i2", parent: "i1", kind: "page", title: `Read ${c.name}`, icon: "⚡", content: { type: "doc", content: [{ type: "paragraph" }] }, flow },
        ],
      },
      null,
      2,
    ) + "\n",
  );
  fs.writeFileSync(
    path.join(dir, "zeff-plugin.json"),
    JSON.stringify({ $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json", id, name: c.name, version, description: c.description, author: "Zeff", apiVersion: 1, permissions: ["exec"], contributes: { lambdas: "lambdas", workspacePackages: [`${c.id}.package.json`] } }, null, 2) + "\n",
  );
  fs.writeFileSync(
    path.join(dir, "README.md"),
    `# ${c.name} (${id})

${c.description}

- **The scraper** is the driver lambda \`${c.id}.driver\` — the built-in's own files (\`driver.mjs\`, \`adapter.mjs\`, \`contract.json\`),
  Zeff's generic automation kit imported by name (\`zeff:chrome\`, \`zeff:automation/…\`). A lambda of kind *driver*: it runs with the
  account's automation Chrome / the app on this computer, outside the sandbox (this plugin asks for \`exec\`). **When the app changes and
  the sync breaks**, mend it in the Studio (Lambdas → ${c.id}.driver) — you or the AI; the fix is kept in Zeff's database.
- **The sync** is the flow \`${c.id}.sync\` — a step of the Sync menu in the built-in's place: the scraper's \`read\`, the messages kept with
  the kernel's \`messages.save\` (the inbox, the chats, the todos found in them read them as before). Its permissions: \`sync: ${c.id}\`,
  \`driver: ${c.id}.driver\` — allowed when you switch.
- **Replies, a chat's history${c.id === "signal" ? ", the sign-in" : ""}** go through the same scraper while this plugin is on.
- **Generated** by Zeff's \`scripts/port-drivers.mts\`.

**Switching:** Plugins → ${c.name} (built-in) → *Switch to the plugin*.
`,
  );
  swapPlugin(dir);
  console.log(`${dir}: ${c.name} ${version}`);
}

// ── Scrapers of plugins whose sync stays a kernel flow (the mail's keeping is shared: lib/mail/sync.ts) — only the scraper moves in ──
// Outlook (mail and calendar share one scraper), Gmail, Google Calendar: the built-in's driver.mjs (+ the helper files it imports from
// lib/) as the driver lambda `<id>.driver` of the port's plugin; the plugin's manifest gets `lambdas` and the `exec` permission, nothing else
// of it changes. Callers (the mail sync, attachments, accounts, the calendar pulls) reach it through runDriver (plugins/drivers.ts).
const SCRAPERS = [
  { id: "outlook", plugin: "outlook-mail-ext", name: "Outlook", what: "Reads your Outlook mails and calendar in the account's automation Chrome (Outlook Web — mail lists, attachments, calendar weeks); nothing is marked read.", helpers: ["src/lib/calendar/owa-extractor.mjs", "src/lib/mail/mime.mjs"] },
  { id: "gmail", plugin: "gmail-ext", name: "Gmail", what: "Reads your Gmail accounts' mails, threads and attachments in the account's automation Chrome; nothing is marked read.", helpers: ["src/lib/mail/mime.mjs"] },
  { id: "google-calendar", plugin: "google-calendar-ext", name: "Google Calendar", what: "Reads your Google calendars' events (and which accounts are signed in) in the account's automation Chrome.", helpers: [] },
];
for (const c of SCRAPERS) {
  const dir = path.join(repo, "plugins", c.plugin);
  if (!fs.existsSync(path.join(dir, "zeff-plugin.json"))) {
    console.log(`${c.plugin}: not in the plugins folder — skipped (run scripts/port-connectors.mts first)`);
    continue;
  }
  const lam = path.join(dir, "lambdas", `${c.id}.driver`);
  fs.rmSync(lam, { recursive: true, force: true });
  fs.mkdirSync(lam, { recursive: true });
  let text = fs.readFileSync(path.join(ROOT, "src", "plugins", c.id, "driver.mjs"), "utf8");
  // (the helper files beside it: its imports of lib/ made local)
  text = fs.readFileSync(path.join(ROOT, "src", "plugins", c.id, "driver.mjs"), "utf8");
  for (const h of c.helpers) {
    const base = path.basename(h);
    const sub = h.replace(/^src\/lib\//, "");
    text = text.split(`"../../lib/${sub}"`).join(`"./${base}"`);
    fs.copyFileSync(path.join(ROOT, h), path.join(lam, base));
  }
  fs.writeFileSync(path.join(lam, "driver.mjs"), ported(text, "driver.mjs"));
  fs.writeFileSync(
    path.join(lam, "index.mjs"),
    `import "./driver.mjs";

/**
 * ${c.name}'s scraper (a driver: it runs with the account's automation Chrome). event: { tool, args } — one of the scraper's own tools
 * (context.mcp.tools), answered as the scraper does.
 */
export async function handler(event, context) {
  return context.mcp.call(String(event?.tool ?? ""), event?.args ?? {});
}
`,
  );
  fs.writeFileSync(path.join(lam, "lambda.json"), JSON.stringify({ name: `${c.id}.driver`, label: `${c.name}: the scraper`, what: c.what, kind: "driver", timeoutMs: 600000, memoryMb: 512 }, null, 2) + "\n");
  // The manifest: lambdas and exec added — the rest as it is.
  const mf = path.join(dir, "zeff-plugin.json");
  const m = JSON.parse(fs.readFileSync(mf, "utf8")) as { permissions?: string[]; contributes?: Record<string, unknown> };
  m.permissions = [...new Set([...(m.permissions ?? []), "exec"])];
  m.contributes = { ...(m.contributes ?? {}), lambdas: "lambdas" };
  fs.writeFileSync(mf, JSON.stringify(m, null, 2) + "\n");
  console.log(`${dir}: scraper ${c.id}.driver`);
}
