/**
 * Open loops' port (zeff-plugins/plugins/loops-ext): what is still open between you and others — the engine as a plugin. The loops the rules read in the
 * messages (detect.ts), the promises the AI read (the commitment claims), what became of each (the store `state`: the built-in's table loops_state, adopted),
 * the closing by rule and by the AI, your word on a loop — worked out by lambdas over the kernel's reads (messages.recent, people.resolve, people.claims,
 * messages.of-ref, messages.later, timeline.events-for, store.query) with the built-in's own pure rules bundled (src/plugins/loops/core.ts); the flows write
 * (people.claim-review, people.claim-close, learning.feedback, store.put). The Today page, the inbox chips, the people's pages and the MCP tool stay Zeff's
 * screens and read the lambda `loops.all` through the kernel's snapshot (lib/ext/snapshots.ts).
 *
 *   npx tsx scripts/port-loops.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "loops-ext");
const SRC = path.join(ROOT, "scripts", "port-loops");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

const lib = await build({
  stdin: { contents: `export * from "@/plugins/loops/core";`, resolveDir: ROOT, loader: "ts", sourcefile: "loops-port.ts" },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const libText = `// Generated by Zeff's scripts/port-loops.mts from the built-in's pure rules (src/plugins/loops/core.ts) — change them there, generate again.\n${lib.outputFiles[0].text}`;
const shared = fs.readFileSync(path.join(SRC, "_loops.mjs"), "utf8");

const READS = ["store.query", "people.claims", "messages.of-ref", "messages.recent", "people.resolve"];
const LAMBDAS: Record<string, { label: string; what: string; zeff: string[]; timeoutMs: number }> = {
  "loops.all": { label: "Open loops: all of them", what: "Every open loop (the rules' and the AI's), the closed ones of the last two weeks and the rest — what the Today page, the inbox chips, the people's pages and the MCP read.", zeff: READS, timeoutMs: 60000 },
  "loops.decision": { label: "Open loops: your word on a loop", what: "Close, dismiss, confirm, reopen, accept or reject a closing, put off — worked out: what the flow writes.", zeff: READS, timeoutMs: 60000 },
  "loops.closings": { label: "Open loops: closing by rule", what: "Promises whose ticket or thread shows them kept, closed — a reply about one proposed.", zeff: [...READS, "messages.later"], timeoutMs: 120000 },
  "loops.ai-close": { label: "Open loops: the AI's closings", what: "The AI's look at the promises still open: a proposal for each one a message shows kept, with a quote.", zeff: [...READS, "timeline.events-for", "prompts.fill", "ai.json"], timeoutMs: 600000 },
};
for (const [name, l] of Object.entries(LAMBDAS)) {
  write(`lambdas/${name}/lib.mjs`, libText);
  write(`lambdas/${name}/_loops.mjs`, shared);
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, `${name}.mjs`), "utf8"));
  write(`lambdas/${name}/lambda.json`, JSON.stringify({ name, label: l.label, what: l.what, kind: "function", zeff: l.zeff, timeoutMs: l.timeoutMs, memoryMb: 256 }, null, 2) + "\n");
}

const STORE = ["loops-ext.state"];
const put = { id: "state", kind: "action", action: "store.put", input: { store: "loops-ext.state", rows: "{{ steps.run.stateRows }}" } };
const closeEach = { id: "claims", kind: "foreach", items: "{{ steps.run.closes }}", as: "c", nodes: [{ id: "close", kind: "action", action: "people.claim-close", input: { id: "{{ c.id }}", by: "rule", closeRef: "{{ c.closeRef }}", quote: "{{ c.quote }}", href: "{{ c.href }}" } }], max: 200 };
write(
  "loops.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "loops-ext",
      version: "1.0.0",
      name: "Open loops",
      description: "What is still open between you and others: your word on a loop, the closing by rule and by the AI.",
      icon: "🔁",
      items: [
        { id: "i1", kind: "page", title: "Open loops", icon: "🔁", content: { type: "doc", content: [{ type: "paragraph" }] } },
        {
          id: "i2",
          parent: "i1",
          kind: "page",
          title: "Your word on a loop",
          icon: "🔁",
          content: { type: "doc", content: [{ type: "paragraph" }] },
          flow: {
            name: "loops.decide",
            title: "Your word on a loop",
            description: "Close, dismiss (not a loop), confirm, reopen, accept-close / reject-close (a proposal to close it) or later — for the loop ref. Run by the Today page and the people's pages.",
            inputs: [],
            nodes: [
              { id: "run", kind: "action", action: "lambda.invoke", input: { name: "loops.decision", event: { ref: "{{ input.ref }}", op: "{{ input.op }}" } } },
              {
                id: "write",
                kind: "if",
                when: "{{ steps.run.ok }}",
                then: [
                  { id: "reviews", kind: "foreach", items: "{{ steps.run.claimReviews }}", as: "r", nodes: [{ id: "review", kind: "action", action: "people.claim-review", input: { id: "{{ r.id }}", op: "{{ r.op }}" } }], max: 5 },
                  { id: "closes", kind: "foreach", items: "{{ steps.run.claimCloses }}", as: "c", nodes: [{ id: "close", kind: "action", action: "people.claim-close", input: { id: "{{ c.id }}", by: "{{ c.by }}", closeRef: "{{ c.closeRef }}", quote: "{{ c.quote }}", href: "{{ c.href }}" } }], max: 5 },
                  { id: "ledger", kind: "foreach", items: "{{ steps.run.feedbacks }}", as: "f", nodes: [{ id: "note", kind: "action", action: "learning.feedback", input: { feedback: "{{ f }}" } }], max: 5 },
                  put,
                ],
                else: [],
              },
              { id: "done", kind: "return", value: { ok: "{{ steps.run.ok }}", error: "{{ steps.run.error }}" } },
            ],
            requested: { write: "all", store: STORE },
            triggers: [{ kind: "manual" }],
          },
        },
        {
          id: "i3",
          parent: "i1",
          kind: "page",
          title: "Close loops by rule",
          icon: "🔁",
          content: { type: "doc", content: [{ type: "paragraph" }] },
          flow: {
            name: "loops.close-by-rule",
            title: "Close the open loops by rule",
            description: "The promises whose ticket or thread shows them kept are closed — a reply about one is proposed for you to confirm. Run after the People step reads the messages, and now and then.",
            inputs: [],
            nodes: [{ id: "run", kind: "action", action: "lambda.invoke", input: { name: "loops.closings", event: {} } }, closeEach, put],
            requested: { write: "all", store: STORE },
            triggers: [{ kind: "manual" }],
          },
        },
        {
          id: "i4",
          parent: "i1",
          kind: "page",
          title: "The AI's closings",
          icon: "🔁",
          content: { type: "doc", content: [{ type: "paragraph" }] },
          flow: {
            name: "loops.close-by-ai",
            title: "The AI looks at the open promises",
            description: "For the promises still open, what came since from those people: a message that shows one kept is proposed, with a quote — you confirm. Run after the People step.",
            inputs: [],
            nodes: [{ id: "run", kind: "action", action: "lambda.invoke", input: { name: "loops.ai-close", event: {} } }, put],
            requested: { write: "all", ai: true, store: STORE },
            triggers: [{ kind: "manual" }],
          },
        },
      ],
    },
    null,
    2,
  ) + "\n",
);

const col = (name: string, type = "text") => ({ name, type });
const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "loops-ext",
      name: "Open loops",
      version: old.version ?? "0.1.0",
      description: "What is still open between you and others: promises, questions and requests nobody answered, Jira comments addressed to you. A loop closes where the source leaves no doubt; a reply or the AI's reading is proposed for you to confirm. The engine is lambdas you or the AI can change.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        stores: [
          {
            name: "state",
            adopts: "loops_state",
            key: "ref",
            columns: [col("ref"), col("state"), col("closed_by"), col("close_ref"), col("close_quote"), col("closed_at"), col("proposal_ref"), col("proposal_quote"), col("proposal_href"), col("proposal_at"), col("proposal_by"), col("rejected", "json"), col("snooze_until"), col("snapshot", "json"), col("updated_at")],
          },
        ],
        workspacePackages: ["loops.package.json"],
        aiTasks: [{ id: "close", label: "Open loops: kept?", what: "Whether a message shows an open promise kept." }],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# Open loops (loops-ext)

The engine of the open loops as a plugin. Generated by Zeff's \`scripts/port-loops.mts\`.

- Lambdas: \`loops.all\` (every loop), \`loops.decision\` (your word on one), \`loops.closings\` (closing by rule), \`loops.ai-close\` (the AI's closings) — the built-in's own rules, bundled, over the kernel's reads.
- Flows: \`loops.decide\`, \`loops.close-by-rule\`, \`loops.close-by-ai\` write what the lambdas worked out.
- What became of each loop is the built-in's table \`loops_state\`, adopted — nothing copied.
- The Today page, the chips in the inbox, the people's pages and the MCP tool \`open_loops\` stay Zeff's and read this plugin's answer.
`,
);
console.log(`${dir}: Open loops`);
