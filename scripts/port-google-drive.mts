/**
 * Google Drive's port (zeff-plugins/plugins/google-drive-ext), made from Zeff's kit — nothing of Drive in the kernel but the generic pieces
 * (docs/plugins/manifest.md, `contributes.oauth`): the sign-in with the user's own OAuth client (the kernel serves the way there and back,
 * keeps the tokens encrypted, refreshes them), the actions oauth.fetch / oauth.upload / oauth.download for a flow, oauth.token for a lambda.
 *
 *  - the Drive API client (src/plugins/google-drive/api.ts), read-only, as lambdas (scripts/google-drive-port/*.mjs): what to do is *planned*
 *    there — which backups and documents go up, which files come in, which folders have to be made;
 *  - what changes Drive or Zeff is the flows' (a lambda only reads): the sync steps `drivebackup` and `drivedocs` as the sync flows
 *    `google-drive.sync-backups` and `google-drive.sync-documents` (`sync.replaces`), the folders' flow, the chosen folders to read;
 *  - the page — the sign-in, what syncs, the folders to read — as a block of the view language (view.html);
 *  - the settings: the OAuth client (id, secret), the folder's name and the three switches, the plugin's settings (⚙️ on its card);
 *  - the files Zeff recorded as its own in Drive: the built-in's table google_drive_files, adopted — nothing goes up twice through the switch.
 *
 *   npx tsx scripts/port-google-drive.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "google-drive-ext");
const SRC = path.join(ROOT, "scripts", "google-drive-port");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
const json = (v: unknown) => JSON.stringify(v, null, 2) + "\n";
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

const CONN = "google-drive-ext.drive";
const STORES = ["google-drive-ext.files", "google-drive-ext.state", "google-drive-ext.pullfolders"];
const API = "https://www.googleapis.com";
const FOLDER_MIME = "application/vnd.google-apps.folder";
const FIELDS = "id,name,mimeType,size,md5Checksum,modifiedTime";

// ── The texts the sync says (the built-in's, translated by the language packs). ──
const KEYS = [
  "{n} uploaded",
  "{n} removed (the retention)",
  "{n} not uploaded: no password set",
  "Everything is in Drive already.",
  "{n} uploaded before",
  "{n} came in from Drive",
  "{n} failed",
  "Everything is in sync.",
  "Files you add in Drive can't be read with the access Zeff has — connect again to give it.",
  "“{name}” is too large (at most {n} MB).",
  "Google Drive isn't connected — connect it on its page.",
];
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const file = path.join(repo, "plugins", `lang-${lang}`, "bundle.json");
  const pack = fs.existsSync(file) ? (JSON.parse(fs.readFileSync(file, "utf8")) as Record<string, string>) : {};
  strings[lang] = Object.fromEntries(KEYS.filter((k) => pack[k]).map((k) => [k, pack[k]]));
}
write("lambdas/_lib.mjs", `// Generated by Zeff's scripts/port-google-drive.mts (scripts/google-drive-port/_lib.mjs) — don't change it here.\n${fs.readFileSync(path.join(SRC, "_lib.mjs"), "utf8").replace("__STRINGS__", JSON.stringify(strings))}`);

// ── The lambdas: they only read. ──
const SETTINGS = ["folderName", "mirrorBackupRetention", "uploadUnencrypted", "pullDocuments"];
const fn = (name: string, file: string, what: string, zeff: string[], extra: Record<string, unknown> = {}) => {
  write(`lambdas/${name}/lambda.json`, json({ name, label: `Google Drive: ${what.split(":")[0]}`, what, kind: "function", zeff, timeoutMs: 120000, memoryMb: 256, ...extra }));
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, file), "utf8"));
};
const WEB = { web: ["www.googleapis.com"] };
fn("drive.status", "status.mjs", "the page: what syncs and how (the settings), the folders chosen to read, what Zeff has in Drive.", ["oauth.status", "store.query"], { secrets: SETTINGS });
fn("drive.folders", "folders.mjs", "the folders in a folder of your Drive (My Drive: root), where you are and the way up — to choose from.", ["oauth.token"], WEB);
fn("drive.plan-folders", "plan-folders.mjs", "Zeff's folder in Drive and its Backups or Documents folder: which are there and which the flow has to make.", ["oauth.token", "oauth.status", "store.query"], { ...WEB, secrets: ["folderName"] });
fn("drive.backup-plan", "backup-plan.mjs", "backups to Drive: which go up (encrypted ones, unless you allow others) and which the retention removed that go from Drive too.", ["backup.files", "oauth.status", "store.query"], { secrets: SETTINGS });
fn("drive.docs-plan", "docs-plan.mjs", "documents and Drive: which documents go up, which files of Drive's folders come in.", ["documents.list", "oauth.token", "oauth.status", "store.query", "pref.get"], { ...WEB, secrets: SETTINGS });
fn("drive.report", "report.mjs", "what a sync says when it is done.", []);

// ── The flows: what changes Drive or Zeff. ──
const act = (id: string, action: string, input: Record<string, unknown>, extra: Record<string, unknown> = {}) => ({ id, kind: "action", action, input, ...extra });
const iff = (id: string, when: string, then: unknown[], otherwise: unknown[] = []) => ({ id, kind: "if", when, then, else: otherwise });
const REQUESTED = { web: ["www.googleapis.com"], oauth: [CONN], store: STORES };
const UPLOAD = `${API}/upload/drive/v3/files?uploadType=resumable&fields=${FIELDS}`;
const make = (id: string, name: string, extra: Record<string, unknown>) => act(id, "oauth.fetch", { connection: CONN, url: `${API}/drive/v3/files?fields=id`, method: "POST", json: { name, mimeType: FOLDER_MIME, ...extra } });

const folderFlow = {
  name: "google-drive.folder",
  title: "Zeff's folder in Drive",
  description: "Zeff's folder in your Drive and its Backups or Documents folder inside: the ones that are there are kept, the ones that aren't (or were deleted) are made. Another Google account or another folder name: what was recorded for the old one is forgotten.",
  inputs: [{ name: "kind", type: "text" }],
  nodes: [
    act("plan", "lambda.invoke", { name: "drive.plan-folders", event: { kind: "{{ input.kind }}" } }),
    iff("reset", "{{ steps.plan.reset }}", [
      act("rb", "store.delete", { store: STORES[0], where: { kind: "backup" } }),
      act("rd", "store.delete", { store: STORES[0], where: { kind: "document" } }),
      act("rs", "store.put", { store: STORES[1], rows: [{ id: "main", root_id: "", backups_id: "", documents_id: "" }] }),
    ]),
    { id: "ids", kind: "set", vars: { rootId: "{{ steps.plan.rootId }}", kindId: "{{ steps.plan.kindId }}" } },
    iff("mkroot", "{{ not vars.rootId }}", [make("makeroot", "{{ steps.plan.rootName }}", {}), { id: "setroot", kind: "set", vars: { rootId: "{{ steps.makeroot.json.id }}" } }]),
    iff("mkkind", "{{ not vars.kindId }}", [make("makekind", "{{ steps.plan.kindName }}", { parents: ["{{ vars.rootId }}"] }), { id: "setkind", kind: "set", vars: { kindId: "{{ steps.makekind.json.id }}" } }]),
    iff(
      "keep",
      "{{ input.kind == 'backups' }}",
      [act("putb", "store.put", { store: STORES[1], rows: [{ id: "main", root_id: "{{ vars.rootId }}", backups_id: "{{ vars.kindId }}", folder_name: "{{ steps.plan.folderName }}", email: "{{ steps.plan.email }}" }] })],
      [act("putd", "store.put", { store: STORES[1], rows: [{ id: "main", root_id: "{{ vars.rootId }}", documents_id: "{{ vars.kindId }}", folder_name: "{{ steps.plan.folderName }}", email: "{{ steps.plan.email }}" }] })],
    ),
    { id: "done", kind: "return", value: { folderId: "{{ vars.kindId }}" } },
  ],
  requested: REQUESTED,
  triggers: [{ kind: "manual" }],
};

const version = "{{ steps.up.json.md5Checksum | default(steps.up.json.modifiedTime) | default('') }}";
const backupsFlow = {
  name: "google-drive.sync-backups",
  title: "Backups → Google Drive",
  description: "Copies each backup to Drive (encrypted ones only, unless you allow others there); what the retention removes here goes from Drive too, if set. Only files Zeff recorded as its own are ever removed.",
  inputs: [],
  nodes: [
    act("plan", "lambda.invoke", { name: "drive.backup-plan", event: {} }),
    iff("folder", "{{ steps.plan.needsFolder }}", [{ id: "fo", kind: "call", flow: "google-drive.folder", input: { kind: "backups" } }]),
    {
      id: "ups",
      kind: "foreach",
      items: "{{ steps.plan.uploads }}",
      as: "f",
      max: 5000,
      nodes: [
        // (the first upload that fails ends the sync, as the built-in's did)
        iff("go", "{{ not vars.stop }}", [
          act("up", "oauth.upload", { connection: CONN, start: { url: UPLOAD, json: { name: "{{ f.name }}", parents: ["{{ steps.fo.folderId }}"] } }, source: { kind: "backup", name: "{{ f.name }}" }, mime: "application/zip" }, { onError: "continue" }),
          iff("rec", "{{ steps.up.json }}", [act("put", "store.put", { store: STORES[0], rows: [{ kind: "backup", key: "{{ f.name }}", drive_id: "{{ steps.up.json.id }}", version, size: "{{ f.size }}", origin: "push", synced_at: "{{ steps.plan.at }}" }] })]),
          { id: "mark", kind: "set", vars: { stop: "{{ steps.up.error }}", error: "{{ steps.up.error }}" } },
        ]),
      ],
    },
    {
      id: "rm",
      kind: "foreach",
      items: "{{ steps.plan.removes }}",
      as: "r",
      max: 5000,
      nodes: [act("del", "oauth.fetch", { connection: CONN, url: `${API}/drive/v3/files/{{ r.driveId }}`, method: "DELETE", okStatus: [404] }), act("forget", "store.delete", { store: STORES[0], where: { drive_id: "{{ r.driveId }}" } })],
    },
    act("report", "lambda.invoke", { name: "drive.report", event: { kind: "backups", plan: "{{ steps.plan }}", ups: "{{ steps.ups }}", removed: "{{ steps.rm }}" } }),
    { id: "done", kind: "return", value: { ok: "{{ steps.report.ok }}", message: "{{ steps.report.message }}" } },
  ],
  requested: REQUESTED,
  sync: { label: "Backups → Google Drive", what: "Your backups copied to Google Drive — each one at once when it is made; this catches up what was missed.", replaces: "drivebackup" },
  triggers: [{ kind: "manual" }],
};

const documentsFlow = {
  name: "google-drive.sync-documents",
  title: "Documents ↔ Google Drive",
  description: "Every document goes up to Zeff's Documents folder in Drive; files you add there (when set) and to the folders you chose come in. Nothing is ever removed on one side because it went on the other.",
  inputs: [],
  nodes: [
    { id: "fo", kind: "call", flow: "google-drive.folder", input: { kind: "documents" } },
    act("plan", "lambda.invoke", { name: "drive.docs-plan", event: { folderId: "{{ steps.fo.folderId }}" } }),
    act("seed", "store.put", { store: STORES[2], rows: "{{ steps.plan.seedFolders }}" }),
    { id: "skips", kind: "foreach", items: "{{ steps.plan.tooLarge }}", as: "s", max: 100, nodes: [act("skip", "store.put", { store: STORES[0], rows: [{ kind: "document", key: "skipped", drive_id: "{{ s.driveId }}", version: "{{ s.version }}", size: "{{ s.size }}", origin: "pull", synced_at: "{{ steps.plan.at }}" }] })] },
    {
      id: "ups",
      kind: "foreach",
      items: "{{ steps.plan.uploads }}",
      as: "d",
      max: 5000,
      nodes: [
        act("up", "oauth.upload", { connection: CONN, start: { url: UPLOAD, json: { name: "{{ d.name }}", parents: ["{{ steps.fo.folderId }}"] } }, source: { kind: "document", id: "{{ d.id }}" }, mime: "{{ d.mime }}" }, { onError: "continue" }),
        iff("rec", "{{ steps.up.json }}", [act("put", "store.put", { store: STORES[0], rows: [{ kind: "document", key: "{{ d.key }}", drive_id: "{{ steps.up.json.id }}", version, size: "{{ d.size }}", origin: "push", synced_at: "{{ steps.plan.at }}" }] })]),
        { id: "mark", kind: "set", vars: { error: "{{ steps.up.error }}" } },
      ],
    },
    {
      id: "pulls",
      kind: "foreach",
      items: "{{ steps.plan.pulls }}",
      as: "p",
      max: 100,
      nodes: [
        act("dl", "oauth.download", { connection: CONN, url: "{{ p.url }}", name: "{{ p.name }}", mime: "{{ p.mime }}" }, { onError: "continue" }),
        iff(
          "rec",
          "{{ steps.dl.id }}",
          [act("put", "store.put", { store: STORES[0], rows: [{ kind: "document", key: "doc:{{ steps.dl.id }}", drive_id: "{{ p.driveId }}", version: "{{ p.version }}", size: "{{ steps.dl.size }}", origin: "pull", synced_at: "{{ steps.plan.at }}" }] })],
          // (remembered as it is: not tried again until it changes in Drive)
          [act("miss", "store.put", { store: STORES[0], rows: [{ kind: "document", key: "skipped", drive_id: "{{ p.driveId }}", version: "{{ p.version }}", size: 0, origin: "pull", synced_at: "{{ steps.plan.at }}" }] })],
        ),
        { id: "mark", kind: "set", vars: { error: "{{ steps.dl.error }}" } },
      ],
    },
    act("report", "lambda.invoke", { name: "drive.report", event: { kind: "documents", plan: "{{ steps.plan }}", ups: "{{ steps.ups }}", pulls: "{{ steps.pulls }}" } }),
    { id: "done", kind: "return", value: { ok: "{{ steps.report.ok }}", message: "{{ steps.report.message }}" } },
  ],
  requested: REQUESTED,
  sync: { label: "Documents ↔ Google Drive", what: "Your documents copied to Google Drive (and, if you set so, what you add there brought in).", replaces: "drivedocs" },
  triggers: [{ kind: "manual" }, { kind: "schedule", everyMinutes: 15 }],
};

const addFolderFlow = {
  name: "google-drive.add-folder",
  title: "Read a folder of your Drive",
  description: "A folder of your Drive chosen: what you put there comes into the documents with the next sync (read only — Zeff never writes or deletes there).",
  inputs: [{ name: "id", type: "text" }, { name: "path", type: "text" }],
  nodes: [act("put", "store.put", { store: STORES[2], rows: [{ id: "{{ input.id }}", path: "{{ input.path }}" }] }), { id: "done", kind: "return", value: { ok: true } }],
  requested: { store: [STORES[2]] },
  triggers: [{ kind: "manual" }],
};
const removeFolderFlow = {
  name: "google-drive.remove-folder",
  title: "Stop reading a folder of your Drive",
  description: "A folder of your Drive no longer read — what came in from it stays in the documents.",
  inputs: [{ name: "id", type: "text" }],
  nodes: [act("del", "store.delete", { store: STORES[2], where: { id: "{{ input.id }}" } }), { id: "done", kind: "return", value: { ok: true } }],
  requested: { store: [STORES[2]] },
  triggers: [{ kind: "manual" }],
};

// ── The package: the page (a block) and its flows. ──
const view = fs.readFileSync(path.join(SRC, "view.html"), "utf8");
const emptyDoc = { type: "doc", content: [{ type: "paragraph" }] };
const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
const flowPage = (id: string, parent: string, flow: { name: string; title: string }) => ({ id, parent, kind: "page", title: flow.title, icon: "☁️", content: emptyDoc, flow });
write(
  "google-drive.package.json",
  json({
    format: 1,
    id: "google-drive-ext",
    version: old.version ?? "1.0.0",
    name: "Google Drive",
    description: "Google Drive's page: your OAuth client, signing in, what syncs, the folders you read — and its syncs, as flows.",
    icon: "☁️",
    localize: true,
    items: [
      { id: "i1", kind: "page", title: "Google Drive", icon: "☁️", content: { type: "doc", content: [{ type: "zeffBlock", attrs: { block: "google-drive.page", params: "{}" } }] } },
      flowPage("i2", "i1", documentsFlow),
      flowPage("i3", "i1", backupsFlow),
      flowPage("i4", "i1", folderFlow),
      flowPage("i5", "i1", addFolderFlow),
      flowPage("i6", "i1", removeFolderFlow),
    ],
    blocks: [{ def: { name: "google-drive.page", title: "Google Drive", description: "Google Drive's page: your OAuth client, signing in, what syncs and the folders of your Drive that come into the documents.", icon: "☁️", params: [], template: view } }],
  }),
);

// ── The manifest. ──
const col = (name: string, type: "text" | "integer" = "text") => ({ name, type });
write(
  "zeff-plugin.json",
  json({
    $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
    id: "google-drive-ext",
    name: "Google Drive",
    version: old.version ?? "1.0.0",
    description: "Keeps a copy of your documents in your Google Drive — and, if you turn it on, of your backups. Files you add to Zeff's Documents folder in Drive can come into Zeff too. Signs in with an OAuth client of your own: by default Zeff only sees the files it puts in Drive itself.",
    author: "Zeff",
    apiVersion: 1,
    permissions: [],
    contributes: {
      lambdas: "lambdas",
      workspacePackages: ["google-drive.package.json"],
      settings: [
        { key: "clientId", label: "OAuth client ID", kind: "text", required: true, help: "From your Google Cloud project: Credentials → OAuth client ID (Web application). Looks like 123456-abc….apps.googleusercontent.com." },
        { key: "clientSecret", label: "OAuth client secret", kind: "secret", required: true, help: "Its secret — kept encrypted, never shown again. Leave empty to keep the one saved." },
        { key: "folderName", label: "Folder in Drive", kind: "text", help: "Zeff's folder in your Drive. Empty: “Zeff”. Another name: made (or found) at the next sync." },
        { key: "mirrorBackupRetention", label: "Backups: what the retention removes goes from Drive too", kind: "checkbox", default: true },
        { key: "uploadUnencrypted", label: "Backups: also those without a password", kind: "checkbox", default: false, help: "A backup without a password is the whole database, readable by anyone with the file." },
        { key: "pullDocuments", label: "Documents: files you add to Zeff's Drive folder come in", kind: "checkbox", default: false, help: "Needs access to all of Drive: connect again after switching it on." },
      ],
      oauth: [
        {
          id: "drive",
          label: "Google Drive",
          authUrl: "https://accounts.google.com/o/oauth2/v2/auth",
          tokenUrl: "https://oauth2.googleapis.com/token",
          // (who you are, to show it, and only the files Zeff makes — all of Drive when it should also read what you add: connect "with" full)
          scopes: ["openid", "email", "https://www.googleapis.com/auth/drive.file"],
          scopeSets: { full: ["openid", "email", "https://www.googleapis.com/auth/drive"] },
          clientId: "clientId",
          clientSecret: "clientSecret",
          authParams: { access_type: "offline", prompt: "consent select_account" },
          identity: "id_token",
        },
      ],
      stores: [
        // (what Zeff recorded as its own in Drive: the built-in's table, adopted — nothing goes up twice, nothing is removed that isn't Zeff's)
        { name: "files", adopts: "google_drive_files", key: "drive_id", columns: [col("kind"), col("key"), col("drive_id"), col("version"), col("size", "integer"), col("origin"), col("synced_at")], indexes: [["kind", "key"]] },
        { name: "state", key: "id", columns: [col("id"), col("root_id"), col("backups_id"), col("documents_id"), col("folder_name"), col("email")] },
        { name: "pullfolders", key: "id", columns: [col("id"), col("path")] },
      ],
    },
  }),
);

write(
  "README.md",
  `# Google Drive (google-drive-ext)

The port of Zeff's built-in Google Drive. Generated by Zeff's \`scripts/port-google-drive.mts\` — change the generator and generate it again.

- **Signing in**: \`contributes.oauth\` — Zeff's generic sign-in for plugins. The OAuth client (id and secret) is this plugin's settings (⚙️ on
  its card); the kernel serves \`/api/ext/oauth/google-drive-ext/drive/connect\` and \`/callback\` (register the callback as the client's redirect
  address — the page shows it), keeps the tokens encrypted and refreshes them. A sign-in the built-in already had is taken over once.
- **Reading Drive**: lambdas (\`drive.*\`) — they only read: the folders, what is in them, and the *plan* of each sync (what goes up, what comes in).
- **Changing Drive and Zeff**: flows — \`google-drive.sync-documents\` (Documents ↔ Drive, in the place of the sync step *drivedocs*),
  \`google-drive.sync-backups\` (Backups → Drive, in the place of *drivebackup*), \`google-drive.folder\` (Zeff's folder and its Backups / Documents
  folder), \`add-folder\` / \`remove-folder\` (the folders of your Drive that come into the documents).
- **What Zeff recorded as its own in Drive** is the built-in's table \`google_drive_files\`, adopted: nothing goes up twice through the switch.
- **The switch** (*Switch to the plugin* on Google Drive's card): this plugin on, its package installed, the built-in off.
`,
);
console.log(`${dir}: written`);
