/**
 * Finances' port, slice 1 — its debt Kennzahlen (zeff-plugins/plugins/finances-ext): the numbers of src/plugins/finances/metrics.ts that come
 * from the debts database — what you owe, what you are owed, the instalments, when you are debt-free, what has no plan — worked out by the
 * lambda `finances.metric` with the built-in's own pure core (src/plugins/finances/plans.ts: schedule, summarize — bundled, the same plans) from
 * the debts database's cells (the kernel's `db.cells`, read by the fields' ids). Each Kennzahl is a metric of the plugin answered by that
 * lambda with fixed arguments (contributes.metrics: lambda + args).
 *
 * Not in this slice (still the built-in's, so Finances isn't switchable yet): the income and spending Kennzahlen (they read the bank statements),
 * the formula functions (Schulden(@Person) …: people and circles), the widgets, the overviews and the debts database's own rows.
 *
 *   npx tsx scripts/port-finances.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { swapPlugin } from "./lib/swap-reads.mts";
import { build } from "esbuild";
import { debtsViewTemplate } from "./port-finances/debts-view.mjs";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "finances-ext");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

const KEYS = [
  "From {incomes} incomes, {subscriptions} subscriptions, {contracts} other contracts and {payments} debts",
  "in {in} · out {out}",
  "Nothing known ahead yet — no bank bookings, contracts or debts.",
  "Net a month",
  "Write your balance today in the widget's settings for the weeks ahead and the day it runs low.",
  "Below zero on {date}",
  "Below {buffer} on {date}",
  "{amount} then · in {n} days",
  "Stays above {amount}",
  "lowest {amount} on {date}",
  "Income",
  "I owe",
  "No metrics yet — Workspace → Metrics.",
  "{n} of {running} running, {amount} a month",
  "Every subscription is in your contracts.",
  "No recurring payments in your bank bookings.",
  "Add to {db}",
  "next {date}",
  "last {date}",
  "{amount} a month",
  "Contracts",
  "There is no contracts database yet (Workspace → templates → Contracts).",
  "This payment isn't recurring any more.",
  "Monthly",
  "Quarterly",
  "Yearly",
  "{n} d overdue", "today", "tomorrow", "in {n} d", "No payments due.", "Nothing comes back in these days.", "Creditors overview", "Debtors overview"];
for (const m of fs.readFileSync(path.join(ROOT, "src", "plugins", "finances", "view-data.ts"), "utf8").matchAll(/\bt\(\s*"((?:[^"\\]|\\.)*)"/g)) {
  const k = JSON.parse('"' + m[1] + '"');
  if (!KEYS.includes(k)) KEYS.push(k);
}
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const file = path.join(repo, "plugins", `lang-${lang}`, "bundle.json");
  const pack = fs.existsSync(file) ? (JSON.parse(fs.readFileSync(file, "utf8")) as Record<string, string>) : {};
  strings[lang] = Object.fromEntries(KEYS.filter((k) => pack[k]).map((k) => [k, pack[k]]));
}
const lib = await build({
  stdin: { contents: `import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";\nconst STRINGS = ${JSON.stringify(strings)};\nsetPluginStrings((lang) => STRINGS[lang] ?? {});\nexport const tFor = (lang) => translator(isLang(lang) ? lang : "en");\nexport { schedule, summarize } from "@/plugins/finances/plans";\nexport { DEBT } from "@/plugins/finances/fields";\nexport { movedOnly, recurringFlows, matchContracts, cashflowFlows, forecast } from "@/plugins/finances/insights";\nexport { detectRecurring, STRICT } from "@/plugins/finances/recurring";\nexport { classifyNoise } from "@/lib/noise";\nexport { caseFromRow, standingOf, paymentOf } from "@/plugins/cases/core";\nexport { debtsAppData } from "@/plugins/finances/view-data";\nexport { caseTitle } from "@/plugins/cases/shared";
export { amountIn } from "@/lib/girocode";\nexport { CONTRACT } from "@/plugins/workspace/contract-fields";\nexport { recipientKey } from "@/plugins/finances/recurring";`, resolveDir: ROOT, loader: "ts", sourcefile: "finances-port.ts" },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
write("lambdas/_lib.mjs", `// Generated by Zeff's scripts/port-finances.mts from the built-in Finances' pure core (src/plugins/finances/plans.ts, fields.ts) — change the core, generate again.\n${lib.outputFiles[0].text}`);

write(
  "lambdas/finances.metric/index.mjs",
  `import { DEBT, schedule, summarize, movedOnly, recipientKey } from "./lib.mjs";

const num = (v) => (typeof v === "number" && Number.isFinite(v) ? v : null);
const dayOf = (v) => (typeof v === "string" && /^\\\d{4}-\\\d{2}-\\\d{2}/.test(v) ? v.slice(0, 10) : v && typeof v === "object" && "start" in v ? String(v.start).slice(0, 10) : null);
/** Months from now to a day (whole, rounded up) — null without one. */
const monthsUntil = (iso) => {
  if (!iso) return null;
  const a = new Date();
  const b = new Date(iso);
  return Math.max(0, (b.getFullYear() - a.getFullYear()) * 12 + (b.getMonth() - a.getMonth()) + (b.getDate() > a.getDate() ? 1 : 0));
};

/** The debts of one direction with their plans, as the built-in's debtPlans makes them (what the Kennzahlen need of a debt). */
async function plans(zeff, dir, today) {
  const { debts } = await zeff.call("zeff.places", {});
  if (!debts) return { debts: [], summary: summarize([], today) };
  const { rows } = await zeff.call("db.cells", { db: debts });
  const list = rows.flatMap((r) => {
    const open = num(r.cells[DEBT.open]);
    if (open == null || open <= 0) return [];
    const d = r.cells[DEBT.dir] === "owed" ? "owed" : "owe";
    if (d !== dir) return [];
    const installment = num(r.cells[DEBT.rate]);
    const plan = schedule({ open, installment, nextDue: dayOf(r.cells[DEBT.due]), day: num(r.cells[DEBT.day]) }, today);
    return [{ id: r.id, open, installment, plan }];
  });
  // (the next due first, those without a day last)
  list.sort((a, b) => (a.plan.payments[0]?.date ?? "9999").localeCompare(b.plan.payments[0]?.date ?? "9999"));
  return { debts: list, summary: summarize(list.map((d) => ({ id: d.id, ...d.plan })), today) };
}

const round2 = (n) => Math.round(n * 100) / 100;
/** The last three whole months before a day: from (inclusive), to (exclusive). */
function lastThreeMonths(day) {
  const d = new Date(day + "T00:00:00Z");
  return { from: new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() - 3, 1)).toISOString().slice(0, 10), to: new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1)).toISOString().slice(0, 10) };
}
const pref = async (zeff, key) => (await zeff.call("pref.get", { key })).value;

/** Your monthly income: yours (set by hand), else the average of the last three whole months the knowledge read off your statements. */
async function income(zeff) {
  const manual = await pref(zeff, "cases.income");
  const running = new Date().toISOString().slice(0, 7);
  const facts = ((await pref(zeff, "cases.incomeFacts")) ?? []).filter((f) => f.period < running).sort((a, b) => b.period.localeCompare(a.period)).slice(0, 3);
  const derived = facts.length ? round2(facts.reduce((t, f) => t + f.amount, 0) / facts.length) : null;
  return manual ?? derived;
}

/** What was spent a month: the outgoing bookings of the last three whole months on average, money only moved and your own accounts left out. */
async function spending(zeff, today) {
  const { from, to } = lastThreeMonths(today);
  const { bookings } = await zeff.call("bank.bookings", { from, to });
  if (!bookings.length) return null;
  const marked = (await pref(zeff, "finances.ownAccounts")) ?? {};
  const moved = movedOnly(bookings);
  const out = bookings.filter((b) => b.amount < 0 && !moved.has(recipientKey(b)) && !marked[recipientKey(b)]).reduce((t, b) => t - b.amount, 0);
  return round2(out / 3);
}

/** What went to the recipients marked as credit accounts a month (the last three whole months on average). */
async function creditPayments(zeff, today) {
  const marked = (await pref(zeff, "finances.ownAccounts")) ?? {};
  const credit = new Set(Object.entries(marked).flatMap(([k, v]) => (v === "credit" ? [k] : [])));
  if (!credit.size) return null;
  const { from, to } = lastThreeMonths(today);
  const { bookings } = await zeff.call("bank.bookings", { from, to });
  if (!bookings.length) return null;
  return round2(bookings.filter((b) => b.amount < 0 && credit.has(recipientKey(b))).reduce((t, b) => t - b.amount, 0) / 3);
}

/**
 * One of the Kennzahlen, by event.which — the debt ones: owe-open, owe-count, rates, free-in, owe-unplanned, owed-open, owed-count, owed-rates,
 * owed-free-in, owed-unplanned; the money ones: income, spending, credit, free-monthly, savings-rate, debt-service-rate — the number the
 * built-in's metrics.ts gives (null: none). owe-open, owe-count, rates, free-in, owe-unplanned, owed-open, owed-count, owed-rates,
 * owed-free-in, owed-unplanned — the number the built-in's metrics.ts gives (null: none).
 */
export async function handler(event, context) {
  const today = new Date().toLocaleDateString("sv-SE");
  const which = String(event?.which ?? "");
  const zeff = context.zeff;
  if (["income", "spending", "credit", "free-monthly", "savings-rate", "debt-service-rate"].includes(which)) {
    const rates = () => plans(zeff, "owe", today).then((p) => p.summary.monthlyRates);
    if (which === "income") return await income(zeff);
    if (which === "spending") return await spending(zeff, today);
    if (which === "credit") return await creditPayments(zeff, today);
    if (which === "free-monthly") {
      const i = await income(zeff);
      if (i === null) return null;
      const fixed = (await zeff.call("workspace.value", { type: "fixkosten" })).total;
      return i - (await rates()) - (fixed ?? 0);
    }
    if (which === "savings-rate") {
      const i = await income(zeff);
      const sp = await spending(zeff, today);
      return i && sp !== null ? ((i - sp) / i) * 100 : null;
    }
    const i = await income(zeff);
    return i ? ((await rates()) / i) * 100 : null;
  }
  const dir = which.startsWith("owed-") ? "owed" : "owe";
  const p = await plans(context.zeff, dir, today);
  const open = () => p.debts.reduce((s, d) => s + d.open, 0);
  switch (which) {
    case "owe-open":
    case "owed-open":
      return open();
    case "owe-count":
    case "owed-count":
      return p.debts.length;
    case "rates":
    case "owed-rates":
      return p.summary.monthlyRates;
    case "free-in":
    case "owed-free-in":
      return monthsUntil(p.summary.debtFree);
    case "owe-unplanned":
    case "owed-unplanned":
      return p.summary.unplanned;
    default:
      throw new Error("Unknown Kennzahl " + which);
  }
}
`,
);
write(
  "lambdas/finances.metric/lambda.json",
  JSON.stringify({ name: "finances.metric", label: "Finances: a debt Kennzahl", what: "One of the debt Kennzahlen (event.which): what you owe or are owed, how many debts, the instalments a month, months until debt-free, what has no plan — from the debts database with the built-in's own plans.", kind: "function", zeff: ["zeff.places", "db.cells", "pref.get", "bank.bookings", "workspace.value"], timeoutMs: 30000, memoryMb: 128 }, null, 2) + "\n",
);

write(
  "lambdas/finances.widget-payments/index.mjs",
  `import { DEBT, schedule, tFor } from "./lib.mjs";

const num = (v) => (typeof v === "number" && Number.isFinite(v) ? v : null);
const dayOf = (v) => (typeof v === "string" && /^\\d{4}-\\d{2}-\\d{2}/.test(v) ? v.slice(0, 10) : v && typeof v === "object" && "start" in v ? String(v.start).slice(0, 10) : null);
const euro = (v) => v.toLocaleString(undefined, { style: "currency", currency: "EUR", minimumFractionDigits: 2, maximumFractionDigits: 2 });

/** The widget "Payments coming up": the instalments and payments of your debts (or what comes back to you) in the next weeks, the overdue first. */
export async function handler(event, context) {
  const t = tFor(context.language);
  const config = event?.config ?? {};
  const dir = config.dir === "owed" ? "owed" : "owe";
  const today = new Date().toLocaleDateString("sv-SE");
  const inDays = (day) => Math.round((Date.parse(day.slice(0, 10)) - Date.parse(today)) / 864e5);
  const whenText = (day) => {
    const n = inDays(day);
    return n < 0 ? t("{n} d overdue", { n: -n }) : n === 0 ? t("today") : n === 1 ? t("tomorrow") : t("in {n} d", { n });
  };
  const until = new Date(Date.now() + Number(config.days ?? 45) * 864e5).toLocaleDateString("sv-SE");
  const { debts: db } = await context.zeff.call("zeff.places", {});
  const rows = db ? (await context.zeff.call("db.cells", { db })).rows : [];
  const ids = [...new Set(rows.flatMap((r) => (Array.isArray(r.cells[DEBT.creditor]) && typeof r.cells[DEBT.creditor][0] === "number" ? [r.cells[DEBT.creditor][0]] : [])))];
  const names = ids.length ? (await context.zeff.call("people.names", { ids })).names : {};
  const debts = rows.flatMap((r) => {
    const open = num(r.cells[DEBT.open]);
    if (open == null || open <= 0 || (r.cells[DEBT.dir] === "owed" ? "owed" : "owe") !== dir) return [];
    const caseRef = /^case:(\\d+)$/.exec(String(r.cells.srcref ?? ""));
    const creditorId = Array.isArray(r.cells[DEBT.creditor]) && typeof r.cells[DEBT.creditor][0] === "number" ? r.cells[DEBT.creditor][0] : null;
    const plan = schedule({ open, installment: num(r.cells[DEBT.rate]), nextDue: dayOf(r.cells[DEBT.due]), day: num(r.cells[DEBT.day]) }, today);
    return [{ id: r.id, title: r.title, label: caseRef ? String(r.cells[DEBT.case] ?? "") : "", creditor: (creditorId && names[creditorId]) || r.title || "—", plan }];
  });
  debts.sort((a, b) => (a.plan.payments[0]?.date ?? "9999").localeCompare(b.plan.payments[0]?.date ?? "9999"));
  const all = debts.flatMap((d) => d.plan.payments.filter((p) => p.date <= until).map((p) => ({ d, p }))).sort((a, b) => a.p.date.localeCompare(b.p.date));
  const items = all.slice(0, Number(config.limit ?? 8)).map(({ d, p }) => ({
    id: d.id + ":" + p.date,
    icon: "💶",
    text: d.creditor + " · " + euro(p.amount),
    detail: [d.label ? "Az. " + d.label : "", d.title && d.title !== d.creditor ? d.title : ""].filter(Boolean).join(" · ") || undefined,
    meta: whenText(p.date),
    tone: inDays(p.date) < 0 ? "bad" : inDays(p.date) <= 3 ? "warn" : undefined,
    href: db ? "/workspace/" + db + "?row=" + d.id : undefined,
  }));
  return {
    kind: "list",
    items,
    count: all.length || undefined,
    empty: dir === "owe" ? t("No payments due.") : t("Nothing comes back in these days."),
    ...(db ? { footer: { text: dir === "owe" ? t("Creditors overview") : t("Debtors overview"), href: "/workspace/" + db } } : {}),
  };
}
`,
);
write(
  "lambdas/finances.widget-payments/lambda.json",
  JSON.stringify({ name: "finances.widget-payments", label: "Finances: the payments coming up", what: "The widget's list: the instalments and payments of your debts (or what comes back to you) in the next weeks, the overdue first.", kind: "function", zeff: ["zeff.places", "db.cells", "people.names"], timeoutMs: 30000, memoryMb: 128 }, null, 2) + "\n",
);

write(
  "lambdas/finances.widget-cashflow/index.mjs",
  `import { DEBT, schedule, tFor, recurringFlows, matchContracts, cashflowFlows, forecast } from "./lib.mjs";

const num = (v) => (typeof v === "number" && Number.isFinite(v) ? v : null);
const dayOf = (v) => (typeof v === "string" && /^\\d{4}-\\d{2}-\\d{2}/.test(v) ? v.slice(0, 10) : v && typeof v === "object" && "start" in v ? String(v.start).slice(0, 10) : null);
const euro = (v) => v.toLocaleString(undefined, { style: "currency", currency: "EUR", minimumFractionDigits: 0, maximumFractionDigits: 0 });
const shortDay = (iso) => new Date(iso.slice(0, 10) + "T12:00:00").toLocaleDateString(undefined, { day: "numeric", month: "short" });
const monthYear = (iso) => new Date(iso.slice(0, 7) + "-15T12:00:00").toLocaleDateString(undefined, { month: "long", year: "numeric" });
/** "1.234,56" or "-80" as you type it (empty, or no number: null). */
const typedAmount = (v) => {
  const s = String(v ?? "").replace(/[€\\s]/g, "");
  const n = Number(/,\\d{1,2}$/.test(s) ? s.replace(/\\./g, "").replace(",", ".") : s.replace(/,/g, ""));
  return s && Number.isFinite(n) ? n : null;
};
const addDays = (day, n) => new Date(Date.parse(day + "T12:00:00Z") + n * 864e5).toISOString().slice(0, 10);

/** The rows of the databases publishing "Fixkosten", each with its cost a month, whether it runs, its customer number. */
async function contractRows(zeff) {
  const { sources } = await zeff.call("workspace.value-sources", { type: "fixkosten" });
  const seen = new Set();
  return sources.flatMap((src) => {
    if (seen.has(src.dbId)) return [];
    seen.add(src.dbId);
    const cust = src.properties.find((p) => p.type === "text" && /kunden|customer|vertragsnummer|contract no/i.test(p.name));
    return src.rows.map((r) => {
      const v = r.cells[src.propId];
      const running = src.running[String(r.id)];
      return { id: r.id, dbId: src.dbId, title: r.title, monthly: running ?? (typeof v === "number" && Number.isFinite(v) ? v : null), srcref: String(r.cells.srcref ?? ""), customer: cust ? String(r.cells[cust.id] ?? "") : "", running: running !== undefined };
    });
  });
}

/** The widget "Cashflow ahead": your account in the next weeks — what comes in regularly, the fixed costs, subscriptions, instalments and payments. */
export async function handler(event, context) {
  const t = tFor(context.language);
  const zeff = context.zeff;
  const config = event?.config ?? {};
  const day = new Date().toLocaleDateString("sv-SE");
  const inDays = (d) => Math.round((Date.parse(d.slice(0, 10)) - Date.parse(day)) / 864e5);
  const start = typedAmount(config.balance);
  const buffer = Number(config.buffer ?? 0) || 0;
  const days = Number(config.days ?? 90);

  const { bookings } = await zeff.call("bank.bookings", { from: addDays(day, -800), to: "9999-12-31" });
  const flowing = recurringFlows(bookings, day);
  const marked = (await zeff.call("pref.get", { key: "finances.ownAccounts" })).value ?? {};
  const { debts: db } = await zeff.call("zeff.places", {});
  const rows = db ? (await zeff.call("db.cells", { db })).rows : [];
  const ids = [...new Set(rows.flatMap((r) => (Array.isArray(r.cells[DEBT.creditor]) && typeof r.cells[DEBT.creditor][0] === "number" ? [r.cells[DEBT.creditor][0]] : [])))];
  const names = ids.length ? (await zeff.call("people.names", { ids })).names : {};
  const payments = rows.flatMap((r) => {
    const open = num(r.cells[DEBT.open]);
    if (open == null || open <= 0) return [];
    const dir = r.cells[DEBT.dir] === "owed" ? "owed" : "owe";
    const creditorId = Array.isArray(r.cells[DEBT.creditor]) && typeof r.cells[DEBT.creditor][0] === "number" ? r.cells[DEBT.creditor][0] : null;
    const plan = schedule({ open, installment: num(r.cells[DEBT.rate]), nextDue: dayOf(r.cells[DEBT.due]), day: num(r.cells[DEBT.day]) }, day);
    return plan.payments.map((p) => ({ date: p.date, amount: p.amount, label: (creditorId && names[creditorId]) || r.title || "—", dir }));
  });
  const manual = (await zeff.call("pref.get", { key: "cases.income" })).value;
  const facts = ((await zeff.call("pref.get", { key: "cases.incomeFacts" })).value ?? []).filter((f) => f.period < day.slice(0, 7)).sort((a, b) => b.period.localeCompare(a.period)).slice(0, 3);
  const derived = facts.length ? Math.round((facts.reduce((x, f) => x + f.amount, 0) / facts.length) * 100) / 100 : null;
  const income = manual ?? derived;
  const flows = cashflowFlows({ incomes: flowing.in, outgoings: flowing.out.filter((r) => !marked[r.key]), contracts: await contractRows(zeff), payments, income: income ? { amount: income, label: t("Income") } : null }, day, days);
  const count = (k) => new Set(flows.filter((f) => f.kind === k).map((f) => f.label)).size;
  const f = forecast(flows, { today: day, days, start, buffer });
  const i = { incomes: count("income"), subscriptions: count("subscription"), contracts: count("contract"), payments: count("debt") + count("claim") };

  const title = t("From {incomes} incomes, {subscriptions} subscriptions, {contracts} other contracts and {payments} debts", i);
  const months = f.months.map((m) => ({ id: m.month, icon: "🗓️", text: monthYear(m.month), detail: t("in {in} · out {out}", { in: euro(m.in), out: euro(m.out) }), badge: euro(m.net), tone: m.net < 0 ? "bad" : "good" }));
  if (!i.incomes && !i.subscriptions && !i.contracts && !i.payments) return { kind: "list", items: [], empty: t("Nothing known ahead yet — no bank bookings, contracts or debts.") };
  if (f.start == null) return { kind: "list", title, items: [{ id: "hint", icon: "💡", text: t("Net a month"), detail: t("Write your balance today in the widget's settings for the weeks ahead and the day it runs low."), wrap: true }, ...months] };
  const low = f.firstBelowBuffer;
  const verdict = low
    ? {
        text: f.firstNegative && f.firstNegative.date === low.date ? t("Below zero on {date}", { date: shortDay(low.date) }) : t("Below {buffer} on {date}", { buffer: euro(buffer), date: shortDay(low.date) }),
        detail: t("{amount} then · in {n} days", { amount: euro(low.balance), n: inDays(low.date) }),
        tone: f.firstNegative ? "bad" : "warn",
      }
    : { text: t("Stays above {amount}", { amount: euro(buffer) }), detail: f.lowest ? t("lowest {amount} on {date}", { amount: euro(f.lowest.balance), date: shortDay(f.lowest.date) }) : undefined, tone: "good" };
  const weeks = {
    id: "weeks",
    icon: low ? "⚠️" : "📈",
    ...verdict,
    badge: euro(f.start) + " → " + euro(f.end ?? f.start),
    mini: { bars: f.weeks.map((w) => ({ label: shortDay(w.to), value: Math.round(w.balance ?? 0), tone: (w.balance ?? 0) < 0 ? "bad" : (w.balance ?? 0) < buffer ? "warn" : undefined })), unit: "€" },
  };
  return { kind: "list", title, items: [weeks, ...months] };
}
`,
);
write(
  "lambdas/finances.widget-cashflow/lambda.json",
  JSON.stringify({ name: "finances.widget-cashflow", label: "Finances: the cashflow ahead", what: "The widget's list: your account in the next weeks — what comes in regularly, the fixed costs, subscriptions, instalments and payments — the balance week by week and the first day it drops below zero (or your buffer).", kind: "function", zeff: ["zeff.places", "db.cells", "people.names", "pref.get", "bank.bookings", "workspace.value-sources"], timeoutMs: 60000, memoryMb: 256 }, null, 2) + "\n",
);

write(
  "lambdas/finances.recurring/index.mjs",
  `import { classifyNoise, CONTRACT, detectRecurring, movedOnly, STRICT, tFor } from "./lib.mjs";

const addDays = (day, n) => new Date(Date.parse(day + "T12:00:00Z") + n * 864e5).toISOString().slice(0, 10);

/**
 * The recurring payments as records (the source "recurring"): each running contract or subscription your statements show — what it costs a payment
 * and a month, its rhythm, when last paid and next; the figures the bank's (locked). The built-in's recurringRecords, rule for rule.
 */
export async function handler(_event, context) {
  const t = tFor(context.language);
  const zeff = context.zeff;
  const today = new Date().toLocaleDateString("sv-SE");
  const { bookings } = await zeff.call("bank.bookings", { from: addDays(today, -800), to: "9999-12-31" });
  if (!bookings.length) return [];
  // What is no contract: money only moved, the bank's pocket moves by their words, and money to a person you know (an organisation can be a contract).
  const moved = movedOnly(bookings);
  const { people } = await zeff.call("people.list", {});
  const persons = new Set(people.filter((p) => p.kind !== "organization").map((p) => p.id));
  const ibans = [...new Set(bookings.filter((b) => b.person_id == null && b.iban).map((b) => b.iban))];
  const byIban = ibans.length ? (await zeff.call("people.by-iban", { ibans })).ids : {};
  const toPerson = (b) => {
    const id = b.person_id ?? byIban[b.iban] ?? null;
    return id !== null && persons.has(id);
  };
  const rows = bookings.filter((b) => b.amount < 0 && classifyNoise({ type: "bank", text: b.text, counterparty: b.counterparty }).kind !== "pocket" && !toPerson(b));
  const label = { monthly: t("Monthly"), quarterly: t("Quarterly"), yearly: t("Yearly") };
  // An account you marked as yours is no contract.
  const marked = (await zeff.call("pref.get", { key: "finances.ownAccounts" })).value ?? {};
  const own = new Set([...Object.keys(marked), ...moved]);
  return detectRecurring(rows, today, STRICT)
    .filter((r) => r.active && !classifyNoise({ type: "bank", key: r.key }, { own }).kind)
    .map((r) => ({
      ref: "recurring:" + r.key,
      title: r.name,
      fields: {},
      updatedAt: r.last,
      typed: [
        { id: CONTRACT.monthly, name: "Per month", type: "number", format: "euro", value: r.monthly },
        { id: CONTRACT.amount, name: "Per payment", type: "number", format: "euro", value: r.amount },
        { id: CONTRACT.rhythm, name: "Rhythm", type: "select", value: label[r.rhythm] },
        { id: CONTRACT.last, name: "Last paid", type: "date", value: r.last },
        { id: CONTRACT.next, name: "Next payment", type: "date", value: r.next },
      ],
    }));
}
`,
);
write(
  "lambdas/finances.recurring/lambda.json",
  JSON.stringify({ name: "finances.recurring", label: "Finances: the recurring payments", what: "The recurring payments of your bank statements as records: each running contract or subscription, what it costs a payment and a month, its rhythm, when last paid and next.", kind: "function", zeff: ["bank.bookings", "people.list", "people.by-iban", "pref.get"], timeoutMs: 60000, memoryMb: 256 }, null, 2) + "\n",
);

write(
  "lambdas/finances.debts/index.mjs",
  `import { DEBT, caseFromRow, caseTitle, standingOf, tFor } from "./lib.mjs";

/** Every row of a store (pages of 500). */
async function all(zeff, store) {
  const out = [];
  for (let offset = 0; ; offset += 500) {
    const { rows, total } = await zeff.call("store.query", { store, limit: 500, offset });
    out.push(...rows);
    if (!rows.length || out.length >= total) return out;
  }
}

/**
 * The cases' debts as records (the source "debts"): a case with money open is a row of the debts database, its figures what its letters say (the
 * payments since counted). The built-in's debtRecords, rule for rule.
 */
export async function handler(_event, context) {
  const t = tFor(context.language);
  const zeff = context.zeff;
  const cases = (await all(zeff, "finances-ext.cases"))
    .map(caseFromRow)
    .filter((c) => c.status === "open" && c.compiled && !c.compiled.manual && !c.compiled.done)
    .sort((a, b) => b.lastAt.localeCompare(a.lastAt));
  if (!cases.length) return [];
  const { allocations } = await zeff.call("money.allocations", { refs: cases.map((c) => "case:" + c.id) });
  // The parties (a contact gone: none).
  const parties = await all(zeff, "finances-ext.parties");
  const ids = [...new Set(parties.map((r) => r.person_id).filter(Boolean))];
  const { names } = ids.length ? await zeff.call("people.names", { ids }) : { names: {} };
  const partyOf = (caseId, role) => {
    const r = parties.find((x) => x.case_id === caseId && x.role === role && names[x.person_id]);
    return r ? r.person_id : null;
  };
  return cases.flatMap((c) => {
    const s = c.compiled;
    const open = standingOf(c, allocations["case:" + c.id] ?? []).open ?? s.open;
    if (open == null || open <= 0) return [];
    const creditor = partyOf(c.id, "creditor");
    const collector = partyOf(c.id, "collector");
    return [
      {
        ref: "case:" + c.id,
        title: caseTitle(c),
        fields: {},
        updatedAt: c.updatedAt,
        dataType: "debts",
        typed: [
          { id: DEBT.dir, name: "Direction", type: "select", value: t("I owe") },
          // The case's person is who writes — often who collects it (a bailiff), not whom it is owed to: never taken for the creditor; with no
          // parties known yet it stands as who collects it.
          { id: DEBT.creditor, name: "Other side", type: "person", value: creditor ? [creditor] : [] },
          { id: DEBT.collector, name: "Collected by", type: "person", value: collector ? [collector] : !creditor && c.personId ? [c.personId] : [] },
          { id: DEBT.total, name: "Total", type: "number", format: "euro", value: s.total },
          { id: DEBT.open, name: "Open", type: "number", format: "euro", value: open },
          { id: DEBT.rate, name: "Instalment", type: "number", format: "euro", value: s.installment },
          { id: DEBT.due, name: "Next due", type: "date", value: s.nextDue },
          { id: DEBT.day, name: "Plan's day", type: "number", value: s.installmentDay ?? null },
          { id: DEBT.case, name: "Case number", type: "text", value: c.label },
          { id: DEBT.next, name: "Next", type: "text", value: s.nextWhat },
        ],
      },
    ];
  });
}
`,
);
write(
  "lambdas/finances.debts/lambda.json",
  JSON.stringify({ name: "finances.debts", label: "Finances: the cases' debts", what: "The cases with money open as debts — creditor, who collects it, total, open, instalment, due day — as records of the debts database.", kind: "function", zeff: ["store.query", "money.allocations", "people.names"], timeoutMs: 60000, memoryMb: 256 }, null, 2) + "\n",
);

