/**
 * People's port (zeff-plugins/plugins/people-ext): the AI steps of People as a plugin — what new messages say about the people you keep a profile of (claims, links,
 * promises), a person's summary, which contact is a person or an organisation and in which circle, which names are one person (the step after each briefing,
 * "People matching"). The people model — contacts, claims, links, details, circles, the graph reads — stays the kernel's (the shared entity graph every app reads);
 * the plugin reads it through the kernel's flow actions (people.extract-input, people.compile-input, people.classify-input, people.normalize-input, rag.retrieve …)
 * and its flows write with the kernel's (people.extract-save, people.compile-save, people.classify-save, people.normalize-apply …). The built-in's own pure cores —
 * the instructions, the answers' shapes, the prompts, which findings hold (src/plugins/people/extract-core.ts, compile-core.ts, classify-core.ts, normalize-core.ts,
 * src/lib/rag-ask.ts) — are bundled into the lambdas as they are, so the built-in and the port ask the same.
 *
 *   npx tsx scripts/port-people.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "people-ext");
const SRC = path.join(ROOT, "scripts", "port-people");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

const lib = await build({
  stdin: {
    contents: [
      `export { INSTRUCTIONS as EXTRACT_INSTRUCTIONS, SCHEMA as EXTRACT_SCHEMA, PER_BATCH, MAX_BATCHES, extractBatch, extractPrompt, acceptFindings, withLoopsAddendum } from "@/plugins/people/extract-core";`,
      `export { INSTRUCTIONS as COMPILE_INSTRUCTIONS, SCHEMA as COMPILE_SCHEMA } from "@/plugins/people/compile-core";`,
      `export { INSTRUCTIONS as CLASSIFY_INSTRUCTIONS, SCHEMA as CLASSIFY_SCHEMA, classifyPrompt } from "@/plugins/people/classify-core";`,
      `export { INSTRUCTIONS as NORMALIZE_INSTRUCTIONS, SCHEMA as NORMALIZE_SCHEMA, normalizePrompt } from "@/plugins/people/normalize-core";`,
      `export { RAG_INSTRUCTIONS, askWithRetrievalWith } from "@/lib/rag-ask";`,
    ].join("\n"),
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "people-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const libText = `// Generated by Zeff's scripts/port-people.mts from the built-in's pure cores (src/plugins/people/*-core.ts, src/lib/rag-ask.ts) — change them there, generate again.\n${lib.outputFiles[0].text}`;

const LAMBDAS: Record<string, { label: string; what: string; zeff: string[]; timeoutMs: number }> = {
  "people.extract": {
    label: "People: what the messages say",
    what: "The AI's reading of the new messages (mail, chats, Teams, Jira comments, letters) about the people you keep a profile of: roles, tasks, facts, preferences, promises, who reports to whom — each with a quote, its source and how sure it is. Every pair of message and person judged.",
    zeff: ["people.extract-input", "zeff.installed", "prompts.fill", "ai.json", "rag.retrieve"],
    timeoutMs: 1800000,
  },
  "people.compile": {
    label: "People: a person's overview",
    what: "A short overview of a person from everything Zeff has on them: what connects you, the key facts, the fun facts — and their circle.",
    zeff: ["people.compile-input", "prompts.fill", "ai.json"],
    timeoutMs: 600000,
  },
  "people.classify": {
    label: "People: person or organisation, and their circle",
    what: "For the contacts not placed yet: a person or an organisation (a bank, an authority, a company) and the circle they belong to (family, friends, work, authorities, services).",
    zeff: ["people.classify-input", "prompts.fill", "ai.json"],
    timeoutMs: 1200000,
  },
  "people.names": {
    label: "People: one identity per person",
    what: "Which names in your todos, chats and mails are one person: aliases, profiles for contacts, duplicates to merge, who is who for whom.",
    zeff: ["people.normalize-input", "prompts.fill", "ai.json"],
    timeoutMs: 600000,
  },
};
for (const [name, l] of Object.entries(LAMBDAS)) {
  write(`lambdas/${name}/lib.mjs`, libText);
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, `${name}.mjs`), "utf8"));
  write(`lambdas/${name}/lambda.json`, JSON.stringify({ name, label: l.label, what: l.what, kind: "function", zeff: l.zeff, timeoutMs: l.timeoutMs, memoryMb: 256 }, null, 2) + "\n");
}

const doc = { type: "doc", content: [{ type: "paragraph" }] };
const REQUEST = { write: "all", ai: true };
const call = (id: string, flow: string, input: Record<string, unknown> = {}) => ({ id, kind: "call", flow, input, onError: "continue" });

write(
  "people.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "people-ext",
      version: "1.0.0",
      name: "People",
      description: "The AI steps of People: what the messages say about people, their overviews, who is a person or an organisation, which names are one person.",
      icon: "👥",
      items: [
        { id: "i1", kind: "page", title: "People", icon: "👥", content: doc },
        {
          id: "i2",
          parent: "i1",
          kind: "page",
          title: "What the messages say",
          icon: "👥",
          content: doc,
          flow: {
            name: "people.extract",
            title: "Read what the messages say about people",
            description: "The messages since the last run that name someone you keep a profile of go to the AI: roles, tasks, facts, preferences, promises, links — kept as proposals for you to confirm. sinceDays: look back that far; only: just these profiles (the marks then stay).",
            inputs: [],
            nodes: [
              { id: "derive", kind: "action", action: "people.derive-links", input: {} },
              { id: "run", kind: "action", action: "lambda.invoke", input: { name: "people.extract", event: { sinceDays: "{{ input.sinceDays }}", only: "{{ input.only }}" } } },
              { id: "keep", kind: "action", action: "people.extract-save", input: { claims: "{{ steps.run.claims }}", links: "{{ steps.run.links }}", marks: "{{ steps.run.marks }}" } },
              { id: "done", kind: "return", value: { items: "{{ steps.run.items }}", claims: "{{ steps.keep.claims }}", links: "{{ steps.keep.links }}", derived: "{{ steps.derive.derived }}", open: "{{ steps.run.open }}" } },
            ],
            requested: REQUEST,
            triggers: [{ kind: "manual" }],
          },
        },
        {
          id: "i3",
          parent: "i1",
          kind: "page",
          title: "A person's overview",
          icon: "👥",
          content: doc,
          flow: {
            name: "people.compile",
            title: "A person's overview",
            description: "The AI's short overview of a person from everything Zeff has on them (what connects you, key facts, fun facts), kept on their profile — one compiled lately is left unless force. Output { state, summary }.",
            inputs: [],
            nodes: [
              { id: "run", kind: "action", action: "lambda.invoke", input: { name: "people.compile", event: { id: "{{ input.id }}", force: "{{ input.force }}" } } },
              {
                id: "keep",
                kind: "if",
                when: "{{ steps.run.answer }}",
                then: [{ id: "save", kind: "action", action: "people.compile-save", input: { id: "{{ input.id }}", answer: "{{ steps.run.answer }}", count: "{{ steps.run.count }}" } }],
                else: [],
              },
              { id: "done", kind: "return", value: { state: "{{ steps.run.state }}", summary: "{{ steps.keep.summary }}" } },
            ],
            requested: REQUEST,
            triggers: [{ kind: "manual" }],
          },
        },
        {
          id: "i4",
          parent: "i1",
          kind: "page",
          title: "Overviews out of date",
          icon: "👥",
          content: doc,
          flow: {
            name: "people.compile-stale",
            title: "Make the overviews that are out of date",
            description: "The contacts whose overview is missing or out of date after the briefing are compiled, one after the other; a failing one doesn't stop the rest.",
            inputs: [],
            nodes: [
              { id: "stale", kind: "action", action: "people.stale", input: {} },
              { id: "each", kind: "foreach", items: "{{ steps.stale.ids }}", as: "id", nodes: [call("one", "people.compile", { id: "{{ id }}" })], max: 200 },
              { id: "done", kind: "return", value: { asked: "{{ steps.stale.ids }}" } },
            ],
            requested: REQUEST,
            triggers: [{ kind: "manual" }],
          },
        },
        {
          id: "i5",
          parent: "i1",
          kind: "page",
          title: "Person or organisation, and circle",
          icon: "👥",
          content: doc,
          flow: {
            name: "people.classify",
            title: "Place the contacts",
            description: "The contacts not placed yet — a person or an organisation, and their circle (family, friends, work, authorities, services) — placed by the AI; what you chose stays. force: all; ids: these.",
            inputs: [],
            nodes: [
              { id: "run", kind: "action", action: "lambda.invoke", input: { name: "people.classify", event: { ids: "{{ input.ids }}", force: "{{ input.force }}" } } },
              { id: "each", kind: "foreach", items: "{{ steps.run.results }}", as: "r", nodes: [{ id: "save", kind: "action", action: "people.classify-save", input: { ids: "{{ r.ids }}", answer: "{{ r.answer }}" } }], max: 100 },
              { id: "done", kind: "return", value: { asked: "{{ steps.run.asked }}" } },
            ],
            requested: REQUEST,
            triggers: [{ kind: "manual" }],
          },
        },
        {
          id: "i6",
          parent: "i1",
          kind: "page",
          title: "People matching",
          icon: "👥",
          content: doc,
          flow: {
            name: "people.normalize",
            title: "People matching",
            description: "After each briefing: the names matched (aliases, profiles for contacts, duplicates merged), what the new messages say read, the promises kept since closed, the contacts placed, the overviews made and the points before your meetings.",
            sync: { label: "People matching", what: "Who is meant by the names in your todos — aliases added, profiles for contacts made, duplicates merged; what the new messages say about people read (after each briefing)", replaces: "peoplenorm" },
            inputs: [],
            nodes: [
              { id: "maintain", kind: "action", action: "people.maintain", input: {} },
              { id: "names", kind: "action", action: "lambda.invoke", input: { name: "people.names", event: {} } },
              { id: "apply", kind: "action", action: "people.normalize-apply", input: { answer: "{{ steps.names.answer }}", chatNames: "{{ steps.names.chatNames }}", addresses: "{{ steps.names.addresses }}" } },
              call("extract", "people.extract"),
              { id: "after", kind: "action", action: "people.after-extraction", input: {} },
              { id: "briefing", kind: "action", action: "people.after-briefing", input: {} },
              call("classify", "people.classify"),
              call("compile", "people.compile-stale"),
              { id: "done", kind: "return", value: { ok: true, message: "{{ steps.apply.aliases }} aliases, {{ steps.apply.created }} new, {{ steps.apply.merged }} merged, {{ steps.apply.relations }} relations" } },
            ],
            requested: REQUEST,
            triggers: [{ kind: "manual" }],
          },
        },
      ],
    },
    null,
    2,
  ) + "\n",
);

const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "people-ext",
      name: "People (AI steps)",
      version: old.version ?? "0.1.0",
      description: "What the AI does with your people: reads what new messages say about them (roles, tasks, promises, links), writes their overview, tells a person from an organisation and places them in a circle, and matches the names. The contacts themselves stay Zeff's.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["people.package.json"],
        aiTasks: [
          { id: "extract", label: "People: what the messages say", what: "Reads new messages for what they say about the people you keep a profile of: roles, tasks, facts, promises, links." },
          { id: "compile", label: "People: a person's overview", what: "Writes a person's short overview from everything Zeff has on them." },
          { id: "classify", label: "People: person or organisation, circle", what: "Places contacts: a person or an organisation, and their circle." },
          { id: "normalize", label: "People: one identity per person", what: "Matches the names in your todos, chats and mails to your profiles." },
        ],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# People — the AI steps (people-ext)

What the AI does with your people, as a plugin. Generated by Zeff's \`scripts/port-people.mts\`.

- The people themselves (contacts, claims, links, details, circles, the graph) are Zeff's own — the shared graph every app reads. This plugin reads them through the kernel's flow actions and its flows write with the kernel's.
- Lambdas: \`people.extract\`, \`people.compile\`, \`people.classify\`, \`people.names\` — the built-in's own instructions, answer shapes and rules, bundled.
- Flows: \`people.extract\`, \`people.compile\`, \`people.compile-stale\`, \`people.classify\` and \`people.normalize\` — the Sync step "People matching" in the place of the built-in's.
- Still the built-in's while this plugin is on: the People screens (the list, a person's page, the circles), the widgets, the formulas, the review sources, the tools, the "Compile" button on a person's page.
`,
);
console.log(`${dir}: People (AI steps)`);
