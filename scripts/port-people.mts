/**
 * People's port (zeff-plugins/plugins/people-ext): the AI steps of People as a plugin — what new messages say about the people you keep a profile of (claims, links,
 * promises), a person's summary, which contact is a person or an organisation and in which circle, which names are one person (the step after each briefing,
 * "People matching"). The people model — contacts, claims, links, details, circles, the graph reads — stays the kernel's (the shared entity graph every app reads);
 * the plugin reads it through the kernel's flow actions (people.extract-input, people.compile-input, people.classify-input, people.normalize-input, rag.retrieve …)
 * and its flows write with the kernel's (people.extract-save, people.compile-save, people.classify-save, people.normalize-apply …). The built-in's own pure cores —
 * the instructions, the answers' shapes, the prompts, which findings hold (src/plugins/people/extract-core.ts, compile-core.ts, classify-core.ts, normalize-core.ts,
 * src/lib/rag-ask.ts) — are bundled into the lambdas as they are, so the built-in and the port ask the same.
 *
 *   npx tsx scripts/port-people.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "people-ext");
const SRC = path.join(ROOT, "scripts", "port-people");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

// The texts of the screens' data in the languages the packs have: every t("…") of the built-in's view-data.ts / row-data.ts and of the screen lambdas.
const KEYS: string[] = [];
for (const file of [path.join(ROOT, "src", "plugins", "people", "view-data.ts"), path.join(ROOT, "src", "plugins", "people", "row-data.ts"), path.join(SRC, "people.screen.mjs"), path.join(SRC, "people.person.mjs"), path.join(SRC, "people.progress.mjs"), path.join(SRC, "people.series.mjs"), path.join(ROOT, "src", "plugins", "people", "pulse-insights.ts"), path.join(ROOT, "src", "plugins", "people", "badges.ts"), path.join(ROOT, "src", "plugins", "loops", "shared.ts")])
  for (const m of fs.readFileSync(file, "utf8").matchAll(/\bt\(\s*"([^"]*)"/g)) {
    const k = m[1];
    if (!KEYS.includes(k)) KEYS.push(k);
  }
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const file = path.join(repo, "plugins", `lang-${lang}`, "bundle.json");
  const pack = fs.existsSync(file) ? (JSON.parse(fs.readFileSync(file, "utf8")) as Record<string, string>) : {};
  strings[lang] = Object.fromEntries(KEYS.filter((k) => pack[k]).map((k) => [k, pack[k]]));
}
const lib = await build({
  stdin: {
    contents: [
      `import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";`,
      `const STRINGS = ${JSON.stringify(strings)};`,
      `setPluginStrings((lang) => STRINGS[lang] ?? {});`,
      `export const tFor = (lang) => translator(isLang(lang) ? lang : "en");`,
      `export { peopleAppData, agoText } from "@/plugins/people/view-data";`,
      `export { personPageData } from "@/plugins/people/row-data";`,
      `export { CIRCLES, circleLabels } from "@/plugins/people/shared";`,
      `export { initials } from "@/plugins/workspace/widget-shared";`,
      `export { filled } from "@/lib/series/days";`,
      `export { kindLabel } from "@/plugins/loops/shared";`,
      `export { INSTRUCTIONS as EXTRACT_INSTRUCTIONS, SCHEMA as EXTRACT_SCHEMA, PER_BATCH, MAX_BATCHES, extractBatch, extractPrompt, acceptFindings, withLoopsAddendum } from "@/plugins/people/extract-core";`,
      `export { INSTRUCTIONS as COMPILE_INSTRUCTIONS, SCHEMA as COMPILE_SCHEMA } from "@/plugins/people/compile-core";`,
      `export { INSTRUCTIONS as CLASSIFY_INSTRUCTIONS, SCHEMA as CLASSIFY_SCHEMA, classifyPrompt } from "@/plugins/people/classify-core";`,
      `export { INSTRUCTIONS as NORMALIZE_INSTRUCTIONS, SCHEMA as NORMALIZE_SCHEMA, normalizePrompt } from "@/plugins/people/normalize-core";`,
      `export { RAG_INSTRUCTIONS, askWithRetrievalWith } from "@/lib/rag-ask";`,
    ].join("\n"),
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "people-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const libText = `// Generated by Zeff's scripts/port-people.mts from the built-in's pure cores (src/plugins/people/*-core.ts, src/lib/rag-ask.ts) — change them there, generate again.\n${lib.outputFiles[0].text}`;

