              { id: "write", kind: "if", when: "{{ steps.do.ok }}", then: [{ id: "sql", kind: "action", action: "sql.exec", input: { statements: "{{ steps.do.statements }}" } }, { id: "signal", kind: "if", when: "{{ steps.do.taste }}", then: [{ id: "queue", kind: "action", action: "pref.set", input: { plugin: "news-ext", key: "news:taste", value: "{{ steps.do.taste }}" } }], else: [] }], else: [] },
              { id: "done", kind: "return", value: { ok: "{{ steps.do.ok }}" } },
            ],
            requested: { write: "all", store: STORES },
            triggers: [{ kind: "manual" }],
          },
        },
        {
          id: "i2",
          parent: "i1",
          kind: "page",
          title: "Fetch the news",
          icon: "📰",
          content: { type: "doc", content: [{ type: "paragraph" }] },
          flow: {
            name: "news.fetch-round",
            title: "Fetch the news — one round",
            description: "The feeds due are fetched (the ones fetched longest ago first), what is new is kept, everything recent is scored for you. Input all: every due feed, onlyIds: just those.",
            inputs: [],
            nodes: [
              // New feeds found by itself first (once a day, and when fresh news run low), so they are fetched in this very sync.
              { id: "soft4", kind: "try", nodes: [
              { id: "find", kind: "action", action: "lambda.invoke", input: { name: "news.auto-discover", event: {} } },
              eachBatch("found", "find"),
              { id: "sets", kind: "foreach", items: "{{ steps.find.sets }}", as: "p", nodes: [{ id: "setp", kind: "action", action: "pref.set", input: { plugin: "news-ext", key: "{{ p.key }}", value: "{{ p.value }}" } }], max: 10 },
              ], catch: [] },
              { id: "round", kind: "action", action: "lambda.invoke", input: { name: "news.round", event: { all: "{{ input.all }}", onlyIds: "{{ input.onlyIds }}" } } },
              eachBatch("keep", "round"),
              { id: "scored", kind: "action", action: "lambda.invoke", input: { name: "news.rescore", event: {} } },
              eachBatch("scores", "scored"),
              // The agent reads the best new ones and lets through what interests you.
              { id: "soft3", kind: "try", nodes: [
              { id: "gate", kind: "action", action: "lambda.invoke", input: { name: "news.funnel", event: { rounds: 3 } } },
              { id: "gated", kind: "action", action: "sql.exec", input: { statements: "{{ steps.gate.statements }}" } },
              { id: "keepstats", kind: "if", when: "{{ steps.gate.stats }}", then: [{ id: "stats", kind: "action", action: "pref.set", input: { plugin: "news-ext", key: "news:funnel-stats", value: "{{ steps.gate.stats }}" } }], else: [] },
              ], catch: [] },
              // Old items out, then only the newest and the best stay.
              { id: "tidy", kind: "action", action: "lambda.invoke", input: { name: "news.act", event: { op: "clean" } } },
              { id: "tidied", kind: "action", action: "sql.exec", input: { statements: "{{ steps.tidy.statements }}" } },
              // Reading ahead: the whole text of the best unread items.
              { id: "soft2", kind: "try", nodes: [
              { id: "ahead", kind: "action", action: "lambda.invoke", input: { name: "news.read-ahead", event: { limit: 30 } } },
              { id: "aheadw", kind: "action", action: "sql.exec", input: { statements: "{{ steps.ahead.statements }}" } },
              ], catch: [] },
              // What each headline is about: the corpus tagger always, the AI for a batch of the best unseen ones.
              { id: "soft1", kind: "try", nodes: [
              { id: "tag", kind: "action", action: "lambda.invoke", input: { name: "news.tags", event: { batches: 2 } } },
              eachBatch("tags", "tag"),
              ], catch: [] },
              // The overview of the day (when it is on).
              { id: "soft0", kind: "try", nodes: [
              { id: "brief", kind: "action", action: "lambda.invoke", input: { name: "news.digest", event: { auto: true } } },
              { id: "briefed", kind: "if", when: "{{ steps.brief.digest }}", then: [{ id: "keepbrief", kind: "action", action: "pref.set", input: { plugin: "news-ext", key: "news:digest", value: "{{ steps.brief.digest }}" } }], else: [] },
              ], catch: [] },
              { id: "done", kind: "return", value: { ok: "{{ steps.round.ok }}", message: "{{ steps.round.message }}", added: "{{ steps.round.added }}" } },
            ],
            requested: { write: "all", ai: true, store: STORES, web: ["*"] },
            sync: { label: "News", what: "Your news fetched, scored for you and filtered — the feeds due, what is new, the agent, the clearing away, reading ahead, the tags, the overview", replaces: "news" },
            triggers: [{ kind: "manual" }, { kind: "schedule", everyMinutes: 60 }],
          },
        },
      ],
    },
    null,
    2,
  ) + "\n",
);

