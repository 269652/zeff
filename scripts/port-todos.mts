/**
 * The Todos screens' port (zeff-plugins/plugins/todos-ext): the Todos tab as a plugin, in the view language. The todo ENGINE stays the kernel's (the store, the gate,
 * the settle hooks, the actions): the screen reads the todos through the kernel's `todos.rows` (the built-in page's own todos, grouped and ordered the same) and
 * what a click does is a flow of the package over the kernel's writes (`todos.set-status`, `todos.flag`, `todos.defer`, `todos.set-due`, `todos.add` — the same
 * engine functions the built-in's server actions call, src/plugins/todos/engine.ts). The built-in stays on until the port is 1:1; both can be on at once.
 *
 * Slice 1: the list (your todos in groups by urgency, the ones you wait on, done, the workers'), the filter, a todo's row and what it does, adding a todo.
 *
 *   npx tsx scripts/port-todos.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";
import { todosViewTemplate } from "./port-todos/todos-view.mjs";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const dir = path.join(repo, "plugins", "todos-ext");
const SRC = path.join(ROOT, "scripts", "port-todos");
const write = (rel: string, text: string) => {
  const f = path.join(dir, rel);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.writeFileSync(f, text);
};
fs.rmSync(path.join(dir, "lambdas"), { recursive: true, force: true });

// The texts of the screen's data in the languages the packs have: every t("…") of the screen lambda.
const KEYS: string[] = [];
for (const file of ["todos.screen.mjs", "todos.panel.mjs", "rows.mjs", "todos.hits.mjs", "todos.feed.mjs", "todos.lage.mjs", "todos.day.mjs", "todos.heute.mjs"])
  for (const m of fs.readFileSync(path.join(SRC, file), "utf8").matchAll(/\bt\(\s*"((?:[^"\\]|\\.)*)"/g)) {
    const k = JSON.parse('"' + m[1] + '"');
    if (!KEYS.includes(k)) KEYS.push(k);
  }
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const file = path.join(repo, "plugins", `lang-${lang}`, "bundle.json");
  const pack = fs.existsSync(file) ? (JSON.parse(fs.readFileSync(file, "utf8")) as Record<string, string>) : {};
  strings[lang] = Object.fromEntries(KEYS.filter((k) => pack[k]).map((k) => [k, pack[k]]));
}
const lib = await build({
  stdin: {
    contents: `import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";
const STRINGS = ${JSON.stringify(strings)};
setPluginStrings((lang) => STRINGS[lang] ?? {});
export const tFor = (lang) => translator(isLang(lang) ? lang : "en");`,
    resolveDir: ROOT,
    loader: "ts",
    sourcefile: "todos-port.ts",
  },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const libText = `// Generated by Zeff's scripts/port-todos.mts — the language packs' words for the screen's data; change the generator, generate again.\n${lib.outputFiles[0].text}`;

const LAMBDAS: Record<string, { label: string; what: string; zeff: string[]; timeoutMs: number }> = {
  "todos.panel": { label: "Todos: what a todo's panel shows", what: "One todo whole: its notes, its actions in words, the time on it, its merge requests, its path and the comments, messages and mails it comes from.", zeff: ["todos.detail"], timeoutMs: 30000 },
  "todos.hits": { label: "Todos: the omnibar's hits", what: "What a typed text names — tickets, kinds, people, the todos' words and notes, mails, messages, comments, documents — each with the todos it belongs to.", zeff: ["todos.omni"], timeoutMs: 30000 },
  "todos.feed": { label: "Todos: the activity", what: "What happened to the todos in the last two weeks, by day: who made, closed, reopened or merged which, and what is new since you looked.", zeff: ["todos.activity"], timeoutMs: 30000 },
  "todos.lage": { label: "Todos: the briefing and the tickets", what: "The briefing's run and its tickets: the lede, per ticket what the run made of it, the changes it suggests, and the todos on it.", zeff: ["todos.board", "todos.rows"], timeoutMs: 30000 },
  "todos.day": { label: "Todos: the recap of a day", what: "What you did on a day: the AI's summary, per ticket what was done, and the evidence it was written from.", zeff: ["todos.recap"], timeoutMs: 30000 },
  "todos.heute": { label: "Todos: the todos' parts of Today", what: "Yours due today or before, what you wait on, what agents ask you, what workers report done.", zeff: ["todos.today"], timeoutMs: 30000 },
  "todos.screen": { label: "Todos: what the screen shows", what: "The todos of a scope (yours in groups by urgency and the ones you wait on, done, the workers') ready to draw: words, ticket, kind, due day, repeat, flags, what a worker or agent says.", zeff: ["todos.rows"], timeoutMs: 30000 },
};
for (const [name, l] of Object.entries(LAMBDAS)) {
  write(`lambdas/${name}/lib.mjs`, libText);
  write(`lambdas/${name}/index.mjs`, fs.readFileSync(path.join(SRC, `${name}.mjs`), "utf8"));
  write(`lambdas/${name}/rows.mjs`, fs.readFileSync(path.join(SRC, "rows.mjs"), "utf8"));
  write(`lambdas/${name}/lambda.json`, JSON.stringify({ name, label: l.label, what: l.what, kind: "function", zeff: l.zeff, timeoutMs: l.timeoutMs, memoryMb: 128 }, null, 2) + "\n");
}

/** A flow of the package: one kernel action done by a click, its answer handed back. */
const flow = (id: string, name: string, title: string, description: string, action: string, input: Record<string, string>, out: Record<string, string>, requested: Record<string, boolean> = { todos: true }) => ({
  id,
  parent: "i1",
  kind: "page",
  title,
  icon: "✅",
  content: { type: "doc", content: [{ type: "paragraph" }] },
  flow: {
    name,
    title,
    description,
    inputs: [],
    nodes: [
      { id: "do", kind: "action", action, input },
      { id: "done", kind: "return", value: out },
    ],
    requested,
    triggers: [{ kind: "manual" }],
  },
});

const template = todosViewTemplate();
write(
  "todos.package.json",
  JSON.stringify(
    {
      format: 1,
      id: "todos-ext",
      version: "1.0.0",
      name: "Todos",
      description: "Your todos on a screen made of Zeff's own kit: grouped by urgency, with the ones you wait on, done and the workers' — tick, flag, set aside, dismiss, a due day, add.",
      icon: "✅",
      items: [
        { id: "i1", kind: "page", title: "Todos", icon: "✅", content: { type: "doc", content: [{ type: "paragraph" }] } },
        {
          id: "i2",
          parent: "i1",
          kind: "database",
          title: "Your todos",
          icon: "✅",
          schema: {
            titleName: "Todos",
            properties: [],
            views: [{ id: "vtodos1", name: "Todos", type: "app", filter: { op: "and", rules: [] }, sorts: [], hidden: [], app: "template", template }],
          },
          rows: [{ id: "r1", title: "Todos", cells: {}, content: { type: "doc", content: [{ type: "paragraph" }] } }],
        },
        flow("i3", "todos-ext.status", "Tick a todo off, dismiss it, open it again", "A todo's status (input id, status: open | done | dismissed, early). Output { ok, id, confirm, error } — confirm: a repeat ticked off a week or more before its day asks first.", "todos.set-status", { id: "{{ input.id }}", status: "{{ input.status }}", early: "{{ input.early }}" }, { ok: "{{ steps.do.ok }}", id: "{{ input.id }}", confirm: "{{ steps.do.confirm }}", error: "{{ steps.do.error }}" }),
        flow("i4", "todos-ext.flag", "Flag a todo as important", "A todo flagged important or not (input id, flagged).", "todos.flag", { id: "{{ input.id }}", flagged: "{{ input.flagged }}" }, {}),
        flow("i5", "todos-ext.defer", "Set a todo aside — or back up", "A todo put to the bottom for now or taken back up (input id, deferred).", "todos.defer", { id: "{{ input.id }}", deferred: "{{ input.deferred }}" }, {}),
        flow("i6", "todos-ext.due", "A todo's due day", "A todo's due day (input id, due: YYYY-MM-DD, empty for none).", "todos.set-due", { id: "{{ input.id }}", due: "{{ input.due }}" }, {}),
        flow("i7", "todos-ext.add", "Add a todo", "A todo of yours through the gate every todo goes through (input text, ticket, due). Output { id, ref, merged } — merged: it said the same as an open one.", "todos.add", { text: "{{ input.text }}", ticket: "{{ input.ticket }}", due: "{{ input.due }}" }, { id: "{{ steps.do.id }}", ref: "{{ steps.do.ref }}", merged: "{{ steps.do.merged }}" }),
        flow("i8", "todos-ext.text", "A todo's words", "A todo's text changed (input id, text).", "todos.set-text", { id: "{{ input.id }}", text: "{{ input.text }}" }, {}),
        flow("i9", "todos-ext.note", "A note on a todo", "Your note on a todo (input id, text). Output { ok, message, error }.", "todos.add-note", { id: "{{ input.id }}", text: "{{ input.text }}" }, { ok: "{{ steps.do.ok }}", message: "{{ steps.do.message }}", error: "{{ steps.do.error }}" }),
        flow("i10", "todos-ext.note-remove", "Take a note off a todo", "Your note on a todo taken away (input id, at: the note's time).", "todos.remove-note", { id: "{{ input.id }}", at: "{{ input.at }}" }, {}),
        flow("i11", "todos-ext.time", "Time spent on a todo", "Time you spent, by hand (input id, minutes, note).", "todos.add-time", { id: "{{ input.id }}", minutes: "{{ input.minutes }}", note: "{{ input.note }}" }, { id: "{{ steps.do.id }}" }),
        flow("i12", "todos-ext.op-remove", "Take an action off a todo", "One of a todo's actions taken off it (input id, index).", "todos.remove-op", { id: "{{ input.id }}", index: "{{ input.index }}" }, { ok: "{{ steps.do.ok }}", message: "{{ steps.do.message }}" }),
        flow("i14", "todos-ext.seen", "The activity you have looked at", "The newest event of the todos' activity you have seen (input id).", "todos.activity-seen", { id: "{{ input.id }}" }, {}),
        flow("i15", "todos-ext.undo-run", "Take back a briefing run's todos", "The todos a run made that you haven't touched are dismissed (input run). Output { dismissed, kept, claims }.", "todos.undo-run", { run: "{{ input.run }}" }, { dismissed: "{{ steps.do.dismissed }}", kept: "{{ steps.do.kept }}", claims: "{{ steps.do.claims }}" }),
        flow("i16", "todos-ext.board-run", "Run the briefing now — or stop it", "The Ticket-Lage's run started (Jira synced first) or, with stop, stopped. Output { ok, message }.", "todos.board-run", { stop: "{{ input.stop }}" }, { ok: "{{ steps.do.ok }}", message: "{{ steps.do.message }}" }, { todos: true, api: true }),
        flow("i17", "todos-ext.ticket-action", "A change the briefing suggests on a ticket", "One suggested change (transition, assignee, comment) done in Jira (input run, ticket, idx). Output { ok, message, error }.", "todos.ticket-action", { run: "{{ input.run }}", ticket: "{{ input.ticket }}", idx: "{{ input.idx }}" }, { ok: "{{ steps.do.ok }}", message: "{{ steps.do.message }}", error: "{{ steps.do.error }}" }, { todos: true, api: true }),
        flow("i18", "todos-ext.follow", "Follow a ticket", "A ticket followed (1), no longer followed (-1) or as it comes (0) (input key, value).", "todos.follow", { key: "{{ input.key }}", value: "{{ input.value }}" }, {}),
        flow("i19", "todos-ext.recap-start", "Write the recap of a day", "The day gathered and summarized by the AI, in the background (input day). Output { ok, message }.", "todos.recap-start", { day: "{{ input.day }}" }, { ok: "{{ steps.do.ok }}", message: "{{ steps.do.message }}" }, { todos: true, api: true }),
        flow("i13", "todos-ext.run", "Run a todo's actions now", "A todo's actions run by you, right now (input id, only: the place of one action — empty: all). Output { message }.", "todos.run-ops", { id: "{{ input.id }}", only: "{{ input.only }}" }, { message: "{{ steps.do.message }}" }, { todos: true, api: true }),
      ],
    },
    null,
    2,
  ) + "\n",
);

write("views/todos.html", template);
const old = fs.existsSync(path.join(dir, "zeff-plugin.json")) ? (JSON.parse(fs.readFileSync(path.join(dir, "zeff-plugin.json"), "utf8")) as { version?: string }) : {};
write(
  "zeff-plugin.json",
  JSON.stringify(
    {
      $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
      id: "todos-ext",
      name: "Todos (screens)",
      version: old.version ?? "0.1.0",
      description: "The Todos screen in the Workspace, made of Zeff's own kit: your todos grouped by urgency, the ones you wait on, done, the workers'; tick, flag, set aside, dismiss, a due day, add. The todos themselves (the engine) stay Zeff's.",
      author: "Zeff",
      apiVersion: 1,
      permissions: [],
      contributes: {
        lambdas: "lambdas",
        workspacePackages: ["todos.package.json"],
      },
    },
    null,
    2,
  ) + "\n",
);
write(
  "README.md",
  `# Todos screens (todos-ext) — slice 1

The Todos tab of Zeff as a plugin, in the view language. Generated by Zeff's \`scripts/port-todos.mts\`.

- The screen is the view language: the database *Your todos* (under the page *Todos*) has one view, \`views/todos.html\`; the lambda \`todos.screen\` gives it its data through the kernel's read \`todos.rows\`.
- What a click does is a flow of the package over the kernel's writes (\`todos.set-status\`, \`todos.flag\`, \`todos.defer\`, \`todos.set-due\`, \`todos.add\`): the same engine functions the built-in page calls. They need the flow's permission "todos".
- The todo engine (the todos, their operations, the settle hooks) stays Zeff's. The built-in Todos stays on until this is 1:1; both work on the same todos.
- **Not yet here:** the todo's panel (note, time, instruction, reply draft), sources and context, the actions, the omnibar filter, Activity, the recap, the Heute parts.
`,
);
console.log(`${dir}: Todos slice 1`);
